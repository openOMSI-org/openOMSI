{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"openOMSI знаходзіць мультыплеерныя сесіі іншых гульцоў у вашай сетцы і далучаецца да іх."}},"ca":{"stringUnit":{"state":"translated","value":"openOMSI troba les sessions multijugador d'altres jugadors a la teva xarxa i s'hi uneix."}},"cs":{"stringUnit":{"state":"translated","value":"openOMSI vyhledává relace ostatních hráčů ve vaší síti a připojuje se k nim."}},"de":{"stringUnit":{"state":"translated","value":"openOMSI findet die Multiplayer-Sitzungen anderer Spieler in deinem Netzwerk und tritt ihnen bei."}},"es":{"stringUnit":{"state":"translated","value":"openOMSI busca y se une a las sesiones multijugador de otros jugadores en tu red."}},"fr":{"stringUnit":{"state":"translated","value":"openOMSI trouve et rejoint les parties multijoueur des autres joueurs sur votre réseau."}},"hi":{"stringUnit":{"state":"translated","value":"openOMSI आपके नेटवर्क पर दूसरे खिलाड़ियों के मल्टीप्लेयर सेशन ढूँढता है और उनसे जुड़ता है।"}},"hu":{"stringUnit":{"state":"translated","value":"Az openOMSI megkeresi a hálózatodon lévő más játékosok többjátékos munkameneteit, és csatlakozik hozzájuk."}},"id":{"stringUnit":{"state":"translated","value":"openOMSI menemukan dan bergabung ke sesi multipemain pemain lain di jaringan Anda."}},"it":{"stringUnit":{"state":"translated","value":"openOMSI trova le sessioni multigiocatore di altri giocatori sulla tua rete e vi si unisce."}},"ja":{"stringUnit":{"state":"translated","value":"openOMSI はネットワーク上の他のプレイヤーのマルチプレイセッションを見つけて参加します。"}},"ka":{"stringUnit":{"state":"translated","value":"openOMSI პოულობს თქვენს ქსელში სხვა მოთამაშეების მრავალმოთამაშიან სესიებს და უერთდება მათ."}},"kk":{"stringUnit":{"state":"translated","value":"openOMSI желіңіздегі басқа ойыншылардың мультиплеер сессияларын тауып, оларға қосылады."}},"ko":{"stringUnit":{"state":"translated","value":"openOMSI는 네트워크에 있는 다른 플레이어의 멀티플레이 세션을 찾아 참가합니다."}},"ms":{"stringUnit":{"state":"translated","value":"openOMSI mencari dan menyertai sesi berbilang pemain pemain lain dalam rangkaian anda."}},"nl":{"stringUnit":{"state":"translated","value":"openOMSI vindt de multiplayersessies van andere spelers in je netwerk en neemt eraan deel."}},"pl":{"stringUnit":{"state":"translated","value":"openOMSI wyszukuje sesje wieloosobowe innych graczy w Twojej sieci i do nich dołącza."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O openOMSI encontra e entra nas sessões multijogador de outros jogadores na sua rede."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O openOMSI encontra e junta-se às sessões multijogador de outros jogadores na sua rede."}},"ru":{"stringUnit":{"state":"translated","value":"openOMSI находит сетевые игры других игроков в вашей сети и подключается к ним."}},"sr":{"stringUnit":{"state":"translated","value":"openOMSI pronalazi sesije za više igrača drugih igrača na vašoj mreži i pridružuje im se."}},"sv":{"stringUnit":{"state":"translated","value":"openOMSI hittar och ansluter till andra spelares flerspelarsessioner i ditt nätverk."}},"th":{"stringUnit":{"state":"translated","value":"openOMSI ค้นหาและเข้าร่วมเซสชันผู้เล่นหลายคนของผู้เล่นอื่นในเครือข่ายของคุณ"}},"fil":{"stringUnit":{"state":"translated","value":"Hinahanap at sinasalihan ng openOMSI ang mga multiplayer session ng ibang manlalaro sa network mo."}},"tr":{"stringUnit":{"state":"translated","value":"openOMSI, ağınızdaki diğer oyuncuların çok oyunculu oturumlarını bulur ve onlara katılır."}},"uk":{"stringUnit":{"state":"translated","value":"openOMSI знаходить мережеві сесії інших гравців у вашій мережі та приєднується до них."}},"vi":{"stringUnit":{"state":"translated","value":"openOMSI tìm và tham gia các phiên nhiều người chơi của người chơi khác trong mạng của bạn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"openOMSI 会查找并加入你所在网络中其他玩家的多人游戏会话。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"openOMSI 會尋找並加入你所在網路中其他玩家的多人遊戲工作階段。"}}}},
    "NSMicrophoneUsageDescription": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"openOMSI выкарыстоўвае мікрафон для галасавога чату ў мультыплееры, толькі пакуль вы ўтрымліваеце клавішу размовы (або з адкрытым мікрафонам) і толькі калі вы ўключылі галасавы чат. Нічога не запісваецца."}},"ca":{"stringUnit":{"state":"translated","value":"openOMSI fa servir el micròfon per al xat de veu en multijugador, només mentre mantens premuda una tecla per parlar (o amb el micròfon obert) i només si actives el xat de veu. No s'enregistra res."}},"cs":{"stringUnit":{"state":"translated","value":"openOMSI používá mikrofon pro hlasový chat ve hře více hráčů, jen když držíte klávesu pro mluvení (nebo s otevřeným mikrofonem) a jen pokud hlasový chat zapnete. Nic se nenahrává."}},"de":{"stringUnit":{"state":"translated","value":"openOMSI nutzt das Mikrofon für den Sprachchat im Multiplayer, nur solange du eine Sprechtaste hältst (oder mit offenem Mikrofon) und nur, wenn du den Sprachchat einschaltest. Es wird nichts aufgezeichnet."}},"es":{"stringUnit":{"state":"translated","value":"openOMSI usa el micrófono para el chat de voz en multijugador, solo mientras mantienes una tecla para hablar (o con el micrófono abierto) y solo si activas el chat de voz. No se graba nada."}},"fr":{"stringUnit":{"state":"translated","value":"openOMSI utilise le microphone pour le chat vocal en multijoueur, uniquement pendant que vous maintenez une touche de parole (ou avec le micro ouvert) et seulement si vous activez le chat vocal. Rien n'est enregistré."}},"hi":{"stringUnit":{"state":"translated","value":"openOMSI मल्टीप्लेयर में वॉइस चैट के लिए माइक्रोफ़ोन का इस्तेमाल करता है, सिर्फ़ तब जब आप बोलने की की दबाए रखें (या खुले माइक्रोफ़ोन के साथ) और सिर्फ़ अगर आप वॉइस चैट चालू करें। कुछ भी रिकॉर्ड नहीं होता।"}},"hu":{"stringUnit":{"state":"translated","value":"Az openOMSI a mikrofont a többjátékos hangcsevegéshez használja, csak amíg nyomva tartod a beszéd gombot (vagy nyitott mikrofonnál), és csak ha bekapcsolod a hangcsevegést. Semmi sem kerül rögzítésre."}},"id":{"stringUnit":{"state":"translated","value":"openOMSI memakai mikrofon untuk obrolan suara di multipemain, hanya saat Anda menahan tombol bicara (atau dengan mikrofon terbuka) dan hanya jika Anda mengaktifkan obrolan suara. Tidak ada yang direkam."}},"it":{"stringUnit":{"state":"translated","value":"openOMSI usa il microfono per la chat vocale in multigiocatore, solo mentre tieni premuto un tasto per parlare (o con il microfono aperto) e solo se attivi la chat vocale. Non viene registrato nulla."}},"ja":{"stringUnit":{"state":"translated","value":"openOMSI はマルチプレイのボイスチャットにマイクを使います。トークキーを押している間 (またはマイク常時オン時) だけ、ボイスチャットをオンにした場合のみです。何も録音されません。"}},"ka":{"stringUnit":{"state":"translated","value":"openOMSI იყენებს მიკროფონს ხმოვანი ჩატისთვის მრავალმოთამაშიან რეჟიმში, მხოლოდ მაშინ, როცა საუბრის კლავიშს აჭერთ (ან ღია მიკროფონით) და მხოლოდ თუ ხმოვან ჩატს ჩართავთ. არაფერი იწერება."}},"kk":{"stringUnit":{"state":"translated","value":"openOMSI микрофонды мультиплеердегі дауыстық чат үшін тек сөйлеу пернесін басып тұрғанда (немесе ашық микрофонмен) және дауыстық чатты өзіңіз қосқанда ғана пайдаланады. Ештеңе жазылмайды."}},"ko":{"stringUnit":{"state":"translated","value":"openOMSI는 멀티플레이 음성 채팅에 마이크를 사용합니다. 말하기 키를 누르고 있는 동안(또는 마이크 상시 켜기일 때)만, 음성 채팅을 켠 경우에만 사용합니다. 아무것도 녹음하지 않습니다."}},"ms":{"stringUnit":{"state":"translated","value":"openOMSI menggunakan mikrofon untuk sembang suara dalam berbilang pemain, hanya semasa anda menahan kekunci cakap (atau dengan mikrofon terbuka) dan hanya jika anda menghidupkan sembang suara. Tiada apa yang dirakam."}},"nl":{"stringUnit":{"state":"translated","value":"openOMSI gebruikt de microfoon voor spraakchat in multiplayer, alleen terwijl je een spreektoets ingedrukt houdt (of met de open microfoon) en alleen als je spraakchat aanzet. Er wordt niets opgenomen."}},"pl":{"stringUnit":{"state":"translated","value":"openOMSI używa mikrofonu do czatu głosowego w trybie wieloosobowym, tylko gdy przytrzymujesz klawisz mówienia (lub przy otwartym mikrofonie) i tylko jeśli włączysz czat głosowy. Nic nie jest nagrywane."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O openOMSI usa o microfone para o chat de voz no multijogador, só enquanto você segura uma tecla de fala (ou com o microfone aberto) e só se você ativar o chat de voz. Nada é gravado."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O openOMSI usa o microfone para o chat de voz no multijogador, apenas enquanto mantém premida uma tecla de fala (ou com o microfone aberto) e apenas se ativar o chat de voz. Nada é gravado."}},"ru":{"stringUnit":{"state":"translated","value":"openOMSI использует микрофон для голосового чата в мультиплеере, только пока вы удерживаете клавишу разговора (или с открытым микрофоном) и только если вы включили голосовой чат. Ничего не записывается."}},"sr":{"stringUnit":{"state":"translated","value":"openOMSI koristi mikrofon za glasovni čet u igri za više igrača, samo dok držite taster za govor (ili sa otvorenim mikrofonom) i samo ako uključite glasovni čet. Ništa se ne snima."}},"sv":{"stringUnit":{"state":"translated","value":"openOMSI använder mikrofonen för röstchatt i flerspelarläge, bara medan du håller ned en taltangent (eller med öppen mikrofon) och bara om du slår på röstchatten. Inget spelas in."}},"th":{"stringUnit":{"state":"translated","value":"openOMSI ใช้ไมโครโฟนสำหรับแชทเสียงในโหมดผู้เล่นหลายคน เฉพาะขณะที่คุณกดปุ่มพูดค้างไว้ (หรือเมื่อเปิดไมค์ค้างไว้) และเฉพาะเมื่อคุณเปิดแชทเสียง ไม่มีการบันทึกใดๆ"}},"fil":{"stringUnit":{"state":"translated","value":"Ginagamit ng openOMSI ang mikropono para sa voice chat sa multiplayer, habang pinipindot mo lang ang talk key (o kapag bukas ang mikropono) at kung binuksan mo lang ang voice chat. Walang nire-record."}},"tr":{"stringUnit":{"state":"translated","value":"openOMSI mikrofonu çok oyunculu sesli sohbet için kullanır; yalnızca bir konuşma tuşunu basılı tuttuğunuzda (veya açık mikrofonla) ve yalnızca sesli sohbeti açtıysanız. Hiçbir şey kaydedilmez."}},"uk":{"stringUnit":{"state":"translated","value":"openOMSI використовує мікрофон для голосового чату в мультиплеєрі, лише поки ви утримуєте клавішу розмови (або з відкритим мікрофоном) і лише якщо ви ввімкнули голосовий чат. Нічого не записується."}},"vi":{"stringUnit":{"state":"translated","value":"openOMSI dùng micrô cho trò chuyện thoại khi chơi nhiều người, chỉ khi bạn giữ phím nói (hoặc khi bật micrô mở) và chỉ khi bạn bật trò chuyện thoại. Không có gì được ghi lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"openOMSI 在多人游戏语音聊天中使用麦克风，仅在你按住通话键时（或开启常开麦克风时），且仅在你打开语音聊天后。不会录制任何内容。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"openOMSI 在多人遊戲語音聊天中使用麥克風，僅在你按住通話鍵時（或開啟常開麥克風時），且僅在你開啟語音聊天後。不會錄製任何內容。"}}}},
    "NSMotionUsageDescription": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Рулённе нахілам паварочвае руль аўтобуса нахілам прылады."}},"ca":{"stringUnit":{"state":"translated","value":"La direcció per inclinació gira el volant de l'autobús amb el dispositiu."}},"cs":{"stringUnit":{"state":"translated","value":"Řízení náklonem otáčí volantem autobusu pomocí zařízení."}},"de":{"stringUnit":{"state":"translated","value":"Die Neigungslenkung dreht das Lenkrad des Busses mit dem Gerät."}},"es":{"stringUnit":{"state":"translated","value":"La dirección por inclinación gira el volante del autobús con el dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"La direction par inclinaison tourne le volant du bus avec l'appareil."}},"hi":{"stringUnit":{"state":"translated","value":"झुकाकर स्टीयरिंग डिवाइस से बस का स्टीयरिंग व्हील घुमाती है।"}},"hu":{"stringUnit":{"state":"translated","value":"A döntéses kormányzás az eszközzel forgatja a busz kormányát."}},"id":{"stringUnit":{"state":"translated","value":"Kemudi miring memutar setir bus dengan perangkat."}},"it":{"stringUnit":{"state":"translated","value":"Lo sterzo a inclinazione gira il volante del bus con il dispositivo."}},"ja":{"stringUnit":{"state":"translated","value":"傾きステアリングでは、デバイスを傾けてバスのハンドルを回します。"}},"ka":{"stringUnit":{"state":"translated","value":"დახრით მართვა ავტობუსის საჭეს მოწყობილობით ატრიალებს."}},"kk":{"stringUnit":{"state":"translated","value":"Еңкейтіп басқару автобус рөлін құрылғымен бұрады."}},"ko":{"stringUnit":{"state":"translated","value":"기울기 조향은 기기를 기울여 버스 핸들을 돌립니다."}},"ms":{"stringUnit":{"state":"translated","value":"Stereng condong memusingkan stereng bas dengan peranti."}},"nl":{"stringUnit":{"state":"translated","value":"Sturen door kantelen draait het stuur van de bus met het apparaat."}},"pl":{"stringUnit":{"state":"translated","value":"Sterowanie przechylaniem obraca kierownicę autobusu ruchem urządzenia."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A direção por inclinação gira o volante do ônibus com o aparelho."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A direção por inclinação roda o volante do autocarro com o dispositivo."}},"ru":{"stringUnit":{"state":"translated","value":"Руление наклоном поворачивает руль автобуса движением устройства."}},"sr":{"stringUnit":{"state":"translated","value":"Upravljanje naginjanjem okreće volan autobusa pomoću uređaja."}},"sv":{"stringUnit":{"state":"translated","value":"Lutningsstyrning vrider bussens ratt med enheten."}},"th":{"stringUnit":{"state":"translated","value":"การบังคับเลี้ยวด้วยการเอียงจะหมุนพวงมาลัยของรถบัสตามการเอียงอุปกรณ์"}},"fil":{"stringUnit":{"state":"translated","value":"Pinapaikot ng tilt steering ang manibela ng bus gamit ang device."}},"tr":{"stringUnit":{"state":"translated","value":"Eğerek direksiyon, otobüsün direksiyonunu cihazla çevirir."}},"uk":{"stringUnit":{"state":"translated","value":"Кермування нахилом повертає кермо автобуса рухом пристрою."}},"vi":{"stringUnit":{"state":"translated","value":"Lái bằng cách nghiêng xoay vô lăng của xe buýt theo thiết bị."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"倾斜转向通过倾斜设备来转动巴士方向盘。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"傾斜轉向透過傾斜裝置來轉動巴士方向盤。"}}}}
  },
  "version": "1.0"
}
