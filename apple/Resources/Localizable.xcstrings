    "Navigator as a widget (drag it anywhere, size it at its corner)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Навігатар як віджэт (перацягвайце куды заўгодна, змяняйце памер за кут)"}},"ca":{"stringUnit":{"state":"translated","value":"Navegador com a giny (arrossega'l on vulguis, canvia'n la mida per la cantonada)"}},"cs":{"stringUnit":{"state":"translated","value":"Navigátor jako widget (přetáhněte kamkoli, velikost za roh)"}},"de":{"stringUnit":{"state":"translated","value":"Navigator als Widget (überallhin ziehen, an der Ecke die Größe ändern)"}},"es":{"stringUnit":{"state":"translated","value":"Navegador como widget (arrástralo a cualquier lugar, cambia su tamaño desde la esquina)"}},"fr":{"stringUnit":{"state":"translated","value":"Navigateur en widget (à glisser n'importe où, à redimensionner par son coin)"}},"hi":{"stringUnit":{"state":"translated","value":"विजेट के रूप में नेविगेटर (कहीं भी खींचें, कोने से आकार बदलें)"}},"hu":{"stringUnit":{"state":"translated","value":"Navigátor widgetként (húzd bárhová, a sarkánál méretezd)"}},"id":{"stringUnit":{"state":"translated","value":"Navigator sebagai widget (seret ke mana saja, ubah ukuran di sudutnya)"}},"it":{"stringUnit":{"state":"translated","value":"Navigatore come widget (trascinalo ovunque, ridimensionalo dall'angolo)"}},"ja":{"stringUnit":{"state":"translated","value":"ウィジェットとしてのナビ(好きな場所へドラッグ、角でサイズ変更)"}},"ka":{"stringUnit":{"state":"translated","value":"ნავიგატორი ვიჯეტად (გადაიტანეთ ნებისმიერ ადგილას, ზომა შეცვალეთ კუთხიდან)"}},"kk":{"stringUnit":{"state":"translated","value":"Навигатор виджет ретінде (кез келген жерге сүйреңіз, бұрышынан өлшемін өзгертіңіз)"}},"ko":{"stringUnit":{"state":"translated","value":"위젯으로 내비게이터 (원하는 곳으로 끌고, 모서리로 크기 조절)"}},"ms":{"stringUnit":{"state":"translated","value":"Navigator sebagai widget (seret ke mana-mana, ubah saiz di sudutnya)"}},"nl":{"stringUnit":{"state":"translated","value":"Navigator als widget (overal heen slepen, grootte bij de ho