    "Changes every 25-60 minutes, as the month allows": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Змяняецца кожныя 25-60 хвілін, наколькі дазваляе месяц"}},"ca":{"stringUnit":{"state":"translated","value":"Canvia cada 25-60 minuts, segons el mes"}},"cs":{"stringUnit":{"state":"translated","value":"Mění se každých 25-60 minut, jak měsíc dovolí"}},"de":{"stringUnit":{"state":"translated","value":"Ändert sich alle 25-60 Minuten, je nachdem wie der Monat es zulässt"}},"es":{"stringUnit":{"state":"translated","value":"Cambia cada 25-60 minutos, según el mes"}},"fr":{"stringUnit":{"state":"translated","value":"Change toutes les 25 à 60 minutes, selon le mois"}},"hi":{"stringUnit":{"state":"translated","value":"हर 25-60 मिनट में बदलता है, जैसा महीना अनुमति दे"}},"hu":{"stringUnit":{"state":"translated","value":"25-60 percenként változik, ahogy a hónap engedi"}},"id":{"stringUnit":{"state":"translated","value":"Berubah setiap 25-60 menit, sesuai bulan"}},"it":{"stringUnit":{"state":"translated","value":"Cambia ogni 25-60 minuti, come il mese consente"}},"ja":{"stringUnit":{"state":"translated","value":"月に応じて25-60分ごとに変化します"}},"ka":{"stringUnit":{"state":"translated","value":"იცვლება ყოველ 25-60 წუთში, თვის შესაბამისად"}},"kk":{"stringUnit":{"state":"translated","value":"Ай мүмкіндік бергенше әр 25-60 минут сайын өзгереді"}},"ko":{"stringUnit":{"state":"translated","value":"월에 따라 25-60분마다 바뀝니다"}},"ms":{"stringUnit":{"state":"translated","value":"Berubah setiap 25-60 minit, mengikut bulan"}},"nl":{"stringUnit":{"state":"translated","value":"Verandert elke 25 tot 60 minuten, afhankelijk van de maand"}},"pl":{"stringUnit":{"state":"translated","value":"Zmienia się co 25-60 minut, na ile pozwala miesiąc"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Muda a cada 25-60 minutos, conforme o mês permite"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Muda a cada 25-60 minutos, conforme o mês permite"}},"ru":{"stringUnit":{"state":"translated"