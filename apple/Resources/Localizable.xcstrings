    "Start on today's date": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Пачынаць з сённяшняй даты"}},"ca":{"stringUnit":{"state":"translated","value":"Comença amb la data d'avui"}},"cs":{"stringUnit":{"state":"translated","value":"Začít dnešním datem"}},"de":{"stringUnit":{"state":"translated","value":"Mit dem heutigen Datum starten"}},"es":{"stringUnit":{"state":"translated","value":"Empezar en la fecha de hoy"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer à la date du jour"}},"hi":{"stringUnit":{"state":"translated","value":"आज की तारीख़ पर शुरू करें"}},"hu":{"stringUnit":{"state":"translated","value":"Indítás az aktuális dátummal (Nap, Hónap, Év)"}},"id":{"stringUnit":{"state":"translated","value":"Mulai pada tanggal hari ini"}},"it":{"stringUnit":{"state":"translated","value":"Parti dalla data di oggi"}},"ja":{"stringUnit":{"state":"translated","value":"今日の日付で開始"}},"ka":{"stringUnit":{"state":"translated","value":"დაწყება დღევანდელი თარიღით"}},"kk":{"stringUnit":{"state":"translated","value":"Бүгінгі күннен бастау"}},"ko":{"stringUnit":{"state":"translated","value":"오늘 날짜로 시작"}},"ms":{"stringUnit":{"state":"translated","value":"Mula pada tarikh hari ini"}},"nl":{"stringUnit":{"state":"translated","value":"Starten op de datum van vandaag"}},"pl":{"stringUnit":{"state":"translated","value":"Start w dzisiejszej dacie"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Começar na data de hoje"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Começar na data de hoje"}},"ru":{"stringUnit":{"state":"translated","value":"Начинать с сегодняшней даты"}},"sr":{"stringUnit":{"state":"translated","value":"Počnite na današnji datum"}},"sv":{"stringUnit":{"state":"translated","value":"Starta på dagens datum"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มตามวันที่วันนี้"}},"fil":{"stringUnit":{"state":"translated","value":"Simulan sa petsa ngayon"}},"tr":{"stringUnit":{"state":"translated","value":"Bugünün tarihinde b