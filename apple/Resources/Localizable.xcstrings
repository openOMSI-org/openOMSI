    "Start with a full tank": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Пачынаць з поўным бакам"}},"ca":{"stringUnit":{"state":"translated","value":"Comença amb el dipòsit ple"}},"cs":{"stringUnit":{"state":"translated","value":"Začínat s plnou nádrží"}},"de":{"stringUnit":{"state":"translated","value":"Mit vollem Tank starten"}},"es":{"stringUnit":{"state":"translated","value":"Empezar con el depósito lleno"}},"fr":{"stringUnit":{"state":"translated","value":"Commencer avec le plein"}},"hi":{"stringUnit":{"state":"translated","value":"भरी टंकी के साथ शुरू करें"}},"hu":{"stringUnit":{"state":"translated","value":"Indulás tele tankkal"}},"id":{"stringUnit":{"state":"translated","value":"Mulai dengan tangki penuh"}},"it":{"stringUnit":{"state":"translated","value":"Inizia con il serbatoio pieno"}},"ja":{"stringUnit":{"state":"translated","value":"満タンで始める"}},"ka":{"stringUnit":{"state":"translated","value":"დაწყება სავსე ავზით"}},"kk":{"stringUnit":{"state":"translated","value":"Толық бакпен бастау"}},"ko":{"stringUnit":{"state":"translated","value":"가득 찬 연료로 시작"}},"ms":{"stringUnit":{"state":"translated","value":"Mula dengan tangki penuh"}},"nl":{"stringUnit":{"state":"translated","value":"Beginnen met een volle tank"}},"pl":{"stringUnit":{"state":"translated","value":"Zaczynaj z pełnym bakiem"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Começar com o tanque cheio"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Começar com o depósito cheio"}},"ru":{"stringUnit":{"state":"translated","value":"Начинать с полным баком"}},"sr":{"stringUnit":{"state":"translated","value":"Počni sa punim rezervoarom"}},"sv":{"stringUnit":{"state":"translated","value":"Börja med full tank"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มด้วยถังน้ำมันเต็ม"}},"fil":{"stringUnit":{"state":"translated","value":"Magsimula nang puno ang tangke"}},"tr":{"stringUnit":{"state":"translated","value":"Dolu depoyla başla"}},"uk":{"stringUnit":{"state":"translated","value":"Починати з повним баком"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu với bình đầy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"以满油开始"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"以滿油開始"}}}},
    "Start your hosted duty first. A session code appears only after the game starts.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Спачатку пачніце свой наряд як хост. Код сесіі з'явіцца толькі пасля запуску гульні."}},"ca":{"stringUnit":{"state":"translated","value":"Inicia primer el teu servei com a amfitrió. El codi de sessió només apareix quan el joc ha començat."}},"cs":{"stringUnit":{"state":"translated","value":"Nejprve spusťte svou službu jako hostitel. Kód relace se objeví až po spuštění hry."}},"de":{"stringUnit":{"state":"translated","value":"Starte zuerst deinen gehosteten Dienst. Ein Sitzungscode erscheint erst, wenn das Spiel läuft."}},"es":{"stringUnit":{"state":"translated","value":"Inicia primero tu servicio como anfitrión. El código de sesión solo aparece cuando el juego ha empezado."}},"fr":{"stringUnit":{"state":"translated","value":"Lancez d'abord votre service hébergé. Le code de session n'apparaît qu'une fois le jeu démarré."}},"hi":{"stringUnit":{"state":"translated","value":"पहले होस्ट के रूप में अपनी ड्यूटी शुरू करें। सेशन कोड गेम शुरू होने के बाद ही दिखता है।"}},"hu":{"stringUnit":{"state":"translated","value":"Először indítsd el a szolgálatodat házigazdaként. A munkamenet-kód csak a játék indulása után jelenik meg."}},"id":{"stringUnit":{"state":"translated","value":"Mulai dulu tugas Anda sebagai host. Kode sesi baru muncul setelah game dimulai."}},"it":{"stringUnit":{"state":"translated","value":"Avvia prima il tuo turno come host. Il codice sessione appare solo dopo l'avvio del gioco."}},"ja":{"stringUnit":{"state":"translated","value":"まずホストとして乗務を開始してください。セッションコードはゲーム開始後に表示されます。"}},"ka":{"stringUnit":{"state":"translated","value":"ჯერ დაიწყეთ თქვენი ჰოსტირებული რეისი. სესიის კოდი მხოლოდ თამაშის დაწყების შემდეგ გამოჩნდება."}},"kk":{"stringUnit":{"state":"translated","value":"Алдымен хост нарядыңызды бастаңыз. Сессия коды ойын басталғаннан кейін ғана пайда болады."}},"ko":{"stringUnit":{"state":"translated","value":"먼저 호스트로 근무를 시작하세요. 세션 코드는 게임이 시작된 뒤에만 표시됩니다."}},"ms":{"stringUnit":{"state":"translated","value":"Mulakan tugas anda sebagai hos dahulu. Kod sesi hanya muncul selepas permainan bermula."}},"nl":{"stringUnit":{"state":"translated","value":"Start eerst je dienst als host. Een sessiecode verschijnt pas nadat het spel is gestart."}},"pl":{"stringUnit":{"state":"translated","value":"Najpierw rozpocznij swoją służbę jako host. Kod sesji pojawi się dopiero po uruchomieniu gry."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicie primeiro sua escala como anfitrião. O código da sessão só aparece depois que o jogo começar."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Inicie primeiro a sua escala como anfitrião. O código da sessão só aparece depois de o jogo começar."}},"ru":{"stringUnit":{"state":"translated","value":"Сначала начните свою смену в роли хоста. Код сессии появится только после запуска игры."}},"sr":{"stringUnit":{"state":"translated","value":"Najpre pokrenite smenu kao domaćin. Kod sesije će se pojaviti tek kada se igra pokrene."}},"sv":{"stringUnit":{"state":"translated","value":"Starta först din tjänst som värd. En sessionskod visas först när spelet har startat."}},"th":{"stringUnit":{"state":"translated","value":"เริ่มหน้าที่แบบโฮสต์ก่อน รหัสเซสชันจะปรากฏหลังเกมเริ่มเท่านั้น"}},"fil":{"stringUnit":{"state":"translated","value":"Simulan muna ang duty mo bilang host. Lalabas lang ang session code kapag nagsimula na ang laro."}},"tr":{"stringUnit":{"state":"translated","value":"Önce sunucu olarak görevinizi başlatın. Oturum kodu yalnızca oyun başladıktan sonra görünür."}},"uk":{"stringUnit":{"state":"translated","value":"Спочатку почніть свій наряд як хост. Код сесії з'явиться лише після запуску гри."}},"vi":{"stringUnit":{"state":"translated","value":"Hãy bắt đầu ca của bạn với tư cách chủ phòng trước. Mã phiên chỉ xuất hiện sau khi trò chơi bắt đầu."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"先以主机身份开始任务，游戏启动后才会生成会话码。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先以房主身分開始班次，遊戲啟動後才會產生連線碼。"}}}},
