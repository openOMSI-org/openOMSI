    "Free space: {n}": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Espai lliure: {n}"}},"de":{"stringUnit":{"state":"translated","value":"Freier Platz: {n}"}},"es":{"stringUnit":{"state":"translated","value":"Espacio libre: {n}"}},"fr":{"stringUnit":{"state":"translated","value":"Espace libre : {n}"}},"ka":{"stringUnit":{"state":"translated","value":"თავისუფალი ადგილი: {n}"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Espaço livre: {n}"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Espaço livre: {n}"}},"ru":{"stringUnit":{"state":"translated","value":"Свободно: {n}"}},"sr":{"stringUnit":{"state":"translated","value":"Slobodan prostor: {n}"}},"sv":{"stringUnit":{"state":"translated","value":"Ledigt utrymme: {n}"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可用空間：{n}"}}}},
    "Friends can join from anywhere": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Сябры могуць далучыцца адусюль"}},"ca":{"stringUnit":{"state":"translated","value":"Els amics s'hi poden unir des de qualsevol lloc"}},"cs":{"stringUnit":{"state":"translated","value":"Kamarádi se mohou připojit odkudkoli"}},"de":{"stringUnit":{"state":"translated","value":"Freunde können von überall beitreten"}},"es":{"stringUnit":{"state":"translated","value":"Los amigos pueden unirse desde cualquier lugar"}},"fr":{"stringUnit":{"state":"translated","value":"Vos amis peuvent rejoindre de partout"}},"hi":{"stringUnit":{"state":"translated","value":"दोस्त कहीं से भी जुड़ सकते हैं"}},"hu":{"stringUnit":{"state":"translated","value":"A barátok bárhonnan csatlakozhatnak"}},"id":{"stringUnit":{"state":"translated","value":"Teman dapat bergabung dari mana saja"}},"it":{"stringUnit":{"state":"translated","value":"Gli amici possono unirsi da ovunque"}},"ja":{"stringUnit":{"state":"translated","value":"友達はどこからでも参加できます"}},"ka":{"stringUnit":{"state":"translated","value":"მეგობრებს შეუძლიათ შეუერთდნენ ნებისმიერი ადგილიდან"}},"kk":{"stringUnit":{"state":"translated","value":"Достар кез келген жерден қосыла алады"}},"ko":{"stringUnit":{"state":"translated","value":"친구는 어디서든 참가 가능"}},"ms":{"stringUnit":{"state":"translated","value":"Rakan boleh sertai dari mana-mana"}},"nl":{"stringUnit":{"state":"translated","value":"Vrienden kunnen overal meedoen"}},"pl":{"stringUnit":{"state":"translated","value":"Znajomi mogą dołączyć z dowolnego miejsca"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Amigos podem entrar de qualquer lugar"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Amigos podem entrar de qualquer lugar"}},"ru":{"stringUnit":{"state":"translated","value":"Друзья могут подключиться откуда угодно"}},"sr":{"stringUnit":{"state":"translated","value":"Prijatelji se mogu pridružiti sa bilo kog mesta"}},"sv":{"stringUnit":{"state":"translated","value":"Vänner