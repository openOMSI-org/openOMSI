    "Autumn": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Восень"}},"ca":{"stringUnit":{"state":"translated","value":"Tardor"}},"cs":{"stringUnit":{"state":"translated","value":"Podzim"}},"de":{"stringUnit":{"state":"translated","value":"Herbst"}},"es":{"stringUnit":{"state":"translated","value":"Otoño"}},"fr":{"stringUnit":{"state":"translated","value":"Automne"}},"hi":{"stringUnit":{"state":"translated","value":"पतझड़"}},"hu":{"stringUnit":{"state":"translated","value":"Ősz"}},"id":{"stringUnit":{"state":"translated","value":"Musim gugur"}},"it":{"stringUnit":{"state":"translated","value":"Autunno"}},"ja":{"stringUnit":{"state":"translated","value":"秋"}},"ka":{"stringUnit":{"state":"translated","value":"შემოდგომა"}},"kk":{"stringUnit":{"state":"translated","value":"Күз"}},"ko":{"stringUnit":{"state":"translated","value":"가을"}},"ms":{"stringUnit":{"state":"translated","value":"Musim luruh"}},"nl":{"stringUnit":{"state":"translated","value":"Herfst"}},"pl":{"stringUnit":{"state":"translated","value":"Jesień"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Outono"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Outono"}},"ru":{"stringUnit":{"state":"translated","value":"Осень"}},"sr":{"stringUnit":{"state":"translated","value":"jesen"}},"sv":{"stringUnit":{"state":"translated","value":"Höst"}},"th":{"stringUnit":{"state":"translated","value":"ฤดูใบไม้ร่วง"}},"fil":{"stringUnit":{"state":"translated","value":"Taglagas"}},"tr":{"stringUnit":{"state":"translated","value":"Sonbahar"}},"uk":{"stringUnit":{"state":"translated","value":"Осінь"}},"vi":{"stringUnit":{"state":"translated","value":"Mùa thu"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"秋季"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"秋季"}}}},
