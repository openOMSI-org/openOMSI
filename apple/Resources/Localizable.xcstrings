    "In the Finder, select it in the sidebar, then Files.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"У Finder выберыце яго на бакавой панэлі, потым «Файлы»."}},"ca":{"stringUnit":{"state":"translated","value":"Al Finder, selecciona'l a la barra lateral i després Fitxers."}},"cs":{"stringUnit":{"state":"translated","value":"Ve Finderu ho vyberte na bočním panelu, pak „Soubory“."}},"de":{"stringUnit":{"state":"translated","value":"Wähle es im Finder in der Seitenleiste aus, dann Dateien."}},"es":{"stringUnit":{"state":"translated","value":"En el Finder, selecciónalo en la barra lateral y luego Archivos."}},"fr":{"stringUnit":{"state":"translated","value":"Dans le Finder, sélectionnez-le dans la barre latérale, puis Fichiers."}},"hi":{"stringUnit":{"state":"translated","value":"Finder में, साइडबार में डिवाइस चुनें, फिर फ़ाइलें।"}},"hu":{"stringUnit":{"state":"translated","value":"A Finderben jelöld ki az oldalsávban, majd „Fájlok”."}},"id":{"stringUnit":{"state":"translated","value":"Di Finder, pilih perangkat di bar samping, lalu File."}},"it":{"stringUnit":{"state":"translated","value":"Nel Finder, selezionalo nella barra laterale, poi File."}},"ja":{"stringUnit":{"state":"translated","value":"Finderのサイドバーでデバイスを選択し、「ファイル」を選びます。"}},"ka":{"stringUnit":{"state":"translated","value":"Finder-ში აირჩიეთ ის გვერდით პანელში, შემდეგ „ფაილები“."}},"kk":{"stringUnit":{"state":"translated","value":"Finder-де оны бүйірлік тақтадан таңдаңыз, содан кейін «Файлдар»."}},"ko":{"stringUnit":{"state":"translated","value":"Finder 사이드바에서 기기를 선택한 다음 파일을 선택하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Dalam Finder, pilih peranti di bar sisi, kemudian Fail."}},"nl":{"stringUnit":{"state":"translated","value":"Selecteer het in de Finder in de navigatiekolom, dan Bestanden."}},"pl":{"stringUnit":{"state":"translated","value":"W Finderze zaznacz go na pasku bocznym, potem „Pliki”."}},"pt-BR":{"stringUnit":{"state":"translated","value":"No Finder, selecione-o na barra lateral e depois Arquivos."}},"pt-PT":{"stringUnit":{"state":"translated","value":"No Finder, selecione-o na barra lateral e depois Ficheiros."}},"ru":{"stringUnit":{"state":"translated","value":"В Finder выберите его в боковом меню, затем «Файлы»."}},"sr":{"stringUnit":{"state":"translated","value":"U Finder-u izaberite ga na bočnoj traci, a zatim Files."}},"sv":{"stringUnit":{"state":"translated","value":"Markera den i sidofältet i Finder, sedan Filer."}},"th":{"stringUnit":{"state":"translated","value":"ใน Finder ให้เลือกอุปกรณ์ในแถบด้านข้าง แล้วเลือก “ไฟล์”"}},"fil":{"stringUnit":{"state":"translated","value":"Sa Finder, piliin ito sa sidebar, saka ang Files."}},"tr":{"stringUnit":{"state":"translated","value":"Finder'da kenar çubuğunda onu seçin, ardından “Dosyalar”."}},"uk":{"stringUnit":{"state":"translated","value":"У Finder виберіть його на бічній панелі, потім «Файли»."}},"vi":{"stringUnit":{"state":"translated","value":"Trong Finder, chọn thiết bị ở thanh bên, rồi chọn Tệp."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在Finder（访达）的边栏中选择该设备，然后选择“文件”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在 Finder 的側邊欄選擇該裝置，然後選擇「檔案」。"}}}},
