    "Turn your phone, and let's go!": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Павярніце тэлефон, і паехалі!"}},"ca":{"stringUnit":{"state":"translated","value":"Gira el telèfon i som-hi!"}},"cs":{"stringUnit":{"state":"translated","value":"Otočte telefon a jedeme!"}},"de":{"stringUnit":{"state":"translated","value":"Dreh dein Handy, und los geht's!"}},"es":{"stringUnit":{"state":"translated","value":"Gira el teléfono, ¡y en marcha!"}},"fr":{"stringUnit":{"state":"translated","value":"Tournez votre téléphone, et c'est parti !"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोन को लैंडस्केप में घुमाएँ और चलिए शुरू करें!"}},"hu":{"stringUnit":{"state":"translated","value":"Fordítsd el a telefont, és indulás!"}},"id":{"stringUnit":{"state":"translated","value":"Putar ponsel Anda ke posisi lanskap, lalu ayo berangkat!"}},"it":{"stringUnit":{"state":"translated","value":"Ruota il telefono, e si parte!"}},"ja":{"stringUnit":{"state":"translated","value":"端末を横向きにして、出発しましょう！"}},"ka":{"stringUnit":{"state":"translated","value":"შეატრიალეთ ტელეფონი და დავიწყოთ!"}},"kk":{"stringUnit":{"state":"translated","value":"Телефонды бұрыңыз, ал енді жолға!"}},"ko":{"stringUnit":{"state":"translated","value":"휴대폰을 가로로 돌리고 출발하세요!"}},"ms":{"stringUnit":{"state":"translated","value":"Pusingkan telefon anda ke mod landskap, dan mari mula!"}},"nl":{"stringUnit":{"state":"translated","value":"Draai je telefoon, en daar gaan we!"}},"pl":{"stringUnit":{"state":"translated","value":"Obróć telefon i ruszamy!"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gire o celular e vamos lá!"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Rode o telemóvel e vamos lá!"}},"ru":{"stringUnit":{"state":"translated","value":"Поверните телефон, и поехали!"}},"sr":{"stringUnit":{"state":"translated","value":"Okrenite telefon i idemo!"}},"sv":{"stringUnit":{"state":"translated","value":"Vrid telefonen, så kör vi!"}},"th":{"stringUnit":{"state":"translated","value":"หมุนโทรศัพท์เป็นแนวนอน แล้วไปกันเลย!"}},"fil":{"stringUnit":{"state":"translated","value":"Ipihit nang pahiga ang iyong phone, at tara na!"}},"tr":{"stringUnit":{"state":"translated","value":"Telefonunuzu çevirin, haydi yola!"}},"uk":{"stringUnit":{"state":"translated","value":"Поверніть телефон, і поїхали!"}},"vi":{"stringUnit":{"state":"translated","value":"Xoay ngang điện thoại và bắt đầu thôi!"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"把手机横过来，出发吧！"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將手機轉為橫向，出發吧！"}}}},
