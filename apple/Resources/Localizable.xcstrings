    "Entry point {n}": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Кропка ўваходу {n}"}},"ca":{"stringUnit":{"state":"translated","value":"Punt d'entrada {n}"}},"cs":{"stringUnit":{"state":"translated","value":"Výchozí bod {n}"}},"de":{"stringUnit":{"state":"translated","value":"Einstiegspunkt {n}"}},"es":{"stringUnit":{"state":"translated","value":"Punto de entrada {n}"}},"fr":{"stringUnit":{"state":"translated","value":"Point d'entrée {n}"}},"hi":{"stringUnit":{"state":"translated","value":"एंट्री पॉइंट {n}"}},"hu":{"stringUnit":{"state":"translated","value":"Kezdőpont {n}"}},"id":{"stringUnit":{"state":"translated","value":"Titik masuk {n}"}},"it":{"stringUnit":{"state":"translated","value":"Punto di ingresso {n}"}},"ja":{"stringUnit":{"state":"translated","value":"出発地点 {n}"}},"ka":{"stringUnit":{"state":"translated","value":"შესასვლელი წერტილი {n}"}},"kk":{"stringUnit":{"state":"translated","value":"Кіру нүктесі {n}"}},"ko":{"stringUnit":{"state":"translated","value":"출발 지점 {n}"}},"ms":{"stringUnit":{"state":"translated","value":"Titik masuk {n}"}},"nl":{"stringUnit":{"state":"translated","value":"Startpunt {n}"}},"pl":{"stringUnit":{"state":"translated","value":"Punkt startowy {n}"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ponto de entrada {n}"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ponto de entrada {n}"}},"ru":{"stringUnit":{"state":"translated","value":"Точка входа {n}"}},"sr":{"stringUnit":{"state":"translated","value":"Ulazna tačka {n}"}},"sv":{"stringUnit":{"state":"translated","value":"Startpunkt {n}"}},"th":{"stringUnit":{"state":"translated","value":"จุดเริ่มต้น {n}"}},"fil":{"stringUnit":{"state":"translated","value":"Panimulang punto {n}"}},"tr":{"stringUnit":{"state":"translated","value":"Giriş noktası {n}"}},"uk":{"stringUnit":{"state":"translated","value":"Точка входу {n}"}},"vi":{"stringUnit":{"state":"translated","value":"Điểm bắt đầu {n}"}},"zh-Hans":{"stringUnit":{"state":"translated","value"