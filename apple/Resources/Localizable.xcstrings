    "Arrow keys switch the cameras with a wheel too (no glance)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Стрэлкі пераключаюць камеры і з рулём (без позірку ўбок)"}},"ca":{"stringUnit":{"state":"translated","value":"Les fletxes també canvien de càmera amb volant (sense mirar als costats)"}},"cs":{"stringUnit":{"state":"translated","value":"Šipky přepínají kamery i s volantem (bez rozhlížení)"}},"de":{"stringUnit":{"state":"translated","value":"Pfeiltasten schalten auch bei angeschlossenem Lenkrad durch die Kameras (kein Umsehen)"}},"es":{"stringUnit":{"state":"translated","value":"Las flechas cambian de cámara también con volante (sin mirar a los lados)"}},"fr":{"stringUnit":{"state":"translated","value":"Les flèches changent de caméra aussi avec un volant (sans coup d'œil)"}},"hi":{"stringUnit":{"state":"translated","value":"व्हील के साथ भी ऐरो कीज़ कैमरे बदलती हैं (झाँकना नहीं)"}},"hu":{"stringUnit":{"state":"translated","value":"A nyílbillentyűk kormánnyal is kamerát váltanak (oldalra nézés nélkül)"}},"id":{"stringUnit":{"state":"translated","value":"Tombol panah juga mengganti kamera saat memakai setir (tanpa menoleh)"}},"it":{"stringUnit":{"state":"translated","value":"Le frecce cambiano telecamera anche con il volante (senza sguardo laterale)"}},"ja":{"stringUnit":{"state":"translated","value":"ハンドル使用時も矢印キーでカメラを切り替え（見回しなし）"}},"ka":{"stringUnit":{"state":"translated","value":"ისრიანი კლავიშები საჭითაც ცვლის კამერებს (მიხედვის გარეშე)"}},"kk":{"stringUnit":{"state":"translated","value":"Көрсеткі пернелері рульмен де камераларды ауыстырады (жанға қараусыз)"}},"ko":{"stringUnit":{"state":"translated","value":"휠 사용 시에도 방향키로 카메라 전환 (둘러보기 없음)"}},"ms":{"stringUnit":{"state":"translated","value":"Kekunci anak panah juga menukar kamera semasa menggunakan stereng (tanpa menoleh)"}},"nl":{"stringUnit":{"state":"translated","value":"Pijltjestoetsen wisselen ook met een stuur tussen camera's (zonder zijwaarts kijken)"}},"pl":{"stringUnit":{"state":"translated","value":"Strzałki przełączają kamery także z kierownicą (bez rozglądania się)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Setas também trocam as câmeras ao usar volante (sem olhar para os lados)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"As setas também mudam de câmara ao usar um volante (sem olhar para os lados)"}},"ru":{"stringUnit":{"state":"translated","value":"Стрелки переключают камеры и с рулём (без взгляда в сторону)"}},"sr":{"stringUnit":{"state":"translated","value":"Tasteri sa strelicama takođe menjaju kamere pomoću točkića (bez pogleda)"}},"sv":{"stringUnit":{"state":"translated","value":"Piltangenter byter kamera även med en ratt (ingen sidoblick)"}},"th":{"stringUnit":{"state":"translated","value":"ปุ่มลูกศรสลับกล้องแม้ใช้พวงมาลัย (ไม่มองซ้ายขวา)"}},"fil":{"stringUnit":{"state":"translated","value":"Pinapalitan din ng mga arrow key ang camera kahit may manibela (walang pagsulyap)"}},"tr":{"stringUnit":{"state":"translated","value":"Ok tuşları direksiyonla da kameraları değiştirir (yana bakış yok)"}},"uk":{"stringUnit":{"state":"translated","value":"Стрілки перемикають камери й з кермом (без погляду вбік)"}},"vi":{"stringUnit":{"state":"translated","value":"Phím mũi tên cũng chuyển camera khi dùng vô lăng (không liếc nhìn)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用方向盘时方向键也切换视角（不转头查看）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用方向盤時方向鍵也切換視角（不轉頭查看）"}}}},
    "As the picture (Enhanced)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Як карцінка (Палепшаная)"}},"ca":{"stringUnit":{"state":"translated","value":"Com la imatge (Millorat)"}},"cs":{"stringUnit":{"state":"translated","value":"Jako obraz (Vylepšená)"}},"de":{"stringUnit":{"state":"translated","value":"Wie das Bild (Erweitert)"}},"es":{"stringUnit":{"state":"translated","value":"Como la imagen (Mejorado)"}},"fr":{"stringUnit":{"state":"translated","value":"Comme l'image (Améliorée)"}},"hi":{"stringUnit":{"state":"translated","value":"चित्र जैसा (एन्हांस्ड)"}},"hu":{"stringUnit":{"state":"translated","value":"Mint a kép (Továbbfejlesztett)"}},"id":{"stringUnit":{"state":"translated","value":"Seperti gambar (Ditingkatkan)"}},"it":{"stringUnit":{"state":"translated","value":"Come l'immagine (Migliorata)"}},"ja":{"stringUnit":{"state":"translated","value":"本画面と同じ(強化)"}},"ka":{"stringUnit":{"state":"translated","value":"სურათის მსგავსად (გაუმჯობესებული)"}},"kk":{"stringUnit":{"state":"translated","value":"Сурет сияқты (Жақсартылған)"}},"ko":{"stringUnit":{"state":"translated","value":"화면과 동일 (향상)"}},"ms":{"stringUnit":{"state":"translated","value":"Seperti gambar (Dipertingkat)"}},"nl":{"stringUnit":{"state":"translated","value":"Zoals het beeld (Verbeterd)"}},"pl":{"stringUnit":{"state":"translated","value":"Jak obraz (Ulepszona)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Como a imagem (Aprimorado)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Como a imagem (Aprimorado)"}},"ru":{"stringUnit":{"state":"translated","value":"Как картинка (Улучшенная)"}},"sr":{"stringUnit":{"state":"translated","value":"Kao na slici (poboljšano)"}},"sv":{"stringUnit":{"state":"translated","value":"Som bilden (Förbättrad)"}},"th":{"stringUnit":{"state":"translated","value":"เหมือนภาพหลัก (ปรับปรุง)"}},"fil":{"stringUnit":{"state":"translated","value":"Gaya ng larawan (Pinahusay)"}},"tr":{"stringUnit":{"state":"translated","value":"Görüntü gibi (Geliştirilmiş)"}},"uk":{"stringUnit":{"state":"translated","value":"Як зображення (Покращена)"}},"vi":{"stringUnit":{"state":"translated","value":"Như hình ảnh (Nâng cao)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"与主画面相同（增强）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"與主畫面相同（增強）"}}}},
    "Ask your friend to start a hosted duty and copy the session code.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Папрасіце сябра пачаць наряд як хост і скапіяваць код сесіі."}},"ca":{"stringUnit":{"state":"translated","value":"Demana al teu amic que iniciï un servei com a amfitrió i copiï el codi de sessió."}},"cs":{"stringUnit":{"state":"translated","value":"Požádejte kamaráda, ať spustí službu jako hostitel a zkopíruje kód relace."}},"de":{"stringUnit":{"state":"translated","value":"Bitte deinen Freund, einen gehosteten Dienst zu starten und den Sitzungscode zu kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Pide a tu amigo que inicie un servicio como anfitrión y copie el código de sesión."}},"fr":{"stringUnit":{"state":"translated","value":"Demandez à votre ami de lancer un service hébergé et de copier le code de session."}},"hi":{"stringUnit":{"state":"translated","value":"दोस्त से होस्ट के रूप में ड्यूटी शुरू करने और सेशन कोड कॉपी करने को कहें।"}},"hu":{"stringUnit":{"state":"translated","value":"Kérd meg a barátodat, hogy indítson szolgálatot házigazdaként, és másolja ki a munkamenet-kódot."}},"id":{"stringUnit":{"state":"translated","value":"Minta teman Anda memulai tugas sebagai host dan menyalin kode sesi."}},"it":{"stringUnit":{"state":"translated","value":"Chiedi al tuo amico di avviare un turno come host e di copiare il codice sessione."}},"ja":{"stringUnit":{"state":"translated","value":"友達にホストとして乗務を開始してもらい、セッションコードをコピーしてもらいます。"}},"ka":{"stringUnit":{"state":"translated","value":"სთხოვეთ მეგობარს, დაიწყოს ჰოსტირებული რეისი და დააკოპიროს სესიის კოდი."}},"kk":{"stringUnit":{"state":"translated","value":"Досыңыздан хост ретінде нарядты бастап, сессия кодын көшіруді сұраңыз."}},"ko":{"stringUnit":{"state":"translated","value":"친구에게 호스트로 근무를 시작하고 세션 코드를 복사해 달라고 하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Minta rakan anda memulakan tugas sebagai hos dan menyalin kod sesi."}},"nl":{"stringUnit":{"state":"translated","value":"Vraag je vriend een dienst als host te starten en de sessiecode te kopiëren."}},"pl":{"stringUnit":{"state":"translated","value":"Poproś znajomego, aby rozpoczął służbę jako host i skopiował kod sesji."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Peça ao seu amigo para iniciar uma escala como anfitrião e copiar o código da sessão."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Peça ao seu amigo que inicie uma escala como anfitrião e copie o código da sessão."}},"ru":{"stringUnit":{"state":"translated","value":"Попросите друга начать смену в роли хоста и скопировать код сессии."}},"sr":{"stringUnit":{"state":"translated","value":"Zamolite prijatelja da pokrene smenu kao domaćin i kopira kod sesije."}},"sv":{"stringUnit":{"state":"translated","value":"Be din vän att starta en tjänst som värd och kopiera sessionskoden."}},"th":{"stringUnit":{"state":"translated","value":"ขอให้เพื่อนเริ่มหน้าที่ในฐานะโฮสต์ แล้วคัดลอกรหัสเซสชัน"}},"fil":{"stringUnit":{"state":"translated","value":"Hilingin sa kaibigan mo na magsimula ng duty bilang host at kopyahin ang session code."}},"tr":{"stringUnit":{"state":"translated","value":"Arkadaşınızdan sunucu olarak bir görev başlatmasını ve oturum kodunu kopyalamasını isteyin."}},"uk":{"stringUnit":{"state":"translated","value":"Попросіть друга почати наряд як хост і скопіювати код сесії."}},"vi":{"stringUnit":{"state":"translated","value":"Nhờ bạn của bạn tạo phòng, bắt đầu ca rồi sao chép mã phiên."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请朋友先以主机身份开始任务，再复制会话码。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請朋友先以房主身分開始班次，再複製連線碼。"}}}},
