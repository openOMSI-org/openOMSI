    "Choose a bus without session details": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Выбраць аўтобус без даных сесіі"}},"ca":{"stringUnit":{"state":"translated","value":"Tria un autobús sense les dades de la sessió"}},"cs":{"stringUnit":{"state":"translated","value":"Vybrat autobus bez podrobností relace"}},"de":{"stringUnit":{"state":"translated","value":"Bus ohne Sitzungsdetails auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir un autobús sin los detalles de la sesión"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un bus sans les détails de la session"}},"hi":{"stringUnit":{"state":"translated","value":"सेशन की जानकारी के बिना बस चुनें"}},"hu":{"stringUnit":{"state":"translated","value":"Busz választása a munkamenet adatai nélkül"}},"id":{"stringUnit":{"state":"translated","value":"Pilih bus tanpa detail sesi"}},"it":{"stringUnit":{"state":"translated","value":"Scegli un autobus senza i dettagli della sessione"}},"ja":{"stringUnit":{"state":"translated","value":"セッション情報なしでバスを選択"}},"ka":{"stringUnit":{"state":"translated","value":"ავტობუსის არჩევა სესიის დეტალების გარეშე"}},"kk":{"stringUnit":{"state":"translated","value":"Сессия деректерінсіз автобус таңдау"}},"ko":{"stringUnit":{"state":"translated","value":"세션 정보 없이 버스 선택"}},"ms":{"stringUnit":{"state":"translated","value":"Pilih bas tanpa butiran sesi"}},"nl":{"stringUnit":{"state":"translated","value":"Kies een bus zonder sessiegegevens"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz autobus bez szczegółów sesji"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher um ônibus sem os detalhes da sessão"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolher um autocarro sem os detalhes da sessão"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать автобус без данных сессии"}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite autobus bez podataka o sesiji"}},"sv":{"stringUnit":{"state":"translated","value":"Välj en buss utan sessionsuppgifter"}},"th":{"stringUnit":{"state":"translated","value":"เลือกรถบัสโดยไม่มีรายละเอียดเซสชัน"}},"fil":{"stringUnit":{"state":"translated","value":"Pumili ng bus nang walang detalye ng session"}},"tr":{"stringUnit":{"state":"translated","value":"Oturum ayrıntıları olmadan otobüs seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати автобус без даних сесії"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn xe buýt mà không có thông tin phiên"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不读取会话信息，继续选择巴士"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不讀取房間資料，繼續選車"}}}},
    "Choose a date": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Выбраць дату"}},"ca":{"stringUnit":{"state":"translated","value":"Tria una data"}},"cs":{"stringUnit":{"state":"translated","value":"Vybrat datum"}},"de":{"stringUnit":{"state":"translated","value":"Datum wählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir una fecha"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir une date"}},"hi":{"stringUnit":{"state":"translated","value":"तारीख चुनें"}},"hu":{"stringUnit":{"state":"translated","value":"Dátum kiválasztása"}},"id":{"stringUnit":{"state":"translated","value":"Pilih tanggal"}},"it":{"stringUnit":{"state":"translated","value":"Scegli una data"}},"ja":{"stringUnit":{"state":"translated","value":"日付を選ぶ"}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ თარიღი"}},"kk":{"stringUnit":{"state":"translated","value":"Күнді таңдау"}},"ko":{"stringUnit":{"state":"translated","value":"날짜 선택"}},"ms":{"stringUnit":{"state":"translated","value":"Pilih tarikh"}},"nl":{"stringUnit":{"state":"translated","value":"Kies een datum"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz datę"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher uma data"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolher uma data"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать дату"}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite datum"}},"sv":{"stringUnit":{"state":"translated","value":"Välj ett datum"}},"th":{"stringUnit":{"state":"translated","value":"เลือกวันที่"}},"fil":{"stringUnit":{"state":"translated","value":"Pumili ng petsa"}},"tr":{"stringUnit":{"state":"translated","value":"Bir tarih seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Вибрати дату"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn ngày"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择日期"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇日期"}}}},
