    "This key is already used by: {actions}": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Aquesta tecla ja es fa servir per a: {actions}"}},"de":{"stringUnit":{"state":"translated","value":"Diese Taste ist schon belegt: {actions}"}},"es":{"stringUnit":{"state":"translated","value":"Esta tecla ya se utiliza para: {actions}"}},"fr":{"stringUnit":{"state":"translated","value":"Cette touche est déjà utilisée par : {actions}"}},"ka":{"stringUnit":{"state":"translated","value":"ეს კლავიში უკვე გამოიყენება: {actions}"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta tecla já é usada por: {actions}"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Esta tecla já é usada por: {actions}"}},"ru":{"stringUnit":{"state":"translated","value":"Эта клавиша уже занята: {actions}"}},"sr":{"stringUnit":{"state":"translated","value":"Ovaj ključ već koristi: {actions}"}},"sv":{"stringUnit":{"state":"translated","value":"Denna tangent används redan av: {actions}"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此按鍵已用於：{actions}"}}}},
    "This map has no lines to drive on this date. Choose a free drive, or another date.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"На гэтай мапе на гэту дату няма ліній. Абярыце свабодную язду або іншую дату."}},"ca":{"stringUnit":{"state":"translated","value":"Aquest mapa no té línies per conduir en aquesta data. Tria una conducció lliure o una altra data."}},"cs":{"stringUnit":{"state":"translated","value":"Tato mapa nemá v tento den žádné linky k jízdě. Vyberte volnou jízdu nebo jiné datum."}},"de":{"stringUnit":{"state":"translated","value":"Diese Karte hat an diesem Datum keine Linien. Wähle freies Fahren oder ein anderes Datum."}},"es":{"stringUnit":{"state":"translated","value":"Este mapa no tiene líneas disponibles en esta fecha. Elige conducción libre u otra fecha."}},"fr":{"stringUnit":{"state":"translated","value":"Cette carte n'a aucune ligne à conduire à cette date. Choisissez la conduite freeroam ou une autre date."}},"hi":{"stringUnit":{"state":"translated","value":"इस मैप पर इस तारीख़ को चलाने के लिए कोई लाइन नहीं है। फ़्री ड्राइव या कोई दूसरी तारीख़ चुनें।"}},"hu":{"stringUnit":{"state":"translated","value":"Ezen a térképen ezen a napon nincs vezethető járat. Válassz szabad vezetést vagy másik dátumot."}},"id":{"stringUnit":{"state":"translated","value":"Peta ini tidak punya jalur untuk dikemudikan pada tanggal ini. Pilih mengemudi bebas atau tanggal lain."}},"it":{"stringUnit":{"state":"translated","value":"Questa mappa non ha linee da guidare in questa data. Scegli la guida libera o un'altra data."}},"ja":{"stringUnit":{"state":"translated","value":"このマップにはこの日に運転できる系統がありません。フリードライブか別の日付を選んでください。"}},"ka":{"stringUnit":{"state":"translated","value":"ამ რუკას ამ თარიღზე სავალი ხაზები არ აქვს. აირჩიეთ თავისუფალი მართვა ან სხვა თარიღი."}},"kk":{"stringUnit":{"state":"translated","value":"Бұл картада осы күні жүретін желілер жоқ. Еркін жүруді немесе басқа күнді таңдаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"이 지도에는 이 날짜에 운행할 노선이 없습니다. 자유 운전이나 다른 날짜를 선택하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Peta ini tiada laluan untuk dipandu pada tarikh ini. Pilih pemanduan bebas atau tarikh lain."}},"nl":{"stringUnit":{"state":"translated","value":"Deze kaart heeft op deze datum geen lijnen om te rijden. Kies vrij rijden of een andere datum."}},"pl":{"stringUnit":{"state":"translated","value":"Ta mapa nie ma linii do jazdy w tym dniu. Wybierz jazdę swobodną lub inną datę."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este mapa não tem linhas para dirigir nesta data. Escolha a direção livre ou outra data."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Este mapa não tem linhas para conduzir nesta data. Escolha a condução livre ou outra data."}},"ru":{"stringUnit":{"state":"translated","value":"На этой карте в эту дату нет линий. Выберите свободную езду или другую дату."}},"sr":{"stringUnit":{"state":"translated","value":"Ova mapa nema linija za vožnju na ovaj datum. Izaberite besplatnu vožnju ili drugi datum."}},"sv":{"stringUnit":{"state":"translated","value":"Den här kartan har inga linjer att köra detta datum. Välj fri körning eller ett annat datum."}},"th":{"stringUnit":{"state":"translated","value":"แผนที่นี้ไม่มีสายรถให้ขับในวันที่นี้ เลือกขับอิสระหรือวันอื่น"}},"fil":{"stringUnit":{"state":"translated","value":"Walang linyang mamamaneho sa mapang ito sa petsang ito. Pumili ng malayang pagmamaneho o ibang petsa."}},"tr":{"stringUnit":{"state":"translated","value":"Bu haritada bu tarihte sürülecek hat yok. Serbest sürüşü veya başka bir tarihi seçin."}},"uk":{"stringUnit":{"state":"translated","value":"На цій мапі на цю дату немає ліній. Оберіть вільну поїздку або іншу дату."}},"vi":{"stringUnit":{"state":"translated","value":"Bản đồ này không có tuyến nào để lái vào ngày này. Hãy chọn lái tự do hoặc ngày khác."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此地图在该日期没有可驾驶的线路。请选择自由驾驶或其他日期。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此地圖在所選日期沒有可駕駛路線。請選擇自由駕駛或其他日期。"}}}},
    "This map has no timetable (no TTData lines).": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гэтая мапа не мае раскладу (няма ліній TTData)."}},"ca":{"stringUnit":{"state":"translated","value":"Aquest mapa no té horaris (cap línia a TTData)."}},"cs":{"stringUnit":{"state":"translated","value":"Tato mapa nemá jízdní řád (žádné linky TTData)."}},"de":{"stringUnit":{"state":"translated","value":"Diese Karte hat keinen Fahrplan (keine TTData-Linien)."}},"es":{"stringUnit":{"state":"translated","value":"Este mapa no tiene horario (sin líneas TTData)."}},"fr":{"stringUnit":{"state":"translated","value":"Cette carte n'a pas d'horaire (aucune ligne TTData)."}},"hi":{"stringUnit":{"state":"translated","value":"इस मैप में कोई टाइमटेबल नहीं है (कोई TTData लाइन नहीं)।"}},"hu":{"stringUnit":{"state":"translated","value":"Ennek a térképnek nincs menetrendje (nincsenek TTData járatok)."}},"id":{"stringUnit":{"state":"translated","value":"Peta ini tidak memiliki jadwal (tidak ada jalur TTData)."}},"it":{"stringUnit":{"state":"translated","value":"Questa mappa non ha orario (nessuna linea TTData)."}},"ja":{"stringUnit":{"state":"translated","value":"このマップには時刻表がありません(TTDataの系統なし)。"}},"ka":{"stringUnit":{"state":"translated","value":"ამ რუკას განრიგი არ აქვს (TTData ხაზები არ არის)."}},"kk":{"stringUnit":{"state":"translated","value":"Бұл картада кесте жоқ (TTData желілері жоқ)."}},"ko":{"stringUnit":{"state":"translated","value":"이 지도에는 시간표가 없습니다(TTData 노선 없음)."}},"ms":{"stringUnit":{"state":"translated","value":"Peta ini tiada jadual (tiada laluan TTData)."}},"nl":{"stringUnit":{"state":"translated","value":"Deze kaart heeft geen dienstregeling (geen TTData-lijnen)."}},"pl":{"stringUnit":{"state":"translated","value":"Ta mapa nie ma rozkładu jazdy (brak linii TTData)."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este mapa não tem tabela horária (sem linhas TTData)."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Este mapa não tem horário (sem linhas TTData)."}},"ru":{"stringUnit":{"state":"translated","value":"У этой карты нет расписания (нет линий TTData)."}},"sr":{"stringUnit":{"state":"translated","value":"Ova mapa nema red vožnje (nema linija TTData)."}},"sv":{"stringUnit":{"state":"translated","value":"Den här kartan har ingen tidtabell (inga TTData-linjer)."}},"th":{"stringUnit":{"state":"translated","value":"แผนที่นี้ไม่มีตารางเวลา (ไม่มีสายรถใน TTData)"}},"fil":{"stringUnit":{"state":"translated","value":"Walang iskedyul ang mapang ito (walang linya sa TTData)."}},"tr":{"stringUnit":{"state":"translated","value":"Bu haritada tarife yok (TTData hattı yok)."}},"uk":{"stringUnit":{"state":"translated","value":"Ця мапа не має розкладу (немає ліній TTData)."}},"vi":{"stringUnit":{"state":"translated","value":"Bản đồ này không có thời gian biểu (không có tuyến TTData)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此地图没有时刻表(没有TTData线路)。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此地圖沒有時間表（無 TTData 路線）。"}}}},
    "This tour does not run on the chosen date; it runs next on {date}.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гэты абарот не курсуе ў выбраную дату; наступны раз: {date}."}},"ca":{"stringUnit":{"state":"translated","value":"Aquest torn no circula en la data triada; el proper dia que circula és el {date}."}},"cs":{"stringUnit":{"state":"translated","value":"Tento turnus ve zvolený den nejede; příště jede {date}."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Umlauf fährt am gewählten Datum nicht; das nächste Mal am {date}."}},"es":{"stringUnit":{"state":"translated","value":"Este turno no circula en la fecha elegida; su próximo día de circulación es el {date}."}},"fr":{"stringUnit":{"state":"translated","value":"Ce service ne circule pas à la date choisie ; il circule à nouveau le {date}."}},"hi":{"stringUnit":{"state":"translated","value":"यह टूर चुनी गई तारीख़ को नहीं चलता; यह अगली बार {date} को चलेगा।"}},"hu":{"stringUnit":{"state":"translated","value":"Ez a forda nem közlekedik a választott napon; legközelebb: {date}."}},"id":{"stringUnit":{"state":"translated","value":"Perjalanan ini tidak berjalan pada tanggal yang dipilih; berikutnya berjalan pada {date}."}},"it":{"stringUnit":{"state":"translated","value":"Questo turno non circola nella data scelta; circola di nuovo il {date}."}},"ja":{"stringUnit":{"state":"translated","value":"この行路は選んだ日付には運行しません。次の運行日は {date} です。"}},"ka":{"stringUnit":{"state":"translated","value":"ეს რეისი არჩეულ თარიღზე არ სრულდება; შემდეგ სრულდება {date}."}},"kk":{"stringUnit":{"state":"translated","value":"Бұл рейстер тізбегі таңдалған күні жүрмейді; келесі жолы {date} жүреді."}},"ko":{"stringUnit":{"state":"translated","value":"이 운행 순번은 선택한 날짜에 운행하지 않습니다. 다음 운행일은 {date}입니다."}},"ms":{"stringUnit":{"state":"translated","value":"Pusingan ini tidak beroperasi pada tarikh yang dipilih; ia beroperasi seterusnya pada {date}."}},"nl":{"stringUnit":{"state":"translated","value":"Deze omloop rijdt niet op de gekozen datum; de volgende keer op {date}."}},"pl":{"stringUnit":{"state":"translated","value":"Ta brygada nie kursuje w wybranym dniu; następnym razem kursuje {date}."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta escala não circula na data escolhida; volta a circular em {date}."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Esta escala não circula na data escolhida; volta a circular a {date}."}},"ru":{"stringUnit":{"state":"translated","value":"Этот выход не работает в выбранную дату; ближайший: {date}."}},"sr":{"stringUnit":{"state":"translated","value":"Ova tura nije predviđena za izabrani datum; naredni polazak je {date}."}},"sv":{"stringUnit":{"state":"translated","value":"Det här omloppet körs inte på valt datum; nästa gång är {date}."}},"th":{"stringUnit":{"state":"translated","value":"รอบเดินรถนี้ไม่วิ่งในวันที่เลือก จะวิ่งครั้งถัดไปวันที่ {date}"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi tumatakbo ang biyaheng ito sa napiling petsa; susunod itong tatakbo sa {date}."}},"tr":{"stringUnit":{"state":"translated","value":"Bu sefer turu seçilen tarihte çalışmıyor; bir sonraki çalışma tarihi {date}."}},"uk":{"stringUnit":{"state":"translated","value":"Цей оборот не курсує у вибрану дату; наступного разу: {date}."}},"vi":{"stringUnit":{"state":"translated","value":"Lượt chạy này không chạy vào ngày đã chọn; lần chạy tiếp theo là {date}."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此班次在所选日期不运行；下次运行日期为 {date}。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此車次不在所選日期行駛；下次行駛日期為 {date}。"}}}},
    "This tour does not run within a year of the chosen date.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гэты абарот не курсуе на працягу года ад выбранай даты."}},"ca":{"stringUnit":{"state":"translated","value":"Aquest torn no circula durant l'any següent a la data triada."}},"cs":{"stringUnit":{"state":"translated","value":"Tento turnus do roka od zvoleného data nejede."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Umlauf fährt innerhalb eines Jahres ab dem Datum nicht."}},"es":{"stringUnit":{"state":"translated","value":"Este turno no circula durante el año posterior a la fecha elegida."}},"fr":{"stringUnit":{"state":"translated","value":"Ce service ne circule pas dans l'année qui suit la date choisie."}},"hi":{"stringUnit":{"state":"translated","value":"यह टूर चुनी गई तारीख़ से एक साल के भीतर नहीं चलता।"}},"hu":{"stringUnit":{"state":"translated","value":"Ez a forda a választott dátumtól számított egy éven belül nem közlekedik."}},"id":{"stringUnit":{"state":"translated","value":"Perjalanan ini tidak berjalan dalam setahun sejak tanggal yang dipilih."}},"it":{"stringUnit":{"state":"translated","value":"Questo turno non circola entro un anno dalla data scelta."}},"ja":{"stringUnit":{"state":"translated","value":"この行路は選んだ日付から1年以内に運行しません。"}},"ka":{"stringUnit":{"state":"translated","value":"ეს რეისი არჩეული თარიღიდან ერთი წლის განმავლობაში არ სრულდება."}},"kk":{"stringUnit":{"state":"translated","value":"Бұл рейстер тізбегі таңдалған күннен бастап бір жыл ішінде жүрмейді."}},"ko":{"stringUnit":{"state":"translated","value":"이 운행 순번은 선택한 날짜로부터 1년 안에 운행하지 않습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Pusingan ini tidak beroperasi dalam tempoh setahun dari tarikh yang dipilih."}},"nl":{"stringUnit":{"state":"translated","value":"Deze omloop rijdt niet binnen een jaar na de gekozen datum."}},"pl":{"stringUnit":{"state":"translated","value":"Ta brygada nie kursuje w ciągu roku od wybranej daty."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta escala não circula no período de um ano a partir da data escolhida."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Esta escala não circula no espaço de um ano a partir da data escolhida."}},"ru":{"stringUnit":{"state":"translated","value":"Этот выход не работает в течение года от выбранной даты."}},"sr":{"stringUnit":{"state":"translated","value":"Za ovu turu nema polaska u roku od godinu dana od izabranog datuma."}},"sv":{"stringUnit":{"state":"translated","value":"Det här omloppet körs inte inom ett år från valt datum."}},"th":{"stringUnit":{"state":"translated","value":"รอบเดินรถนี้ไม่วิ่งภายในหนึ่งปีนับจากวันที่เลือก"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi tumatakbo ang biyaheng ito sa loob ng isang taon mula sa napiling petsa."}},"tr":{"stringUnit":{"state":"translated","value":"Bu sefer turu seçilen tarihten itibaren bir yıl içinde çalışmıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Цей оборот не курсує протягом року від вибраної дати."}},"vi":{"stringUnit":{"state":"translated","value":"Lượt chạy này không chạy trong vòng một năm kể từ ngày đã chọn."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此班次在所选日期起一年内不运行。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此班次在所選日期起一年內不會行駛。"}}}},
    "Three equal screens in a horizontal row. OpenXR takes priority.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Tres pantalles iguals alineades horitzontalment. OpenXR té prioritat."}},"de":{"stringUnit":{"state":"translated","value":"Drei gleiche Bildschirme in einer waagerechten Reihe. OpenXR hat Vorrang."}},"es":{"stringUnit":{"state":"translated","value":"Tres pantallas iguales en fila horizontal. OpenXR tiene prioridad."}},"fr":{"stringUnit":{"state":"translated","value":"Trois écrans identiques côte à côte. OpenXR est prioritaire."}},"ka":{"stringUnit":{"state":"translated","value":"სამი ერთნაირი ეკრანი ჰორიზონტალურ რიგში. OpenXR-ს აქვს პრიორიტეტი."}},"nl":{"stringUnit":{"state":"translated","value":"Drie gelijke schermen naast elkaar. OpenXR krijgt voorrang."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Três telas iguais lado a lado na horizontal. O OpenXR tem prioridade."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Três ecrãs iguais lado a lado na horizontal. O OpenXR tem prioridade."}},"ru":{"stringUnit":{"state":"translated","value":"Три одинаковых экрана в горизонтальный ряд. OpenXR имеет приоритет."}},"sr":{"stringUnit":{"state":"translated","value":"Tri jednaka ekrana u horizontalnom nizu. OpenXR ima prednost."}},"sv":{"stringUnit":{"state":"translated","value":"Tre lika stora skärmar i en vågrät rad. OpenXR har företräde."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"水平排列的三个相同屏幕。OpenXR 优先。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"水平排的三個相等的螢幕。 OpenXR 優先。"}}}},
    "Three screen projections": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Projeccions de tres pantalles"}},"de":{"stringUnit":{"state":"translated","value":"Projektion auf drei Bildschirme"}},"es":{"stringUnit":{"state":"translated","value":"Tres proyecciones de pantalla"}},"fr":{"stringUnit":{"state":"translated","value":"Projection sur trois écrans"}},"ka":{"stringUnit":{"state":"translated","value":"სამეკრანიანი პროექცია"}},"nl":{"stringUnit":{"state":"translated","value":"Drie schermprojecties"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Três projeções de tela"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Três projeções de ecrã"}},"ru":{"stringUnit":{"state":"translated","value":"Три проекции экрана"}},"sr":{"stringUnit":{"state":"translated","value":"Tri projekcije na ekranu"}},"sv":{"stringUnit":{"state":"translated","value":"Tre skärmprojektioner"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"三屏投影"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"三螢幕投影"}}}},
    "Throttle": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Газ"}},"ca":{"stringUnit":{"state":"translated","value":"Accelerador"}},"cs":{"stringUnit":{"state":"translated","value":"Plyn"}},"de":{"stringUnit":{"state":"translated","value":"Gas"}},"es":{"stringUnit":{"state":"translated","value":"Acelerador"}},"fr":{"stringUnit":{"state":"translated","value":"Accélérateur"}},"hi":{"stringUnit":{"state":"translated","value":"एक्सीलेरेटर"}},"hu":{"stringUnit":{"state":"translated","value":"Gázpedál"}},"id":{"stringUnit":{"state":"translated","value":"Gas"}},"it":{"stringUnit":{"state":"translated","value":"Acceleratore"}},"ja":{"stringUnit":{"state":"translated","value":"アクセル"}},"ka":{"stringUnit":{"state":"translated","value":"აჩქარება"}},"kk":{"stringUnit":{"state":"translated","value":"Газ"}},"ko":{"stringUnit":{"state":"translated","value":"가속 페달"}},"ms":{"stringUnit":{"state":"translated","value":"Pemecut"}},"nl":{"stringUnit":{"state":"translated","value":"Gaspedaal"}},"pl":{"stringUnit":{"state":"translated","value":"Gaz"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Acelerador"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Acelerador"}},"ru":{"stringUnit":{"state":"translated","value":"Газ"}},"sr":{"stringUnit":{"state":"translated","value":"Gas"}},"sv":{"stringUnit":{"state":"translated","value":"Gas"}},"th":{"stringUnit":{"state":"translated","value":"คันเร่ง"}},"fil":{"stringUnit":{"state":"translated","value":"Silinyador"}},"tr":{"stringUnit":{"state":"translated","value":"Gaz"}},"uk":{"stringUnit":{"state":"translated","value":"Газ"}},"vi":{"stringUnit":{"state":"translated","value":"Ga"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"油门"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"油門"}}}},
    "Throttle (full, kickdown)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Газ (поўны, кікдаўн)"}},"ca":{"stringUnit":{"state":"translated","value":"Accelerador (a fons, kickdown)"}},"cs":{"stringUnit":{"state":"translated","value":"Plyn (naplno, kickdown)"}},"de":{"stringUnit":{"state":"translated","value":"Gas (voll, Kickdown)"}},"es":{"stringUnit":{"state":"translated","value":"Acelerador (a fondo, kickdown)"}},"fr":{"stringUnit":{"state":"translated","value":"Accélérateur (pied au plancher, kickdown)"}},"hi":{"stringUnit":{"state":"translated","value":"एक्सीलेरेटर (फ़ुल, किकडाउन)"}},"hu":{"stringUnit":{"state":"translated","value":"Padlógáz (kickdown)"}},"id":{"stringUnit":{"state":"translated","value":"Gas penuh (kickdown)"}},"it":{"stringUnit":{"state":"translated","value":"Acceleratore (a fondo, kickdown)"}},"ja":{"stringUnit":{"state":"translated","value":"アクセル(全開、キックダウン)"}},"ka":{"stringUnit":{"state":"translated","value":"აჩქარება (სრული, kickdown)"}},"kk":{"stringUnit":{"state":"translated","value":"Газ (толық, kickdown)"}},"ko":{"stringUnit":{"state":"translated","value":"가속 페달 (최대 / 킥다운)"}},"ms":{"stringUnit":{"state":"translated","value":"Pemecut penuh (kickdown)"}},"nl":{"stringUnit":{"state":"translated","value":"Gas (vol, kickdown)"}},"pl":{"stringUnit":{"state":"translated","value":"Gaz (pełny, kickdown)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Acelerador (a fundo, kickdown)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Acelerador (a fundo, kickdown)"}},"ru":{"stringUnit":{"state":"translated","value":"Газ (полный, кикдаун)"}},"sr":{"stringUnit":{"state":"translated","value":"Gas (pun, kickdovn)"}},"sv":{"stringUnit":{"state":"translated","value":"Fullgas (kickdown)"}},"th":{"stringUnit":{"state":"translated","value":"คันเร่งสุด (คิกดาวน์)"}},"fil":{"stringUnit":{"state":"translated","value":"Silinyador sagad (kickdown)"}},"tr":{"stringUnit":{"state":"translated","value":"Gaz (tam, kickdown)"}},"uk":{"stringUnit":{"state":"translated","value":"Газ (повний, кікдаун)"}},"vi":{"stringUnit":{"state":"translated","value":"Ga hết cỡ (kickdown)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"油门(全开,强制降档)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"油門（全油門／Kickdown）"}}}},
    "Throttle pedal strength": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Сіла педалі газу"}},"ca":{"stringUnit":{"state":"translated","value":"Força del pedal de l'accelerador"}},"cs":{"stringUnit":{"state":"translated","value":"Síla plynového pedálu"}},"de":{"stringUnit":{"state":"translated","value":"Gaspedalstärke"}},"es":{"stringUnit":{"state":"translated","value":"Fuerza del pedal del acelerador"}},"fr":{"stringUnit":{"state":"translated","value":"Force de la pédale d'accélérateur"}},"hi":{"stringUnit":{"state":"translated","value":"एक्सीलेरेटर पैडल की ताकत"}},"hu":{"stringUnit":{"state":"translated","value":"Gázpedál erőssége"}},"id":{"stringUnit":{"state":"translated","value":"Kekuatan pedal gas"}},"it":{"stringUnit":{"state":"translated","value":"Forza del pedale dell'acceleratore"}},"ja":{"stringUnit":{"state":"translated","value":"アクセルペダルの強さ"}},"ka":{"stringUnit":{"state":"translated","value":"აჩქარების პედლის ძალა"}},"kk":{"stringUnit":{"state":"translated","value":"Газ педалінің күші"}},"ko":{"stringUnit":{"state":"translated","value":"가속 페달 강도"}},"ms":{"stringUnit":{"state":"translated","value":"Kekuatan pedal pemecut"}},"nl":{"stringUnit":{"state":"translated","value":"Kracht van het gaspedaal"}},"pl":{"stringUnit":{"state":"translated","value":"Siła pedału gazu"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Força do pedal do acelerador"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Força do pedal do acelerador"}},"ru":{"stringUnit":{"state":"translated","value":"Сила педали газа"}},"sr":{"stringUnit":{"state":"translated","value":"Snaga pedale gasa"}},"sv":{"stringUnit":{"state":"translated","value":"Gaspedalens styrka"}},"th":{"stringUnit":{"state":"translated","value":"ความแรงของคันเร่ง"}},"fil":{"stringUnit":{"state":"translated","value":"Lakas ng silinyador"}},"tr":{"stringUnit":{"state":"translated","value":"Gaz pedalı gücü"}},"uk":{"stringUnit":{"state":"translated","value":"Сила педалі газу"}},"vi":{"stringUnit":{"state":"translated","value":"Độ mạnh bàn đạp ga"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"油门踏板力度"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"油門踏板力道"}}}},
    "Tickets": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Bitllets"}},"de":{"stringUnit":{"state":"translated","value":"Fahrkarten"}},"es":{"stringUnit":{"state":"translated","value":"Billetes"}},"fr":{"stringUnit":{"state":"translated","value":"Billets"}},"ka":{"stringUnit":{"state":"translated","value":"ბილეთები"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Passagens"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Bilhetes"}},"ru":{"stringUnit":{"state":"translated","value":"Билеты"}},"sr":{"stringUnit":{"state":"translated","value":"Ulaznice"}},"sv":{"stringUnit":{"state":"translated","value":"Biljetter"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"車票"}}}},
    "Tilt steering is switched in the game (the steering wheel button). A game controller (Xbox, PlayStation, MFi) works as soon as it is connected.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Рулённе нахілам пераключаецца ў гульні (кнопка з рулём). Гульнявы кантролер (Xbox, PlayStation, MFi) працуе адразу пасля падключэння."}},"ca":{"stringUnit":{"state":"translated","value":"La direcció per inclinació s'activa al joc (botó del volant). Un comandament (Xbox, PlayStation, MFi) funciona tan bon punt es connecta."}},"cs":{"stringUnit":{"state":"translated","value":"Řízení náklonem se přepíná ve hře (tlačítko volantu). Herní ovladač (Xbox, PlayStation, MFi) funguje hned po připojení."}},"de":{"stringUnit":{"state":"translated","value":"Die Neigungslenkung wird im Spiel umgeschaltet (Lenkrad-Taste). Ein Gamecontroller (Xbox, PlayStation, MFi) funktioniert, sobald er verbunden ist."}},"es":{"stringUnit":{"state":"translated","value":"La dirección por inclinación se activa en el juego (botón del volante). Un mando (Xbox, PlayStation, MFi) funciona en cuanto se conecta."}},"fr":{"stringUnit":{"state":"translated","value":"La direction par inclinaison s'active dans le jeu (bouton du volant). Une manette (Xbox, PlayStation, MFi) fonctionne dès qu'elle est connectée."}},"hi":{"stringUnit":{"state":"translated","value":"झुकाकर स्टीयरिंग गेम में चालू/बंद होती है (स्टीयरिंग व्हील बटन)। गेम कंट्रोलर (Xbox, PlayStation, MFi) जुड़ते ही काम करता है।"}},"hu":{"stringUnit":{"state":"translated","value":"A döntéses kormányzást a játékban lehet kapcsolni (a kormány gomb). A kontroller (Xbox, PlayStation, MFi) csatlakoztatás után azonnal működik."}},"id":{"stringUnit":{"state":"translated","value":"Kemudi miring diaktifkan di dalam game (tombol setir). Kontroler game (Xbox, PlayStation, MFi) langsung berfungsi begitu tersambung."}},"it":{"stringUnit":{"state":"translated","value":"Lo sterzo a inclinazione si attiva nel gioco (il pulsante del volante). Un controller (Xbox, PlayStation, MFi) funziona appena viene collegato."}},"ja":{"stringUnit":{"state":"translated","value":"傾きステアリングはゲーム内 (ハンドルボタン) で切り替えます。ゲームコントローラー (Xbox、PlayStation、MFi) は接続するとすぐに使えます。"}},"ka":{"stringUnit":{"state":"translated","value":"დახრით მართვა თამაშში ირთვება (საჭის ღილაკით). თამაშის კონტროლერი (Xbox, PlayStation, MFi) მუშაობს დაკავშირებისთანავე."}},"kk":{"stringUnit":{"state":"translated","value":"Еңкейтіп басқару ойында ауыстырылады (рөл түймесі). Ойын контроллері (Xbox, PlayStation, MFi) қосылған бойда жұмыс істейді."}},"ko":{"stringUnit":{"state":"translated","value":"기울기 조향은 게임 안에서 전환합니다 (핸들 버튼). 게임 컨트롤러 (Xbox, PlayStation, MFi)는 연결하는 즉시 작동합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Stereng condong dihidupkan dalam permainan (butang stereng). Pengawal permainan (Xbox, PlayStation, MFi) berfungsi sebaik sahaja disambungkan."}},"nl":{"stringUnit":{"state":"translated","value":"Sturen door kantelen zet je aan in het spel (de stuurwielknop). Een gamecontroller (Xbox, PlayStation, MFi) werkt zodra hij is verbonden."}},"pl":{"stringUnit":{"state":"translated","value":"Sterowanie przechylaniem włącza się w grze (przycisk kierownicy). Kontroler (Xbox, PlayStation, MFi) działa od razu po podłączeniu."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A direção por inclinação é ativada no jogo (o botão do volante). Um controle de jogo (Xbox, PlayStation, MFi) funciona assim que é conectado."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A direção por inclinação é ativada no jogo (o botão do volante). Um comando de jogo (Xbox, PlayStation, MFi) funciona assim que é ligado."}},"ru":{"stringUnit":{"state":"translated","value":"Руление наклоном включается в игре (кнопка с рулём). Игровой контроллер (Xbox, PlayStation, MFi) работает сразу после подключения."}},"sr":{"stringUnit":{"state":"translated","value":"Upravljanje naginjanjem se uključuje u igri (dugme volana). Kontroler (Xbox, PlayStation, MFi) radi čim se poveže."}},"sv":{"stringUnit":{"state":"translated","value":"Lutningsstyrning slås på i spelet (rattknappen). En spelkontroll (Xbox, PlayStation, MFi) fungerar så snart den är ansluten."}},"th":{"stringUnit":{"state":"translated","value":"การบังคับเลี้ยวด้วยการเอียงเปิดปิดได้ในเกม (ปุ่มพวงมาลัย) คอนโทรลเลอร์ (Xbox, PlayStation, MFi) ใช้งานได้ทันทีที่เชื่อมต่อ"}},"fil":{"stringUnit":{"state":"translated","value":"Ang tilt steering ay binubuksan sa loob ng laro (ang button ng manibela). Gumagana agad ang game controller (Xbox, PlayStation, MFi) kapag nakakonekta na."}},"tr":{"stringUnit":{"state":"translated","value":"Eğerek direksiyon oyun içinde açılıp kapatılır (direksiyon düğmesi). Bir oyun kumandası (Xbox, PlayStation, MFi) bağlanır bağlanmaz çalışır."}},"uk":{"stringUnit":{"state":"translated","value":"Кермування нахилом вмикається в грі (кнопка з кермом). Ігровий контролер (Xbox, PlayStation, MFi) працює одразу після підключення."}},"vi":{"stringUnit":{"state":"translated","value":"Lái bằng cách nghiêng được bật trong trò chơi (nút vô lăng). Tay cầm chơi game (Xbox, PlayStation, MFi) hoạt động ngay khi được kết nối."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"倾斜转向在游戏内切换（方向盘按钮）。游戏控制器（Xbox、PlayStation、MFi）一连接即可使用。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"傾斜轉向在遊戲內切換（方向盤按鈕）。遊戲控制器（Xbox、PlayStation、MFi）一連接即可使用。"}}}},
