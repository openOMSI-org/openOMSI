    "Other players' names above their buses": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Імёны іншых гульцоў над іх аўтобусамі"}},"ca":{"stringUnit":{"state":"translated","value":"Noms dels altres jugadors sobre els seus autobusos"}},"cs":{"stringUnit":{"state":"translated","value":"Jména ostatních hráčů nad jejich autobusy"}},"de":{"stringUnit":{"state":"translated","value":"Namen anderer Spieler über ihren Bussen"}},"es":{"stringUnit":{"state":"translated","value":"Nombres de otros jugadores sobre sus autobuses"}},"fr":{"stringUnit":{"state":"translated","value":"Noms des autres joueurs au-dessus de leurs bus"}},"hi":{"stringUnit":{"state":"translated","value":"दूसरे खिलाड़ियों के नाम उनकी बसों के ऊपर"}},"hu":{"stringUnit":{"state":"translated","value":"A többi játékos felhasználóneve a buszuk felett"}},"id":{"stringUnit":{"state":"translated","value":"Tampilkan nama pemain lain di atas bus"}},"it":{"stringUnit":{"state":"translated","value":"Nomi degli altri giocatori sopra i loro bus"}},"ja":{"stringUnit":{"state":"translated","value":"他のプレイヤーの名前をバスの上に表示"}},"ka":{"stringUnit":{"state":"translated","value":"სხვა მოთამაშეების სახელები მათი ავტობუსების ზემოთ"}},"kk":{"stringUnit":{"state":"translated","value":"Басқа ойыншылардың аттары автобустарының үстінде"}},"ko":{"stringUnit":{"state":"translated","value":"다른 플레이어 버스 위에 이름 표시"}},"ms":{"stringUnit":{"state":"translated","value":"Papar nama pemain lain di atas bas"}},"nl":{"stringUnit":{"state":"translated","value":"Namen van andere spelers boven hun bussen"}},"pl":{"stringUnit":{"state":"translated","value":"Nazwy innych graczy nad ich autobusami"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nomes de outros jogadores sobre seus ônibus"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nomes dos outros jogadores por cima dos seus autocarros"}},"ru":{"stringUnit":{"state":"translated","value":"Имена игроков над их автобусами"}},"sr":{"stringUnit":{"state":"translated","value