    "No runs yet. Drive a duty and it shows up here.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Паездак яшчэ няма. Праедзьце наряд, і ён з'явіцца тут."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha serveis. Fes-ne un i apareixerà aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné jízdy. Odjeďte službu a objeví se tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Fahrten. Fahre einen Dienst, dann erscheint er hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay recorridos. Conduce un servicio y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun service pour l'instant. Faites un service et il apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई रन नहीं। कोई ड्यूटी चलाएँ, वह यहाँ दिखेगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs korábbi menet. Teljesíts egy szolgálatot, és itt megjelenik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perjalanan. Jalankan satu tugas untuk melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna corsa. Guida un turno e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運行記録はまだありません。乗務を運転するとここに表示されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге рейстер жоқ. Нарядпен жүріңіз, ол осында пайда болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 운행 기록이 없습니다. 근무를 완료하면 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perjalanan. Pandu satu tugas untuk melihatnya di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen ritten. Rijd een dienst en die verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak przejazdów. Odbądź służbę, a pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há viagens. Faça uma escala e ela aparecerá aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há viagens. Faça uma escala e ela aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездок пока нет. Отработайте смену - она появится здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีประวัติการขับรถ เริ่มหน้าที่แล้วข้อมูลจะปรากฏที่นี่"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang biyahe. Magmaneho ng isang duty para lumitaw rito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sefer yok. Bir görev sürün, burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поїздок ще немає. Проїдьте наряд, і він з'явиться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
