    "Automatic: the screen's refresh rate, at most 100 fps": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Аўтаматычна: частата абнаўлення экрана, не больш за 100 fps"}},"ca":{"stringUnit":{"state":"translated","value":"Automàtic: la freqüència de refresc de la pantalla, com a màxim 100 fps"}},"cs":{"stringUnit":{"state":"translated","value":"Automaticky: obnovovací frekvence obrazovky, nejvýše 100 fps"}},"de":{"stringUnit":{"state":"translated","value":"Automatisch: die Bildwiederholrate des Bildschirms, höchstens 100 fps"}},"es":{"stringUnit":{"state":"translated","value":"Automática: la frecuencia de actualización de la pantalla, como máximo 100 fps"}},"fr":{"stringUnit":{"state":"translated","value":"Automatique : la fréquence de rafraîchissement de l'écran, 100 fps au plus"}},"hi":{"stringUnit":{"state":"translated","value":"ऑटोमैटिक: स्क्रीन का रिफ़्रेश रेट, अधिकतम 100 fps"}},"hu":{"stringUnit":{"state":"translated","value":"Automatikus: a képernyő frissítési frekvenciája, legfeljebb 100 fps"}},"id":{"stringUnit":{"state":"translated","value":"Otomatis: refresh rate layar, paling tinggi 100 fps"}},"it":{"stringUnit":{"state":"translated","value":"Automatica: la frequenza di aggiornamento dello schermo, al massimo 100 fps"}},"ja":{"stringUnit":{"state":"translated","value":"自動：画面のリフレッシュレート（最大 100 fps）"}},"ka":{"stringUnit":{"state":"translated","value":"ავტომატური: ეკრანის განახლების სიხშირე, მაქსიმუმ 100 fps"}},"kk":{"stringUnit":{"state":"translated","value":"Автоматты: экранның жаңару жиілігі, ең көбі 100 fps"}},"ko":{"stringUnit":{"state":"translated","value":"자동: 화면 주사율, 최대 100 fps"}},"ms":{"stringUnit":{"state":"translated","value":"Automatik: kadar segar semula skrin, paling tinggi 100 fps"}},"nl":{"stringUnit":{"state":"translated","value":"Automatisch: de verversingssnelheid van het scherm, hooguit 100 fps"}},"pl":{"stringUnit":{"state":"translated","value":"Automatycznie: częstotliwość odświeżania ekranu, najwyżej 100 fps"}},"pt-