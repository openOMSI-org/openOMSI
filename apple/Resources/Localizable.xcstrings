    "Precision mouse zoom (FOV curve instead of the linear way)": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Zoom precís amb el ratolí (corba del camp de visió en lloc de resposta lineal)"}},"de":{"stringUnit":{"state":"translated","value":"Präziser Maus-Zoom (FOV-Kurve anstatt linearer Kurve)"}},"es":{"stringUnit":{"state":"translated","value":"Zoom preciso con el ratón (curva del campo de visión en vez de respuesta lineal)"}},"fr":{"stringUnit":{"state":"translated","value":"Zoom précis à la souris (courbe du champ de vision au lieu du mode linéaire)"}},"ka":{"stringUnit":{"state":"translated","value":"მაუსის ზუსტი მასშტაბირება (ხედვის ველის მრუდი წრფივის ნაცვლად)"}},"nl":{"stringUnit":{"state":"translated","value":"Nauwkeurig zoomen met de muis (FOV-curve in plaats van lineair)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Zoom preciso com o mouse (curva de FOV em vez do modo linear)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Zoom preciso com o rato (curva de FOV em vez do modo linear)"}},"ru":{"stringUnit":{"state":"translated","value":"Точное масштабирование мышью (кривая угла обзора вместо линейной)"}},"sr":{"stringUnit":{"state":"translated","value":"Precizno zumiranje mišem (FOV kriva umesto linearnog odziva)"}},"sv":{"stringUnit":{"state":"translated","value":"Precisionszoom med musen (synfältskurva i stället för linjär zoom)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"精确鼠标缩放（使用 FOV 曲线，而非线性方式）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"精確滑鼠縮放（使用 FOV 曲線，而非線性方式）"}}}},
    "Press \"Reset timetable\" again to put the map's own timetable back (the changes made here are lost)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Націсніце «Скінуць расклад» яшчэ раз, каб вярнуць уласны расклад мапы (зробленыя тут змены будуць страчаныя)"}},"ca":{"stringUnit":{"state":"translated","value":"Torna a prémer «Restableix l'horari» per recuperar l'horari original del mapa (es perdran els canvis fets aquí)"}},"cs":{"stringUnit":{"state":"translated","value":"Stiskněte znovu „Resetovat jízdní řád“ a vrátí se vlastní jízdní řád mapy (zde provedené změny se ztratí)"}},"de":{"stringUnit":{"state":"translated","value":"Drücke erneut auf „Fahrplan zurücksetzen“, um den eigenen Fahrplan der Karte wiederherzustellen (die hier gemachten Änderungen gehen verloren)"}},"es":{"stringUnit":{"state":"translated","value":"Pulsa de nuevo «Restablecer horario» para volver al horario propio del mapa (se pierden los cambios hechos aquí)"}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez de nouveau sur « Réinitialiser l'horaire » pour remettre l'horaire de la carte (les modifications faites ici sont perdues)"}},"hi":{"stringUnit":{"state":"translated","value":"मैप का अपना टाइमटेबल वापस लाने के लिए \"टाइमटेबल रीसेट करें\" फिर से दबाएँ (यहाँ किए गए बदलाव खो जाएँगे)"}},"hu":{"stringUnit":{"state":"translated","value":"Nyomd meg újra a „Menetrend visszaállítása” gombot, hogy visszakerüljön a térkép saját menetrendje (az itt végzett módosítások elvesznek)"}},"id":{"stringUnit":{"state":"translated","value":"Tekan \"Atur ulang jadwal\" lagi untuk mengembalikan jadwal asli peta (perubahan yang dibuat di sini akan hilang)"}},"it":{"stringUnit":{"state":"translated","value":"Premi di nuovo «Reimposta orario» per riavere l'orario originale della mappa (le modifiche fatte qui vanno perse)"}},"ja":{"stringUnit":{"state":"translated","value":"もう一度「時刻表をリセット」を押すと、マップ本来の時刻表に戻ります(ここで行った変更は失われます)"}},"ka":{"stringUnit":{"state":"translated","value":"ხელახლა დააჭირეთ „განრიგის აღდგენას“ რუკის საკუთარი განრიგის დასაბრუნებლად (აქ შეტანილი ცვლილებები დაიკარგება)"}},"kk":{"stringUnit":{"state":"translated","value":"Картаның өз кестесін қайтару үшін «Кестені қалпына келтіру» түймесін қайта басыңыз (мұнда жасалған өзгерістер жоғалады)"}},"ko":{"stringUnit":{"state":"translated","value":"\"시간표 초기화\"를 다시 누르면 지도 원래의 시간표로 돌아갑니다(여기서 한 변경 사항은 사라집니다)"}},"ms":{"stringUnit":{"state":"translated","value":"Tekan \"Tetapkan semula jadual\" sekali lagi untuk mengembalikan jadual asal peta (perubahan yang dibuat di sini akan hilang)"}},"nl":{"stringUnit":{"state":"translated","value":"Klik opnieuw op 'Dienstregeling herstellen' om de oorspronkelijke dienstregeling van de kaart terug te zetten (de wijzigingen hier gaan verloren)"}},"pl":{"stringUnit":{"state":"translated","value":"Kliknij ponownie „Zresetuj rozkład”, aby przywrócić własny rozkład mapy (zmiany wprowadzone tutaj zostaną utracone)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pressione \"Redefinir tabela horária\" novamente para restaurar a tabela horária original do mapa (as alterações feitas aqui serão perdidas)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Prima \"Redefinir horário\" novamente para restaurar o horário original do mapa (as alterações feitas aqui serão perdidas)"}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите «Сбросить расписание» ещё раз, чтобы вернуть собственное расписание карты (сделанные здесь изменения будут потеряны)"}},"sr":{"stringUnit":{"state":"translated","value":"Ponovo pritisnite „Resetuj raspored“ da vratite sopstveni raspored mape (promene napravljene ovde su izgubljene)"}},"sv":{"stringUnit":{"state":"translated","value":"Tryck på ”Återställ tidtabellen” igen för att få tillbaka kartans egen tidtabell (ändringarna som gjorts här går förlorade)"}},"th":{"stringUnit":{"state":"translated","value":"กด \"รีเซ็ตตารางเวลา\" อีกครั้งเพื่อคืนตารางเวลาเดิมของแผนที่ (การเปลี่ยนแปลงที่ทำไว้ที่นี่จะหายไป)"}},"fil":{"stringUnit":{"state":"translated","value":"Pindutin ulit ang \"I-reset ang iskedyul\" para ibalik ang sariling iskedyul ng mapa (mawawala ang mga pagbabagong ginawa rito)"}},"tr":{"stringUnit":{"state":"translated","value":"Haritanın kendi tarifesini geri getirmek için \"Tarifeyi sıfırla\"ya tekrar basın (burada yapılan değişiklikler kaybolur)"}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть «Скинути розклад» ще раз, щоб повернути власний розклад мапи (зроблені тут зміни буде втрачено)"}},"vi":{"stringUnit":{"state":"translated","value":"Nhấn \"Đặt lại thời gian biểu\" lần nữa để khôi phục thời gian biểu gốc của bản đồ (các thay đổi đã làm ở đây sẽ mất)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"再次按“重置时刻表”以恢复地图自己的时刻表（此处的更改将丢失）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"再次按下「重設時刻表」以恢復地圖自己的時刻表（此處所做的變更將會遺失）"}}}},
    "Press again to reset": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Націсніце яшчэ раз для скіду"}},"ca":{"stringUnit":{"state":"translated","value":"Torna a prémer per restablir"}},"cs":{"stringUnit":{"state":"translated","value":"Stiskněte znovu pro reset"}},"de":{"stringUnit":{"state":"translated","value":"Zum Zurücksetzen erneut drücken"}},"es":{"stringUnit":{"state":"translated","value":"Pulsa de nuevo para restablecer"}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez encore pour réinitialiser"}},"hi":{"stringUnit":{"state":"translated","value":"रीसेट के लिए फिर दबाएँ"}},"hu":{"stringUnit":{"state":"translated","value":"Nyomd meg újra a visszaállításhoz"}},"id":{"stringUnit":{"state":"translated","value":"Tekan lagi untuk mengatur ulang"}},"it":{"stringUnit":{"state":"translated","value":"Premi di nuovo per reimpostare"}},"ja":{"stringUnit":{"state":"translated","value":"もう一度押すとリセット"}},"ka":{"stringUnit":{"state":"translated","value":"დააჭირეთ ხელახლა აღსადგენად"}},"kk":{"stringUnit":{"state":"translated","value":"Қалпына келтіру үшін қайта басыңыз"}},"ko":{"stringUnit":{"state":"translated","value":"다시 누르면 초기화됩니다"}},"ms":{"stringUnit":{"state":"translated","value":"Tekan sekali lagi untuk menetapkan semula"}},"nl":{"stringUnit":{"state":"translated","value":"Druk nogmaals om te resetten"}},"pl":{"stringUnit":{"state":"translated","value":"Kliknij ponownie, aby zresetować"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pressione de novo para redefinir"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Prima de novo para redefinir"}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите ещё раз для сброса"}},"sr":{"stringUnit":{"state":"translated","value":"Pritisnite ponovo za resetovanje"}},"sv":{"stringUnit":{"state":"translated","value":"Tryck igen för att återställa"}},"th":{"stringUnit":{"state":"translated","value":"กดอีกครั้งเพื่อรีเซ็ต"}},"fil":{"stringUnit":{"state":"translated","value":"Pindutin 