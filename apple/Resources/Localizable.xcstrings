    "Getting ready for friends on the internet...": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Падрыхтоўка да гульні з сябрамі праз інтэрнэт..."}},"ca":{"stringUnit":{"state":"translated","value":"Preparant la connexió amb amics per internet..."}},"cs":{"stringUnit":{"state":"translated","value":"Příprava pro kamarády na internetu..."}},"de":{"stringUnit":{"state":"translated","value":"Vorbereitung für Freunde im Internet..."}},"es":{"stringUnit":{"state":"translated","value":"Preparándose para amigos en internet..."}},"fr":{"stringUnit":{"state":"translated","value":"Préparation pour les amis sur Internet..."}},"hi":{"stringUnit":{"state":"translated","value":"इंटरनेट पर दोस्तों के लिए तैयारी हो रही है..."}},"hu":{"stringUnit":{"state":"translated","value":"Felkészülés az interneten lévő barátokra..."}},"id":{"stringUnit":{"state":"translated","value":"Menyiapkan koneksi internet..."}},"it":{"stringUnit":{"state":"translated","value":"Preparazione per gli amici su internet..."}},"ja":{"stringUnit":{"state":"translated","value":"インターネット上の友達のために準備中..."}},"ka":{"stringUnit":{"state":"translated","value":"მზადება ინტერნეტით მეგობრებისთვის..."}},"kk":{"stringUnit":{"state":"translated","value":"Интернеттегі достарға дайындалуда..."}},"ko":{"stringUnit":{"state":"translated","value":"인터넷 연결 준비 중..."}},"ms":{"stringUnit":{"state":"translated","value":"Menyediakan sambungan internet..."}},"nl":{"stringUnit":{"state":"translated","value":"Voorbereiden voor vrienden op internet..."}},"pl":{"stringUnit":{"state":"translated","value":"Przygotowywanie dla znajomych w internecie..."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Preparando para amigos na internet..."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Preparando para amigos na internet..."}},"ru":{"stringUnit":{"state":"translated","value":"Подготовка к подключению друзей через интернет..."}},"sr":{"stringUnit":{"state":"translated","value":"Spremamo se za prijatelje na internetu..."}},"sv":{"stringUnit":{"state":"translated","value":"Förbereder för vänner på internet..."}},"th":{"stringUnit":{"state":"translated","value":"กำลังเตรียมการเชื่อมต่ออินเทอร์เน็ต..."}},"fil":{"stringUnit":{"state":"translated","value":"Inihahanda ang internet connection..."}},"tr":{"stringUnit":{"state":"translated","value":"İnternetteki arkadaşlar için hazırlanılıyor..."}},"uk":{"stringUnit":{"state":"translated","value":"Підготовка до гри з друзями через інтернет..."}},"vi":{"stringUnit":{"state":"translated","value":"Đang chuẩn bị kết nối Internet..."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在为互联网上的朋友做准备..."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在準備互聯網連線..."}}}},
    "Good": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Добрае"}},"ca":{"stringUnit":{"state":"translated","value":"Bo"}},"cs":{"stringUnit":{"state":"translated","value":"Dobrá"}},"de":{"stringUnit":{"state":"translated","value":"Gut"}},"es":{"stringUnit":{"state":"translated","value":"Bueno"}},"fr":{"stringUnit":{"state":"translated","value":"Bon"}},"hi":{"stringUnit":{"state":"translated","value":"अच्छा"}},"hu":{"stringUnit":{"state":"translated","value":"Jó"}},"id":{"stringUnit":{"state":"translated","value":"Baik"}},"it":{"stringUnit":{"state":"translated","value":"Buona"}},"ja":{"stringUnit":{"state":"translated","value":"良い"}},"ka":{"stringUnit":{"state":"translated","value":"კარგი"}},"kk":{"stringUnit":{"state":"translated","value":"Жақсы"}},"ko":{"stringUnit":{"state":"translated","value":"좋음"}},"ms":{"stringUnit":{"state":"translated","value":"Baik"}},"nl":{"stringUnit":{"state":"translated","value":"Goed"}},"pl":{"stringUnit":{"state":"translated","value":"Dobra"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Bom"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Bom"}},"ru":{"stringUnit":{"state":"translated","value":"Хорошее"}},"sr":{"stringUnit":{"state":"translated","value":"Dobro"}},"sv":{"stringUnit":{"state":"translated","value":"Bra"}},"th":{"stringUnit":{"state":"translated","value":"ดี"}},"fil":{"stringUnit":{"state":"translated","value":"Maganda"}},"tr":{"stringUnit":{"state":"translated","value":"İyi"}},"uk":{"stringUnit":{"state":"translated","value":"Добре"}},"vi":{"stringUnit":{"state":"translated","value":"Tốt"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"良好"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"良好"}}}},
    "Graphics": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Графіка"}},"ca":{"stringUnit":{"state":"translated","value":"Gràfics"}},"cs":{"stringUnit":{"state":"translated","value":"Grafika"}},"de":{"stringUnit":{"state":"translated","value":"Grafik"}},"es":{"stringUnit":{"state":"translated","value":"Gráficos"}},"fr":{"stringUnit":{"state":"translated","value":"Graphismes"}},"hi":{"stringUnit":{"state":"translated","value":"ग्राफ़िक्स"}},"hu":{"stringUnit":{"state":"translated","value":"Grafika"}},"id":{"stringUnit":{"state":"translated","value":"Grafis"}},"it":{"stringUnit":{"state":"translated","value":"Grafica"}},"ja":{"stringUnit":{"state":"translated","value":"グラフィックス"}},"ka":{"stringUnit":{"state":"translated","value":"გრაფიკა"}},"kk":{"stringUnit":{"state":"translated","value":"Графика"}},"ko":{"stringUnit":{"state":"translated","value":"그래픽"}},"ms":{"stringUnit":{"state":"translated","value":"Grafik"}},"nl":{"stringUnit":{"state":"translated","value":"Beeld"}},"pl":{"stringUnit":{"state":"translated","value":"Grafika"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gráficos"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Gráficos"}},"ru":{"stringUnit":{"state":"translated","value":"Графика"}},"sr":{"stringUnit":{"state":"translated","value":"Grafika"}},"sv":{"stringUnit":{"state":"translated","value":"Grafik"}},"th":{"stringUnit":{"state":"translated","value":"กราฟิก"}},"fil":{"stringUnit":{"state":"translated","value":"Graphics"}},"tr":{"stringUnit":{"state":"translated","value":"Grafik"}},"uk":{"stringUnit":{"state":"translated","value":"Графіка"}},"vi":{"stringUnit":{"state":"translated","value":"Đồ họa"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"图形"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"圖像"}}}},
    "Graphics, sound, controllers and game settings go back to how they came. The language, the drivers, the key bindings and the game folder stay.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Графіка, гук, кантролеры і налады гульні вяртаюцца да пачатковых. Мова, вадзіцелі, прывязкі клавіш і тэчка гульні застаюцца."}},"ca":{"stringUnit":{"state":"translated","value":"Els gràfics, el so, els dispositius i els ajustos del joc tornen als valors originals. Es mantenen l'idioma, els conductors, les assignacions de tecles i la carpeta del joc."}},"cs":{"stringUnit":{"state":"translated","value":"Grafika, zvuk, ovladače a nastavení hry se vrátí do původního stavu. Jazyk, řidiči, klávesové zkratky a složka hry zůstanou."}},"de":{"stringUnit":{"state":"translated","value":"Grafik, Ton, Controller und Spieleinstellungen werden auf den Ausgangszustand zurückgesetzt. Sprache, Fahrer, Tastenbelegung und Spielordner bleiben erhalten."}},"es":{"stringUnit":{"state":"translated","value":"Los gráficos, el sonido, los mandos y los ajustes del juego vuelven a como venían. El idioma, los conductores, las teclas y la carpeta del juego se conservan."}},"fr":{"stringUnit":{"state":"translated","value":"Les réglages graphiques, sonores, des manettes et du jeu reviennent à leur état d'origine. La langue, les conducteurs, les touches et le dossier du jeu sont conservés."}},"hi":{"stringUnit":{"state":"translated","value":"ग्राफ़िक्स, साउंड, कंट्रोलर और गेम सेटिंग्स पहले जैसी हो जाएँगी। भाषा, ड्राइवर, की बाइंडिंग और गेम फ़ोल्डर बने रहेंगे।"}},"hu":{"stringUnit":{"state":"translated","value":"A grafika, a hang, a vezérlők és a játékbeállítások visszaállnak az eredetire. A nyelv, a sofőrök, a billentyűkiosztás és a játékmappa megmarad."}},"it":{"stringUnit":{"state":"translated","value":"Grafica, audio, controller e impostazioni di gioco tornano come all'origine. Restano lingua, conducenti, tasti e cartella del gioco."}},"ja":{"stringUnit":{"state":"translated","value":"グラフィックス、サウンド、コントローラー、ゲーム設定を初期状態に戻します。言語、運転手、キー割り当て、ゲームフォルダはそのままです。"}},"ka":{"stringUnit":{"state":"translated","value":"გრაფიკის, ხმის, კონტროლერებისა და თამაშის პარამეტრები საწყის მდგომარეობას უბრუნდება. ენა, მძღოლები, კლავიშების მინიჭება და თამაშის საქაღალდე რჩება."}},"kk":{"stringUnit":{"state":"translated","value":"Графика, дыбыс, контроллерлер және ойын баптаулары бастапқы күйіне қайтады. Тіл, жүргізушілер, перне тағайындаулары және ойын қалтасы қалады."}},"nl":{"stringUnit":{"state":"translated","value":"Beeld, geluid, controllers en spelinstellingen worden teruggezet. Taal, bestuurders, toetsen en de spelmap blijven behouden."}},"pl":{"stringUnit":{"state":"translated","value":"Grafika, dźwięk, kontrolery i ustawienia gry wracają do stanu początkowego. Język, kierowcy, przypisania klawiszy i folder gry zostają."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Gráficos, som, controles e configurações do jogo voltam ao original. O idioma, os motoristas, as teclas e a pasta do jogo são mantidos."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Gráficos, som, controlos e definições do jogo voltam ao original. O idioma, os condutores, as teclas e a pasta do jogo são mantidos."}},"ru":{"stringUnit":{"state":"translated","value":"Настройки графики, звука, контроллеров и игры вернутся к исходным. Язык, водители, назначения клавиш и папка игры сохранятся."}},"sr":{"stringUnit":{"state":"translated","value":"Grafika, zvuk, kontroleri i podešavanja igre se vraćaju na ono kako su nastali. Jezik, drajveri, veze tastera i fascikla igre ostaju."}},"sv":{"stringUnit":{"state":"translated","value":"Grafik, ljud, kontroller och spelinställningar återställs till sina ursprungliga värden. Språk, förare, tangentbindningar och spelmapp behålls."}},"tr":{"stringUnit":{"state":"translated","value":"Grafik, ses, kumanda ve oyun ayarları ilk haline döner. Dil, sürücüler, tuş atamaları ve oyun klasörü korunur."}},"uk":{"stringUnit":{"state":"translated","value":"Графіка, звук, контролери й налаштування гри повертаються до початкових. Мова, водії, прив'язки клавіш і тека гри залишаються."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"图形、声音、控制器和游戏设置将恢复为初始状态。语言、司机、按键绑定和游戏文件夹保持不变。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"圖形、音效、控制器及遊戲設定將恢復為初始設定。語言、司機資料、按鍵綁定及遊戲資料夾將會保留。"}}}},
    "Greetings and tickets": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Прывітанні і білеты"}},"ca":{"stringUnit":{"state":"translated","value":"Salutacions i bitllets"}},"cs":{"stringUnit":{"state":"translated","value":"Pozdravy a jízdenky"}},"de":{"stringUnit":{"state":"translated","value":"Grüße und Fahrscheine"}},"es":{"stringUnit":{"state":"translated","value":"Saludos y billetes"}},"fr":{"stringUnit":{"state":"translated","value":"Salutations et billets"}},"hi":{"stringUnit":{"state":"translated","value":"अभिवादन और टिकट"}},"hu":{"stringUnit":{"state":"translated","value":"Üdvözléskor és jegyeladáskor"}},"id":{"stringUnit":{"state":"translated","value":"Sapaan dan tiket"}},"it":{"stringUnit":{"state":"translated","value":"Saluti e biglietti"}},"ja":{"stringUnit":{"state":"translated","value":"挨拶と乗車券"}},"ka":{"stringUnit":{"state":"translated","value":"მისალმებები და ბილეთები"}},"kk":{"stringUnit":{"state":"translated","value":"Сәлемдесу және билеттер"}},"ko":{"stringUnit":{"state":"translated","value":"인사와 승차권"}},"ms":{"stringUnit":{"state":"translated","value":"Sapaan dan tiket"}},"nl":{"stringUnit":{"state":"translated","value":"Groeten en kaartjes"}},"pl":{"stringUnit":{"state":"translated","value":"Powitania i bilety"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cumprimentos e passagens"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Cumprimentos e bilhetes"}},"ru":{"stringUnit":{"state":"translated","value":"Приветствия и билеты"}},"sr":{"stringUnit":{"state":"translated","value":"Pozdrav i karte"}},"sv":{"stringUnit":{"state":"translated","value":"Hälsningar och biljetter"}},"th":{"stringUnit":{"state":"translated","value":"ทักทายและตั๋ว"}},"fil":{"stringUnit":{"state":"translated","value":"Pagbati at tiket"}},"tr":{"stringUnit":{"state":"translated","value":"Selamlaşma ve biletler"}},"uk":{"stringUnit":{"state":"translated","value":"Вітання й квитки"}},"vi":{"stringUnit":{"state":"translated","value":"Lời chào 