    "Drag the OMSI 2 folder onto openOMSI.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Перацягніце тэчку OMSI 2 на openOMSI."}},"ca":{"stringUnit":{"state":"translated","value":"Arrossega la carpeta OMSI 2 sobre openOMSI."}},"cs":{"stringUnit":{"state":"translated","value":"Přetáhněte složku OMSI 2 na openOMSI."}},"de":{"stringUnit":{"state":"translated","value":"Ziehe den OMSI-2-Ordner auf openOMSI."}},"es":{"stringUnit":{"state":"translated","value":"Arrastra la carpeta OMSI 2 sobre openOMSI."}},"fr":{"stringUnit":{"state":"translated","value":"Glissez le dossier OMSI 2 sur openOMSI."}},"hi":{"stringUnit":{"state":"translated","value":"OMSI 2 फ़ोल्डर को openOMSI पर ड्रैग करें।"}},"hu":{"stringUnit":{"state":"translated","value":"Húzd az OMSI 2 mappát az openOMSI-ra."}},"id":{"stringUnit":{"state":"translated","value":"Seret folder OMSI 2 ke openOMSI."}},"it":{"stringUnit":{"state":"translated","value":"Trascina la cartella OMSI 2 su openOMSI."}},"ja":{"stringUnit":{"state":"translated","value":"OMSI 2フォルダをopenOMSIの上にドラッグします。"}},"ka":{"stringUnit":{"state":"translated","value":"გადაიტანეთ OMSI 2 საქაღალდე openOMSI-ზე."}},"kk":{"stringUnit":{"state":"translated","value":"OMSI 2 қалтасын openOMSI-ге сүйреңіз."}},"ko":{"stringUnit":{"state":"translated","value":"OMSI 2 폴더를 openOMSI 위로 드래그하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Seret folder OMSI 2 ke atas openOMSI."}},"nl":{"stringUnit":{"state":"translated","value":"Sleep de OMSI 2-map naar openOMSI."}},"pl":{"stringUnit":{"state":"translated","value":"Przeciągnij folder OMSI 2 na openOMSI."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Arraste a pasta OMSI 2 para o openOMSI."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Arraste a pasta OMSI 2 para o openOMSI."}},"ru":{"stringUnit":{"state":"translated","value":"Перетащите папку OMSI 2 на openOMSI."}},"sr":{"stringUnit":{"state":"translated","value":"Prevucite fasciklu OMSI 2 na openOMSI."}},"sv":{"stringUnit":{"state":"translated","value":"Dra OMSI 2-mappen till openOMSI."}},"th":{"stringUnit":{"state":"translated","value":"ลากโฟลเดอร์ OMSI 2 ไปวางบน openOMSI"}},"fil":{"stringUnit":{"state":"translated","value":"I-drag ang OMSI 2 folder papunta sa openOMSI."}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2 klasörünü openOMSI'nin üzerine sürükleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Перетягніть теку OMSI 2 на openOMSI."}},"vi":{"stringUnit":{"state":"translated","value":"Kéo thư mục OMSI 2 vào openOMSI."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将OMSI 2文件夹拖到openOMSI上。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將 OMSI 2 資料夾拖移到 openOMSI 上。"}}}},
    "Drive": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Ехаць"}},"ca":{"stringUnit":{"state":"translated","value":"Condueix"}},"cs":{"stringUnit":{"state":"translated","value":"Jet"}},"de":{"stringUnit":{"state":"translated","value":"Fahren"}},"es":{"stringUnit":{"state":"translated","value":"Conducir"}},"fr":{"stringUnit":{"state":"translated","value":"Conduire"}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइव"}},"hu":{"stringUnit":{"state":"translated","value":"Vezetés"}},"id":{"stringUnit":{"state":"translated","value":"Mengemudi"}},"it":{"stringUnit":{"state":"translated","value":"Guida"}},"ja":{"stringUnit":{"state":"translated","value":"運転"}},"ka":{"stringUnit":{"state":"translated","value":"მართვა"}},"kk":{"stringUnit":{"state":"translated","value":"Жүру"}},"ko":{"stringUnit":{"state":"translated","value":"운전"}},"ms":{"stringUnit":{"state":"translated","value":"Pandu"}},"nl":{"stringUnit":{"state":"translated","value":"Rijden"}},"pl":{"stringUnit":{"state":"translated","value":"Jedź"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dirigir"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Conduzir"}},"ru":{"stringUnit":{"state":"translated","value":"Поездка"}},"sr":{"stringUnit":{"state":"translated","value":"Vožnja"}},"sv":{"stringUnit":{"state":"translated","value":"Kör"}},"th":{"stringUnit":{"state":"translated","value":"ขับรถ"}},"fil":{"stringUnit":{"state":"translated","value":"Magmaneho"}},"tr":{"stringUnit":{"state":"translated","value":"Sürüş"}},"uk":{"stringUnit":{"state":"translated","value":"Їхати"}},"vi":{"stringUnit":{"state":"translated","value":"Lái xe"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"驾驶"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"駕駛"}}}},
    "Drive the buses of OMSI 2 wherever you are: its maps, its buses and its lines, at your fingertips.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіце аўтобусы OMSI 2 дзе заўгодна: яе карты, аўтобусы і маршруты — у вас пад рукой."}},"ca":{"stringUnit":{"state":"translated","value":"Condueix els autobusos d'OMSI 2 siguis on siguis: els seus mapes, els seus autobusos i les seves línies, a l'abast dels dits."}},"cs":{"stringUnit":{"state":"translated","value":"Řiďte autobusy z OMSI 2, ať jste kdekoli: jeho mapy, autobusy a linky máte po ruce."}},"de":{"stringUnit":{"state":"translated","value":"Fahre die Busse von OMSI 2, wo immer du bist: seine Karten, seine Busse und seine Linien, direkt unter deinen Fingern."}},"es":{"stringUnit":{"state":"translated","value":"Conduce los autobuses de OMSI 2 estés donde estés: sus mapas, sus autobuses y sus líneas, al alcance de tus dedos."}},"fr":{"stringUnit":{"state":"translated","value":"Conduisez les bus d'OMSI 2 où que vous soyez : ses cartes, ses bus et ses lignes, au bout des doigts."}},"hi":{"stringUnit":{"state":"translated","value":"OMSI 2 की बसें कहीं भी चलाएँ: इसके मैप, बसें और लाइनें, आपकी उँगलियों पर।"}},"hu":{"stringUnit":{"state":"translated","value":"Vezesd az OMSI 2 buszait, bárhol is vagy: a térképei, a buszai és a vonalai mind kéznél vannak."}},"id":{"stringUnit":{"state":"translated","value":"Kemudikan bus OMSI 2 di mana saja: peta, bus, dan rutenya, di ujung jari Anda."}},"it":{"stringUnit":{"state":"translated","value":"Guida i bus di OMSI 2 ovunque tu sia: le sue mappe, i suoi bus e le sue linee, a portata di dito."}},"ja":{"stringUnit":{"state":"translated","value":"どこにいてもOMSI 2のバスを運転しよう。マップもバスも路線も、指先ひとつで。"}},"ka":{"stringUnit":{"state":"translated","value":"მართეთ OMSI 2-ის ავტობუსები, სადაც არ უნდა იყოთ: მისი რუკები, ავტობუსები და ხაზები ხელის გულზე."}},"kk":{"stringUnit":{"state":"translated","value":"OMSI 2 автобустарын қай жерде болсаңыз да жүргізіңіз: оның карталары, автобустары мен желілері — қол астыңызда."}},"ko":{"stringUnit":{"state":"translated","value":"어디서나 OMSI 2의 버스를 운전하세요. 맵, 버스, 노선을 손끝으로 만나 보세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pandu bas OMSI 2 di mana sahaja: peta, bas dan laluannya, di hujung jari anda."}},"nl":{"stringUnit":{"state":"translated","value":"Rijd met de bussen van OMSI 2, waar je ook bent: de kaarten, de bussen en de lijnen, binnen handbereik."}},"pl":{"stringUnit":{"state":"translated","value":"Prowadź autobusy z OMSI 2, gdziekolwiek jesteś: jego mapy, autobusy i linie masz pod ręką."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dirija os ônibus do OMSI 2 onde você estiver: seus mapas, seus ônibus e suas linhas, na ponta dos dedos."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Conduza os autocarros do OMSI 2 onde quer que esteja: os seus mapas, os seus autocarros e as suas linhas, na ponta dos dedos."}},"ru":{"stringUnit":{"state":"translated","value":"Водите автобусы OMSI 2 где угодно: её карты, автобусы и маршруты — у вас под рукой."}},"sr":{"stringUnit":{"state":"translated","value":"Vozite autobuse OMSI 2 gde god da ste: njegove mape, autobusi i linije, na dohvat ruke."}},"sv":{"stringUnit":{"state":"translated","value":"Kör bussarna i OMSI 2 var du än är: kartorna, bussarna och linjerna, alltid nära till hands."}},"th":{"stringUnit":{"state":"translated","value":"ขับรถบัสของ OMSI 2 ได้ทุกที่ ทั้งแผนที่ รถบัส และสายรถ อยู่แค่ปลายนิ้ว"}},"fil":{"stringUnit":{"state":"translated","value":"Imaneho ang mga bus ng OMSI 2 kahit nasaan ka: ang mga mapa, bus at linya nito, abot-kamay mo."}},"tr":{"stringUnit":{"state":"translated","value":"OMSI 2'nin otobüslerini nerede olursanız olun kullanın: haritaları, otobüsleri ve hatları parmaklarınızın ucunda."}},"uk":{"stringUnit":{"state":"translated","value":"Керуйте автобусами OMSI 2 будь-де: її карти, автобуси й маршрути — у вас під рукою."}},"vi":{"stringUnit":{"state":"translated","value":"Lái xe buýt của OMSI 2 ở bất cứ đâu: bản đồ, xe buýt và tuyến đường, ngay trong tầm tay."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"随时随地驾驶OMSI 2的巴士：地图、车辆和线路，尽在指尖。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"隨時隨地駕駛 OMSI 2 的巴士：地圖、車輛與路線，盡在指尖。"}}}},
    "Drive this bus": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Ехаць на гэтым аўтобусе"}},"ca":{"stringUnit":{"state":"translated","value":"Condueix aquest autobús"}},"cs":{"stringUnit":{"state":"translated","value":"Jet tímto autobusem"}},"de":{"stringUnit":{"state":"translated","value":"Diesen Bus fahren"}},"es":{"stringUnit":{"state":"translated","value":"Conducir este autobús"}},"fr":{"stringUnit":{"state":"translated","value":"Conduire ce bus"}},"hi":{"stringUnit":{"state":"translated","value":"यह बस चलाएँ"}},"hu":{"stringUnit":{"state":"translated","value":"Vezesd ezt a buszt"}},"id":{"stringUnit":{"state":"translated","value":"Kemudikan bus ini"}},"it":{"stringUnit":{"state":"translated","value":"Guida questo autobus"}},"ja":{"stringUnit":{"state":"translated","value":"このバスを運転"}},"ka":{"stringUnit":{"state":"translated","value":"ამ ავტობუსის მართვა"}},"kk":{"stringUnit":{"state":"translated","value":"Осы автобуспен жүру"}},"ko":{"stringUnit":{"state":"translated","value":"이 버스 운전하기"}},"ms":{"stringUnit":{"state":"translated","value":"Pandu bas ini"}},"nl":{"stringUnit":{"state":"translated","value":"Met deze bus rijden"}},"pl":{"stringUnit":{"state":"translated","value":"Jedź tym autobusem"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dirigir este ônibus"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Conduzir este autocarro"}},"ru":{"stringUnit":{"state":"translated","value":"Ехать на этом автобусе"}},"sr":{"stringUnit":{"state":"translated","value":"Vozi ovaj autobus"}},"sv":{"stringUnit":{"state":"translated","value":"Kör den här bussen"}},"th":{"stringUnit":{"state":"translated","value":"ขับรถบัสคันนี้"}},"fil":{"stringUnit":{"state":"translated","value":"Imaneho ang bus na ito"}},"tr":{"stringUnit":{"state":"translated","value":"Bu otobüsü sür"}},"uk":{"stringUnit":{"state":"translated","value":"Їхати на цьому автобусі"}},"vi":{"stringUnit":{"state":"translated","value":"Lái xe buýt này"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"驾驶这辆巴士"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"駕駛這輛公車"}}}},
    "Drive with friends by a code, or on servers that are always on.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гуляйце з сябрамі па кодзе або на серверах, што працуюць пастаянна."}},"ca":{"stringUnit":{"state":"translated","value":"Condueix amb amics mitjançant un codi o en servidors que estan sempre actius."}},"cs":{"stringUnit":{"state":"translated","value":"Jezděte s kamarády pomocí kódu nebo na serverech, které běží pořád."}},"de":{"stringUnit":{"state":"translated","value":"Fahre mit Freunden per Code oder auf Servern, die immer laufen."}},"es":{"stringUnit":{"state":"translated","value":"Conduce con amigos con un código, o en servidores siempre activos."}},"fr":{"stringUnit":{"state":"translated","value":"Roulez avec des amis par code ou sur des serveurs toujours en ligne."}},"hi":{"stringUnit":{"state":"translated","value":"दोस्तों के साथ कोड से चलाएँ, या हमेशा चालू रहने वाले सर्वरों पर।"}},"hu":{"stringUnit":{"state":"translated","value":"Vezess barátokkal kóddal, vagy folyamatosan futó szervereken."}},"id":{"stringUnit":{"state":"translated","value":"Mengemudi dengan teman lewat kode atau di server yang selalu aktif."}},"it":{"stringUnit":{"state":"translated","value":"Guida con gli amici tramite un codice, o su server sempre attivi."}},"ja":{"stringUnit":{"state":"translated","value":"コードで友達と、または常時稼働のサーバーで一緒に運転します。"}},"ka":{"stringUnit":{"state":"translated","value":"ატარეთ ავტობუსი მეგობრებთან ერთად კოდით ან მუდმივად ჩართულ სერვერებზე."}},"kk":{"stringUnit":{"state":"translated","value":"Достармен кодпен немесе үнемі қосулы серверлерде жүріңіз."}},"ko":{"stringUnit":{"state":"translated","value":"코드를 통해 친구와 운전하거나 상시 운영 서버에 참가하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pandu dengan rakan menggunakan kod atau di pelayan yang sentiasa aktif."}},"nl":{"stringUnit":{"state":"translated","value":"Rijd met vrienden via een code, of op servers die altijd aan staan."}},"pl":{"stringUnit":{"state":"translated","value":"Jedź ze znajomymi po kodzie lub na serwerach działających cały czas."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dirija com amigos usando um código, ou em servidores sempre ligados."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Dirija com amigos usando um código, ou em servidores sempre ligados."}},"ru":{"stringUnit":{"state":"translated","value":"Ездите с друзьями по коду или на серверах, которые работают всегда."}},"sr":{"stringUnit":{"state":"translated","value":"Vozite se sa prijateljima pomoću koda ili na serverima koji su uvek uključeni."}},"sv":{"stringUnit":{"state":"translated","value":"Kör med vänner med hjälp av en kod eller på servrar som alltid är igång."}},"th":{"stringUnit":{"state":"translated","value":"ขับรถกับเพื่อนผ่านรหัสหรือบนเซิร์ฟเวอร์ที่เปิดตลอดเวลา"}},"fil":{"stringUnit":{"state":"translated","value":"Magmaneho kasama ang mga kaibigan gamit ang code o sa laging online na server."}},"tr":{"stringUnit":{"state":"translated","value":"Arkadaşlarla kodla veya her zaman açık sunucularda sürün."}},"uk":{"stringUnit":{"state":"translated","value":"Грайте з друзями за кодом або на серверах, що працюють постійно."}},"vi":{"stringUnit":{"state":"translated","value":"Lái xe cùng bạn bè bằng mã hoặc trên máy chủ hoạt động liên tục."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过会话码,或在常开的服务器上与朋友一起驾驶。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"使用連線碼與朋友一同駕駛，或加入長期在線的伺服器。"}}}},
