    "Wheels with a saved direction use their own setting under Controls → Game controllers.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Рулі з захаваным кірункам выкарыстоўваюць уласную наладу ў раздзеле Кіраванне → Гульнявыя кантролеры."}},"ca":{"stringUnit":{"state":"translated","value":"Els volants amb un sentit desat fan servir el seu propi ajust a Controls → Dispositius de joc."}},"cs":{"stringUnit":{"state":"translated","value":"Volanty s uloženým směrem používají vlastní nastavení v části Ovládání → Herní ovladače."}},"de":{"stringUnit":{"state":"translated","value":"Lenkräder mit gespeicherter Richtung verwenden ihre eigene Einstellung unter Steuerung → Gamecontroller."}},"es":{"stringUnit":{"state":"translated","value":"Los volantes con un sentido guardado usan su propio ajuste en Controles → Mandos de juego."}},"fr":{"stringUnit":{"state":"translated","value":"Les volants dont le sens est enregistré gardent leur propre réglage sous Commandes → Contrôleurs de jeu."}},"hi":{"stringUnit":{"state":"translated","value":"सेव की गई दिशा वाले व्हील कंट्रोल → गेम कंट्रोलर में अपनी अलग सेटिंग इस्तेमाल करते हैं।"}},"hu":{"stringUnit":{"state":"translated","value":"A mentett iránnyal rendelkező kormányok a saját beállításukat használják: Irányítás → Játékvezérlők."}},"id":{"stringUnit":{"state":"translated","value":"Setir dengan arah tersimpan memakai pengaturannya sendiri di Kontrol → Pengontrol game."}},"it":{"stringUnit":{"state":"translated","value":"I volanti con una direzione salvata usano la propria impostazione in Comandi → Controller di gioco."}},"ja":{"stringUnit":{"state":"translated","value":"方向が保存されたハンドルは、操作 → ゲームコントローラー の個別設定を使用します。"}},"ka":{"stringUnit":{"state":"translated","value":"შენახული მიმართულების მქონე საჭეები საკუთარ პარამეტრს იყენებენ: მართვის საშუალებები → სათამაშო კონტროლერები."}},"kk":{"stringUnit":{"state":"translated","value":"Бағыты сақталған рульдер Басқару → Ойын контроллерлері бөліміндегі өз баптауын қолданады."}},"ko":{"stringUnit":{"state":"translated","value":"방향이 저장된 휠은 조작 설정 → 게임 컨트롤러에 있는 자체 설정을 사용합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Stereng dengan arah tersimpan menggunakan tetapannya sendiri di Kawalan → Pengawal permainan."}},"nl":{"stringUnit":{"state":"translated","value":"Stuurwielen met een opgeslagen richting gebruiken hun eigen instelling onder Bediening → Gamecontrollers."}},"pl":{"stringUnit":{"state":"translated","value":"Kierownice z zapisanym kierunkiem używają własnego ustawienia w sekcji Sterowanie → Kontrolery gier."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Volantes com uma direção salva usam a própria configuração em Controles → Controles de jogo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Volantes com uma direção guardada usam a própria configuração em Controlos → Controladores de jogo."}},"ru":{"stringUnit":{"state":"translated","value":"Рули с сохранённым направлением используют собственную настройку в разделе Управление → Игровые контроллеры."}},"sr":{"stringUnit":{"state":"translated","value":"Točkovi sa sačuvanim smerom koriste sopstvene postavke pod Kontrole → Kontroleri igre."}},"sv":{"stringUnit":{"state":"translated","value":"Rattar med en sparad riktning använder sin egen inställning under Kontroller → Spelkontroller."}},"th":{"stringUnit":{"state":"translated","value":"พวงมาลัยที่บันทึกทิศทางไว้จะใช้การตั้งค่าของตัวเองใน การควบคุม → คอนโทรลเลอร์เกม"}},"fil":{"stringUnit":{"state":"translated","value":"Ang mga manibelang may naka-save na direksyon ay gumagamit ng sarili nilang setting sa Mga kontrol → Mga game controller."}},"tr":{"stringUnit":{"state":"translated","value":"Kayıtlı yönü olan direksiyonlar Kontroller → Oyun kumandaları altındaki kendi ayarlarını kullanır."}},"uk":{"stringUnit":{"state":"translated","value":"Керма зі збереженим напрямком використовують власне налаштування в розділі Керування → Ігрові контролери."}},"vi":{"stringUnit":{"state":"translated","value":"Vô lăng đã lưu hướng sẽ dùng thiết lập riêng trong Điều khiển → Tay cầm chơi game."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存方向的方向盘在“控制 → 游戏手柄”中使用各自的设置。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已儲存方向的方向盤在「控制」→「遊戲控制器」下使用自己的設定。"}}}},
    "When": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Quan"}},"de":{"stringUnit":{"state":"translated","value":"Wann"}},"es":{"stringUnit":{"state":"translated","value":"Cuándo"}},"fr":{"stringUnit":{"state":"translated","value":"Quand"}},"ka":{"stringUnit":{"state":"translated","value":"როდის"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Quando"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Quando"}},"ru":{"stringUnit":{"state":"translated","value":"Когда"}},"sr":{"stringUnit":{"state":"translated","value":"Kada"}},"sv":{"stringUnit":{"state":"translated","value":"När"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"時間"}}}},
    "Where things are": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Ubicacions"}},"de":{"stringUnit":{"state":"translated","value":"Wo alles liegt"}},"es":{"stringUnit":{"state":"translated","value":"Ubicaciones"}},"fr":{"stringUnit":{"state":"translated","value":"Emplacements"}},"ka":{"stringUnit":{"state":"translated","value":"მდებარეობები"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Onde as coisas estão"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Onde estão as coisas"}},"ru":{"stringUnit":{"state":"translated","value":"Где что лежит"}},"sr":{"stringUnit":{"state":"translated","value":"Gde su stvari"}},"sv":{"stringUnit":{"state":"translated","value":"Var saker finns"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檔案位置"}}}},
    "While driving, open the game menu and copy the server code there.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Падчас паездкі адкрыйце меню гульні і скапіруйце там код сервера."}},"ca":{"stringUnit":{"state":"translated","value":"Mentre condueixes, obre el menú del joc i copia-hi el codi del servidor."}},"cs":{"stringUnit":{"state":"translated","value":"Během jízdy otevřete herní menu a zkopírujte v něm kód serveru."}},"de":{"stringUnit":{"state":"translated","value":"Öffne während der Fahrt das Spielmenü und kopiere dort den Servercode."}},"es":{"stringUnit":{"state":"translated","value":"Mientras conduces, abre el menú del juego y copia allí el código del servidor."}},"fr":{"stringUnit":{"state":"translated","value":"Pendant la conduite, ouvrez le menu du jeu et copiez-y le code du serveur."}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइव करते समय गेम मेन्यू खोलें और वहाँ से सर्वर कोड कॉपी करें।"}},"hu":{"stringUnit":{"state":"translated","value":"Vezetés közben nyisd meg a játék menüjét, és ott másold ki a szerver kódját."}},"id":{"stringUnit":{"state":"translated","value":"Saat mengemudi, buka menu game dan salin kode server di sana."}},"it":{"stringUnit":{"state":"translated","value":"Durante la guida, apri il menu del gioco e copia lì il codice del server."}},"ja":{"stringUnit":{"state":"translated","value":"運転中にゲームメニューを開き、そこでサーバーコードをコピーします。"}},"ka":{"stringUnit":{"state":"translated","value":"მართვისას გახსენით თამაშის მენიუ და იქ დააკოპირეთ სერვერის კოდი."}},"kk":{"stringUnit":{"state":"translated","value":"Жүргізу кезінде ойын мәзірін ашып, сервер кодын сол жерден көшіріңіз."}},"ko":{"stringUnit":{"state":"translated","value":"운전 중에 게임 메뉴를 열고 거기서 서버 코드를 복사하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Semasa memandu, buka menu permainan dan salin kod pelayan di situ."}},"nl":{"stringUnit":{"state":"translated","value":"Open tijdens het rijden het spelmenu en kopieer daar de servercode."}},"pl":{"stringUnit":{"state":"translated","value":"Podczas jazdy otwórz menu gry i skopiuj tam kod serwera."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Durante a condução, abra o menu do jogo e copie o código do servidor."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Durante a condução, abra o menu do jogo e copie aí o código do servidor."}},"ru":{"stringUnit":{"state":"translated","value":"Во время поездки откройте меню игры и скопируйте там код сервера."}},"sr":{"stringUnit":{"state":"translated","value":"Tokom vožnje otvorite meni igre i tamo kopirajte kod servera."}},"sv":{"stringUnit":{"state":"translated","value":"Öppna spelmenyn medan du kör och kopiera serverkoden där."}},"th":{"stringUnit":{"state":"translated","value":"ระหว่างขับ ให้เปิดเมนูเกมแล้วคัดลอกรหัสเซิร์ฟเวอร์จากที่นั่น"}},"fil":{"stringUnit":{"state":"translated","value":"Habang nagmamaneho, buksan ang menu ng laro at kopyahin doon ang server code."}},"tr":{"stringUnit":{"state":"translated","value":"Sürüş sırasında oyun menüsünü açın ve sunucu kodunu oradan kopyalayın."}},"uk":{"stringUnit":{"state":"translated","value":"Під час поїздки відкрийте меню гри й скопіюйте там код сервера."}},"vi":{"stringUnit":{"state":"translated","value":"Khi đang lái, mở menu trò chơi và sao chép mã máy chủ tại đó."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"驾驶时打开游戏菜单，在那里复制会话码/服务器代码。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"駕駛時開啟遊戲選單，在那裡複製連線碼。"}}}},
