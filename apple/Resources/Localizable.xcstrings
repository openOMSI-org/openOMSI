    "No mods yet. Choose a folder or an archive.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Модаў яшчэ няма. Выберыце тэчку або архіў."}},"ca":{"stringUnit":{"state":"translated","value":"Encara no hi ha mods. Tria una carpeta o un arxiu."}},"cs":{"stringUnit":{"state":"translated","value":"Zatím žádné modifikace. Vyberte složku nebo archiv."}},"de":{"stringUnit":{"state":"translated","value":"Noch keine Mods. Wähle einen Ordner oder ein Archiv."}},"es":{"stringUnit":{"state":"translated","value":"Aún no hay mods. Elige una carpeta o un archivo comprimido."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun mod pour l'instant. Choisissez un dossier ou une archive."}},"hi":{"stringUnit":{"state":"translated","value":"अभी कोई मॉड नहीं। कोई फ़ोल्डर या आर्काइव चुनें।"}},"hu":{"stringUnit":{"state":"translated","value":"Még nincsenek modok. Válassz egy mappát vagy archívumot."}},"id":{"stringUnit":{"state":"translated","value":"Belum ada mod. Pilih folder atau arsip."}},"it":{"stringUnit":{"state":"translated","value":"Ancora nessuna mod. Scegli una cartella o un archivio."}},"ja":{"stringUnit":{"state":"translated","value":"Mod はまだありません。フォルダかアーカイブを選んでください。"}},"ka":{"stringUnit":{"state":"translated","value":"მოდები ჯერ არ არის. აირჩიეთ საქაღალდე ან არქივი."}},"kk":{"stringUnit":{"state":"translated","value":"Модтар әлі жоқ. Қалтаны немесе архивті таңдаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"아직 모드가 없습니다. 폴더나 압축 파일을 선택하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Belum ada mod. Pilih folder atau arkib."}},"nl":{"stringUnit":{"state":"translated","value":"Nog geen mods. Kies een map of een archief."}},"pl":{"stringUnit":{"state":"translated","value":"Brak modów. Wybierz folder lub archiwum."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum mod ainda. Escolha uma pasta ou um arquivo compactado."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ainda sem mods. Escolha uma pasta ou um arquivo comprimido."}},"ru":{"stringUnit":{"state":"translated","value":"Модов пока нет. Выберите папку или архив."}},"sr":{"stringUnit":{"state":"translated","value":"Još nema modova. Izaberite fasciklu ili arhivu."}},"sv":{"stringUnit":{"state":"translated","value":"Inga moddar än. Välj en mapp eller ett arkiv."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่มีม็อด เลือกโฟลเดอร์หรือไฟล์บีบอัด"}},"fil":{"stringUnit":{"state":"translated","value":"Wala pang mod. Pumili ng folder o archive."}},"tr":{"stringUnit":{"state":"translated","value":"Henüz mod yok. Bir klasör veya arşiv seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Модів поки немає. Оберіть теку або архів."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa có bản mod nào. Hãy chọn một thư mục hoặc tệp nén."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还没有模组。请选择一个文件夹或压缩包。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"還沒有模組。請選擇一個資料夾或壓縮檔。"}}}},
    "No runs yet. Drive a duty and it shows up here.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Паездак яшчэ няма. Праедзьце наряд, і ён з'явіцца тут."}},"ca":{"stringUnit":{"state":"translated","value":"Encara no hi ha serveis. Fes-ne un i apareixerà aquí."}},"cs":{"stringUnit":{"state":"translated","value":"Zatím žádné jízdy. Odjeďte službu a objeví se tady."}},"de":{"stringUnit":{"state":"translated","value":"Noch keine Fahrten. Fahre einen Dienst, dann erscheint er hier."}},"es":{"stringUnit":{"state":"translated","value":"Aún no hay recorridos. Conduce un servicio y aparecerá aquí."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun service pour l'instant. Faites un service et il apparaîtra ici."}},"hi":{"stringUnit":{"state":"translated","value":"अभी कोई रन नहीं। कोई ड्यूटी चलाएँ, वह यहाँ दिखेगी।"}},"hu":{"stringUnit":{"state":"translated","value":"Még nincs korábbi menet. Teljesíts egy szolgálatot, és itt megjelenik."}},"id":{"stringUnit":{"state":"translated","value":"Belum ada perjalanan. Jalankan satu tugas untuk melihatnya di sini."}},"it":{"stringUnit":{"state":"translated","value":"Ancora nessuna corsa. Guida un turno e comparirà qui."}},"ja":{"stringUnit":{"state":"translated","value":"運行記録はまだありません。乗務を運転するとここに表示されます。"}},"ka":{"stringUnit":{"state":"translated","value":"რეისები ჯერ არ არის. შეასრულეთ რეისი და ის აქ გამოჩნდება."}},"kk":{"stringUnit":{"state":"translated","value":"Әзірге рейстер жоқ. Нарядпен жүріңіз, ол осында пайда болады."}},"ko":{"stringUnit":{"state":"translated","value":"아직 운행 기록이 없습니다. 근무를 완료하면 여기에 표시됩니다."}},"ms":{"stringUnit":{"state":"translated","value":"Belum ada perjalanan. Pandu satu tugas untuk melihatnya di sini."}},"nl":{"stringUnit":{"state":"translated","value":"Nog geen ritten. Rijd een dienst en die verschijnt hier."}},"pl":{"stringUnit":{"state":"translated","value":"Brak przejazdów. Odbądź służbę, a pojawi się tutaj."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ainda não há viagens. Faça uma escala e ela aparecerá aqui."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ainda não há viagens. Faça uma escala e ela aparecerá aqui."}},"ru":{"stringUnit":{"state":"translated","value":"Поездок пока нет. Отработайте смену - она появится здесь."}},"sr":{"stringUnit":{"state":"translated","value":"Još nema vožnji. Odvozite jednu smenu i pojaviće se ovde."}},"sv":{"stringUnit":{"state":"translated","value":"Inga körningar ännu. Kör en tjänst så visas den här."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่มีประวัติการขับรถ เริ่มหน้าที่แล้วข้อมูลจะปรากฏที่นี่"}},"fil":{"stringUnit":{"state":"translated","value":"Wala pang biyahe. Magmaneho ng isang duty para lumitaw rito."}},"tr":{"stringUnit":{"state":"translated","value":"Henüz sefer yok. Bir görev sürün, burada görünür."}},"uk":{"stringUnit":{"state":"translated","value":"Поїздок ще немає. Проїдьте наряд, і він з'явиться тут."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa có chuyến nào. Lái một ca để hiển thị tại đây."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还没有行车记录。完成一次出车任务后会显示在这里。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚無行車記錄。完成一個更次後便會顯示在此。"}}}},
    "No saved profiles": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Sense perfils desats"}},"de":{"stringUnit":{"state":"translated","value":"Keine gespeicherten Profile"}},"es":{"stringUnit":{"state":"translated","value":"No hay perfiles guardados"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun profil enregistré"}},"ka":{"stringUnit":{"state":"translated","value":"შენახული პროფილები არ არის"}},"nl":{"stringUnit":{"state":"translated","value":"Geen opgeslagen profielen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum perfil salvo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nenhum perfil guardado"}},"ru":{"stringUnit":{"state":"translated","value":"Нет сохранённых профилей"}},"sr":{"stringUnit":{"state":"translated","value":"Nema sačuvanih profila"}},"sv":{"stringUnit":{"state":"translated","value":"Inga sparade profiler"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有保存的配置文件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有儲存的設定檔"}}}},
    "No servers yet. Add a server by the address its owner gives you.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Сервераў яшчэ няма. Дадайце сервер па адрасе, які дасць яго ўладальнік."}},"ca":{"stringUnit":{"state":"translated","value":"Encara no hi ha servidors. Afegeix-ne un amb l'adreça que et doni el propietari."}},"cs":{"stringUnit":{"state":"translated","value":"Zatím žádné servery. Přidejte server podle adresy od jeho majitele."}},"de":{"stringUnit":{"state":"translated","value":"Noch keine Server. Füge einen Server mit der Adresse hinzu, die dir sein Besitzer gibt."}},"es":{"stringUnit":{"state":"translated","value":"Aún no hay servidores. Añade un servidor con la dirección que te dé su dueño."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun serveur pour l'instant. Ajoutez un serveur avec l'adresse donnée par son propriétaire."}},"hi":{"stringUnit":{"state":"translated","value":"अभी कोई सर्वर नहीं। मालिक के दिए पते से सर्वर जोड़ें।"}},"hu":{"stringUnit":{"state":"translated","value":"Még nincs szerver. Adj hozzá egy szervert a tulajdonosa által adott címmel."}},"id":{"stringUnit":{"state":"translated","value":"Belum ada server. Tambahkan alamat dari pemiliknya."}},"it":{"stringUnit":{"state":"translated","value":"Ancora nessun server. Aggiungi un server con l'indirizzo che ti dà il proprietario."}},"ja":{"stringUnit":{"state":"translated","value":"サーバーはまだありません。所有者から教えられたアドレスでサーバーを追加してください。"}},"ka":{"stringUnit":{"state":"translated","value":"სერვერები ჯერ არ არის. დაამატეთ სერვერი მისი მფლობელის მიერ მოცემული მისამართით."}},"kk":{"stringUnit":{"state":"translated","value":"Серверлер әлі жоқ. Иесі берген мекенжай бойынша сервер қосыңыз."}},"ko":{"stringUnit":{"state":"translated","value":"아직 서버가 없습니다. 소유자가 제공한 주소로 추가하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Belum ada pelayan. Tambah alamat yang diberikan pemiliknya."}},"nl":{"stringUnit":{"state":"translated","value":"Nog geen servers. Voeg een server toe met het adres dat de eigenaar je geeft."}},"pl":{"stringUnit":{"state":"translated","value":"Brak serwerów. Dodaj serwer według adresu podanego przez właściciela."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ainda não há servidores. Adicione um servidor com o endereço que o dono fornecer."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ainda não há servidores. Adicione um servidor com o endereço que o dono fornecer."}},"ru":{"stringUnit":{"state":"translated","value":"Серверов пока нет. Добавьте сервер по адресу, который даст его владелец."}},"sr":{"stringUnit":{"state":"translated","value":"Još nema servera. Dodajte server prema adresi koju vam daje njegov vlasnik."}},"sv":{"stringUnit":{"state":"translated","value":"Inga servrar ännu. Lägg till en server med adressen som ägaren ger dig."}},"th":{"stringUnit":{"state":"translated","value":"ยังไม่มีเซิร์ฟเวอร์ เพิ่มจากที่อยู่ที่เจ้าของให้มา"}},"fil":{"stringUnit":{"state":"translated","value":"Wala pang server. Idagdag ang address na ibinigay ng owner."}},"tr":{"stringUnit":{"state":"translated","value":"Henüz sunucu yok. Sahibinin verdiği adresle bir sunucu ekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Серверів ще немає. Додайте сервер за адресою, яку дасть його власник."}},"vi":{"stringUnit":{"state":"translated","value":"Chưa có máy chủ. Thêm địa chỉ do chủ máy chủ cung cấp."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还没有服务器。请通过其所有者提供的地址添加服务器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未加入伺服器。請輸入伺服器擁有者提供的地址。"}}}},
    "No starred bus": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"No hi ha cap autobús preferit"}},"de":{"stringUnit":{"state":"translated","value":"Kein markierter Bus"}},"es":{"stringUnit":{"state":"translated","value":"No hay autobuses favoritos"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun bus favori"}},"ka":{"stringUnit":{"state":"translated","value":"რჩეული ავტობუსი არ არის"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum ônibus favorito"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nenhum autocarro favorito"}},"ru":{"stringUnit":{"state":"translated","value":"Нет избранных автобусов"}},"sr":{"stringUnit":{"state":"translated","value":"Nema autobus sa zvezdicom"}},"sv":{"stringUnit":{"state":"translated","value":"Ingen favoritbuss"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有已加星號的巴士"}}}},
    "No tour has a trip still to come that matches.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Cap torn amb trajectes pendents coincideix."}},"de":{"stringUnit":{"state":"translated","value":"Kein Umlauf hat noch eine passende Fahrt vor sich."}},"es":{"stringUnit":{"state":"translated","value":"Ningún turno tiene un trayecto pendiente que coincida."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun service n'a de voyage à venir qui correspond."}},"ka":{"stringUnit":{"state":"translated","value":"არცერთ რეისს არ აქვს შესაბამისი მომავალი მგზავრობა."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma escala tem uma viagem futura correspondente."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nenhuma escala tem uma viagem ainda por fazer que corresponda."}},"ru":{"stringUnit":{"state":"translated","value":"Нет подходящего рейса, который ещё предстоит выполнить."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有符合條件且仍有未出發行程的班次。"}}}},
    "No tour left at this time: show the ended tours, or start earlier.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"No queden torns a aquesta hora: mostra els acabats o comença abans."}},"de":{"stringUnit":{"state":"translated","value":"Zu dieser Zeit ist kein Umlauf mehr übrig: zeig die beendeten Umläufe an oder starte früher."}},"es":{"stringUnit":{"state":"translated","value":"No quedan turnos a esta hora: muestra los que ya han terminado o empieza antes."}},"fr":{"stringUnit":{"state":"translated","value":"Plus aucun service à cette heure : affichez les services terminés ou commencez plus tôt."}},"ka":{"stringUnit":{"state":"translated","value":"ამ დროს რეისი აღარ დარჩა: აჩვენეთ დასრულებული რეისები ან დაიწყეთ უფრო ადრე."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não há mais escalas neste horário: mostre as encerradas ou comece mais cedo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Não restam escalas a esta hora: mostre as escalas terminadas ou comece mais cedo."}},"ru":{"stringUnit":{"state":"translated","value":"На это время рейсов не осталось: покажите завершённые туры или начните раньше."}},"sr":{"stringUnit":{"state":"translated","value":"Trenutno nema više obilazaka: prikažite završene obilaske ili počnite ranije."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此時間已無可用班次：顯示已結束班次，或提早開始。"}}}},
    "No tutorial found": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"No s'ha trobat cap tutorial"}},"de":{"stringUnit":{"state":"translated","value":"Kein Tutorial gefunden"}},"es":{"stringUnit":{"state":"translated","value":"No se ha encontrado ningún tutorial"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun tutoriel trouvé"}},"ka":{"stringUnit":{"state":"translated","value":"გაკვეთილი ვერ მოიძებნა"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum tutorial encontrado"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nenhum tutorial encontrado"}},"ru":{"stringUnit":{"state":"translated","value":"Обучение не найдено"}},"sr":{"stringUnit":{"state":"translated","value":"Nije pronađen vodič"}},"sv":{"stringUnit":{"state":"translated","value":"Ingen handledning hittades"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"找不到教學"}}}},
