    "Paste the code here and confirm the session.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Устаўце код сюды і пацвердзіце сесію."}},"ca":{"stringUnit":{"state":"translated","value":"Enganxa el codi aquí i confirma la sessió."}},"cs":{"stringUnit":{"state":"translated","value":"Vložte sem kód a potvrďte relaci."}},"de":{"stringUnit":{"state":"translated","value":"Füge den Code hier ein und bestätige die Sitzung."}},"es":{"stringUnit":{"state":"translated","value":"Pega el código aquí y confirma la sesión."}},"fr":{"stringUnit":{"state":"translated","value":"Collez le code ici et confirmez la session."}},"hi":{"stringUnit":{"state":"translated","value":"कोड यहाँ पेस्ट करें और सेशन की पुष्टि करें।"}},"hu":{"stringUnit":{"state":"translated","value":"Illeszd be ide a kódot, és erősítsd meg a munkamenetet."}},"id":{"stringUnit":{"state":"translated","value":"Tempel kode di sini dan konfirmasi sesi."}},"it":{"stringUnit":{"state":"translated","value":"Incolla qui il codice e conferma la sessione."}},"ja":{"stringUnit":{"state":"translated","value":"ここにコードを貼り付けて、セッションを確認します。"}},"ka":{"stringUnit":{"state":"translated","value":"ჩასვით კოდი აქ და დაადასტურეთ სესია."}},"kk":{"stringUnit":{"state":"translated","value":"Кодты осында қойып, сессияны растаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"여기에 코드를 붙여넣고 세션을 확인하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Tampal kod di sini dan sahkan sesi."}},"nl":{"stringUnit":{"state":"translated","value":"Plak de code hier en bevestig de sessie."}},"pl":{"stringUnit":{"state":"translated","value":"Wklej tutaj kod i potwierdź sesję."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cole o código aqui e confirme a sessão."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Cole o código aqui e confirme a sessão."}},"ru":{"stringUnit":{"state":"translated","value":"Вставьте код сюда и подтвердите сессию."}},"sr":{"stringUnit":{"state":"translated","value":"Nalepite kod ovde i potvrdite sesiju."}},"sv":{"stringUnit":{"state":"translated","value":"Klistra in koden här och bekräfta sessionen."}},"th":{"stringUnit":{"state":"translated","value":"วางรหัสที่นี่ แล้วยืนยันเซสชัน"}},"fil":{"stringUnit":{"state":"translated","value":"I-paste ang code dito at kumpirmahin ang session."}},"tr":{"stringUnit":{"state":"translated","value":"Kodu buraya yapıştırın ve oturumu onaylayın."}},"uk":{"stringUnit":{"state":"translated","value":"Вставте код сюди й підтвердьте сесію."}},"vi":{"stringUnit":{"state":"translated","value":"Dán mã vào đây và xác nhận phiên."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在这里粘贴会话码，然后确认会话。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在這裡貼上連線碼，然後確認房間。"}}}},
    "Paste the complete code from your friend. Leading and trailing spaces are removed.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Устаўце поўны код ад сябра. Прабелы ў пачатку і ў канцы выдаляюцца."}},"ca":{"stringUnit":{"state":"translated","value":"Enganxa el codi complet del teu amic. S'eliminen els espais del principi i del final."}},"cs":{"stringUnit":{"state":"translated","value":"Vložte celý kód od kamaráda. Mezery na začátku a na konci se odstraní."}},"de":{"stringUnit":{"state":"translated","value":"Füge den vollständigen Code deines Freundes ein. Leerzeichen am Anfang und Ende werden entfernt."}},"es":{"stringUnit":{"state":"translated","value":"Pega el código completo de tu amigo. Se eliminan los espacios al principio y al final."}},"fr":{"stringUnit":{"state":"translated","value":"Collez le code complet de votre ami. Les espaces au début et à la fin sont supprimés."}},"hi":{"stringUnit":{"state":"translated","value":"दोस्त से मिला पूरा कोड पेस्ट करें। आगे-पीछे की खाली जगह हटा दी जाती है।"}},"hu":{"stringUnit":{"state":"translated","value":"Illeszd be a barátodtól kapott teljes kódot. Az elején és végén lévő szóközök törlődnek."}},"id":{"stringUnit":{"state":"translated","value":"Tempel kode lengkap dari teman Anda. Spasi di awal dan akhir akan dihapus."}},"it":{"stringUnit":{"state":"translated","value":"Incolla il codice completo del tuo amico. Gli spazi iniziali e finali vengono rimossi."}},"ja":{"stringUnit":{"state":"translated","value":"友達から届いたコードをそのまま貼り付けてください。前後の空白は自動で削除されます。"}},"ka":{"stringUnit":{"state":"translated","value":"ჩასვით თქვენი მეგობრის სრული კოდი. ჰარები დასაწყისსა და ბოლოში წაიშლება."}},"kk":{"stringUnit":{"state":"translated","value":"Досыңыздан алған толық кодты қойыңыз. Басы мен соңындағы бос орындар жойылады."}},"ko":{"stringUnit":{"state":"translated","value":"친구에게 받은 전체 코드를 붙여넣으세요. 앞뒤 공백은 자동으로 제거됩니다."}},"ms":{"stringUnit":{"state":"translated","value":"Tampal kod penuh daripada rakan anda. Ruang di awal dan akhir akan dibuang."}},"nl":{"stringUnit":{"state":"translated","value":"Plak de volledige code van je vriend. Spaties aan het begin en eind worden verwijderd."}},"pl":{"stringUnit":{"state":"translated","value":"Wklej pełny kod od znajomego. Spacje na początku i końcu zostaną usunięte."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cole o código completo do seu amigo. Espaços no início e no fim são removidos."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Cole o código completo do seu amigo. Os espaços no início e no fim são removidos."}},"ru":{"stringUnit":{"state":"translated","value":"Вставьте полный код от друга. Пробелы в начале и в конце удаляются."}},"sr":{"stringUnit":{"state":"translated","value":"Nalepite ceo kod koji vam je poslao prijatelj. Razmaci na početku i kraju biće uklonjeni."}},"sv":{"stringUnit":{"state":"translated","value":"Klistra in hela koden från din vän. Mellanslag i början och slutet tas bort."}},"th":{"stringUnit":{"state":"translated","value":"วางรหัสฉบับเต็มจากเพื่อน ช่องว่างด้านหน้าและด้านหลังจะถูกลบออก"}},"fil":{"stringUnit":{"state":"translated","value":"I-paste ang buong code mula sa kaibigan mo. Aalisin ang mga espasyo sa simula at dulo."}},"tr":{"stringUnit":{"state":"translated","value":"Arkadaşınızdan gelen kodun tamamını yapıştırın. Baştaki ve sondaki boşluklar silinir."}},"uk":{"stringUnit":{"state":"translated","value":"Вставте повний код від друга. Пробіли на початку й у кінці видаляються."}},"vi":{"stringUnit":{"state":"translated","value":"Dán toàn bộ mã mà bạn của bạn gửi. Khoảng trắng ở đầu và cuối sẽ được xóa."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"粘贴朋友提供的完整会话码，前后空格会自动移除。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"貼上朋友提供的完整連線碼，會自動移除前後空白。"}}}},
