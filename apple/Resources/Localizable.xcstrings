    "Not now": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Не цяпер"}},"ca":{"stringUnit":{"state":"translated","value":"Ara no"}},"cs":{"stringUnit":{"state":"translated","value":"Teď ne"}},"de":{"stringUnit":{"state":"translated","value":"Nicht jetzt"}},"es":{"stringUnit":{"state":"translated","value":"Ahora no"}},"fr":{"stringUnit":{"state":"translated","value":"Pas maintenant"}},"hi":{"stringUnit":{"state":"translated","value":"अभी नहीं"}},"hu":{"stringUnit":{"state":"translated","value":"Most nem"}},"id":{"stringUnit":{"state":"translated","value":"Nanti saja"}},"it":{"stringUnit":{"state":"translated","value":"Non ora"}},"ja":{"stringUnit":{"state":"translated","value":"今はしない"}},"ka":{"stringUnit":{"state":"translated","value":"ახლა არა"}},"kk":{"stringUnit":{"state":"translated","value":"Қазір емес"}},"ko":{"stringUnit":{"state":"translated","value":"나중에"}},"ms":{"stringUnit":{"state":"translated","value":"Bukan sekarang"}},"nl":{"stringUnit":{"state":"translated","value":"Niet nu"}},"pl":{"stringUnit":{"state":"translated","value":"Nie teraz"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Agora não"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Agora não"}},"ru":{"stringUnit":{"state":"translated","value":"Не сейчас"}},"sr":{"stringUnit":{"state":"translated","value":"Ne sada"}},"sv":{"stringUnit":{"state":"translated","value":"Inte nu"}},"th":{"stringUnit":{"state":"translated","value":"ไว้ทีหลัง"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi muna"}},"tr":{"stringUnit":{"state":"translated","value":"Şimdi değil"}},"uk":{"stringUnit":{"state":"translated","value":"Не зараз"}},"vi":{"stringUnit":{"state":"translated","value":"Để sau"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂不"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"稍後"}}}},
    "Not saved: {e}": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Не захавана: {e}"}},"ca":{"stringUnit":{"state":"translated","value":"No s'ha desat: {e}"}},"cs":{"stringUnit":{"state":"translated","value":"Neuloženo: {e}"}},"de":{"stringUnit":{"state":"translated","value":"Nicht gespeichert: {e}"}},"es":{"stringUnit":{"state":"translated","value":"No guardado: {e}"}},"fr":{"stringUnit":{"state":"translated","value":"Non enregistré : {e}"}},"hi":{"stringUnit":{"state":"translated","value":"सेव नहीं हुआ: {e}"}},"hu":{"stringUnit":{"state":"translated","value":"Nincs mentve: {e}"}},"id":{"stringUnit":{"state":"translated","value":"Tidak disimpan: {e}"}},"it":{"stringUnit":{"state":"translated","value":"Non salvato: {e}"}},"ja":{"stringUnit":{"state":"translated","value":"保存されませんでした：{e}"}},"ka":{"stringUnit":{"state":"translated","value":"ვერ შეინახა: {e}"}},"kk":{"stringUnit":{"state":"translated","value":"Сақталмады: {e}"}},"ko":{"stringUnit":{"state":"translated","value":"저장 안 됨: {e}"}},"ms":{"stringUnit":{"state":"translated","value":"Tidak disimpan: {e}"}},"nl":{"stringUnit":{"state":"translated","value":"Niet opgeslagen: {e}"}},"pl":{"stringUnit":{"state":"translated","value":"Nie zapisano: {e}"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não salvo: {e}"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Não gravado: {e}"}},"ru":{"stringUnit":{"state":"translated","value":"Не сохранено: {e}"}},"sr":{"stringUnit":{"state":"translated","value":"Nije sačuvano: {e}"}},"sv":{"stringUnit":{"state":"translated","value":"Inte sparat: {e}"}},"th":{"stringUnit":{"state":"translated","value":"ไม่ได้บันทึก: {e}"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi na-save: {e}"}},"tr":{"stringUnit":{"state":"translated","value":"Kaydedilmedi: {e}"}},"uk":{"stringUnit":{"state":"translated","value":"Не збережено: {e}"}},"vi":{"stringUnit":{"state":"translated","value":"Chưa lưu: {e}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未保存：{e}"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未儲存：{e}"}}}},
    "Notes in the top-left corner": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Avisos a la cantonada superior esquerra"}},"de":{"stringUnit":{"state":"translated","value":"Hinweise oben links"}},"es":{"stringUnit":{"state":"translated","value":"Avisos en la esquina superior izquierda"}},"fr":{"stringUnit":{"state":"translated","value":"Messages en haut à gauche"}},"ka":{"stringUnit":{"state":"translated","value":"შენიშვნები ზედა მარცხენა კუთხეში"}},"nl":{"stringUnit":{"state":"translated","value":"Meldingen linksboven"}},"pl":{"stringUnit":{"state":"translated","value":"Komunikaty w lewym górnym rogu"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Avisos no canto superior esquerdo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Avisos no canto superior esquerdo"}},"ru":{"stringUnit":{"state":"translated","value":"Заметки в левом верхнем углу"}},"sr":{"stringUnit":{"state":"translated","value":"Beleške u gornjem levom uglu"}},"sv":{"stringUnit":{"state":"translated","value":"Meddelanden i övre vänstra hörnet"}},"uk":{"stringUnit":{"state":"translated","value":"Нотатки у верхньому лівому куті"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"左上角的提示说明"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"註釋在左上角"}}}},
    "Nothing found": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"No s'ha trobat res"}},"de":{"stringUnit":{"state":"translated","value":"Nichts gefunden"}},"es":{"stringUnit":{"state":"translated","value":"No se ha encontrado nada"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun résultat"}},"ka":{"stringUnit":{"state":"translated","value":"არაფერი მოიძებნა"}},"nl":{"stringUnit":{"state":"translated","value":"Niets gevonden"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nada encontrado"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nada encontrado"}},"ru":{"stringUnit":{"state":"translated","value":"Ничего не найдено"}},"sr":{"stringUnit":{"state":"translated","value":"Ništa nije pronađeno"}},"sv":{"stringUnit":{"state":"translated","value":"Inget hittades"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"找不到結果"}}}},
    "Nothing installed since the launcher started. Big archives are checked against the free disk space before anything is unpacked; a cancelled or failed install leaves nothing behind.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"З моманту запуску лаўнчара нічога не ўсталявана. Вялікія архівы правяраюцца на вольнае месца на дыску перад распакаваннем; скасаваная ці няўдалая ўсталёўка нічога не пакідае."}},"ca":{"stringUnit":{"state":"translated","value":"No s'ha instal|lat res des que s'ha iniciat el launcher. Abans de descomprimir arxius grans es comprova l'espai lliure; una instal|lació cancel|lada o fallida no deixa restes."}},"cs":{"stringUnit":{"state":"translated","value":"Od spuštění launcheru nebylo nic nainstalováno. Velké archivy se před rozbalením zkontrolují proti volnému místu na disku; zrušená nebo selhaná instalace nic nezanechá."}},"de":{"stringUnit":{"state":"translated","value":"Seit dem Start des Launchers nichts installiert. Große Archive werden vor dem Entpacken mit dem freien Speicher verglichen; eine abgebrochene oder fehlgeschlagene Installation hinterlässt nichts."}},"es":{"stringUnit":{"state":"translated","value":"No se ha instalado nada desde que arrancó el lanzador. Los archivos grandes se comparan con el espacio libre en disco antes de descomprimir; una instalación cancelada o fallida no deja nada."}},"fr":{"stringUnit":{"state":"translated","value":"Rien d'installé depuis le lancement. Les grosses archives sont comparées à l'espace libre avant décompression ; une installation annulée ou échouée ne laisse rien."}},"hi":{"stringUnit":{"state":"translated","value":"लॉन्चर शुरू होने के बाद कुछ इंस्टॉल नहीं हुआ। बड़े आर्काइव खोलने से पहले खाली डिस्क स्पेस से जाँचे जाते हैं; रद्द या विफल इंस्टॉल कुछ भी पीछे नहीं छोड़ता।"}},"hu":{"stringUnit":{"state":"translated","value":"Az indító elindítása óta nem települt semmi. A nagy archívumokat kicsomagolás előtt ellenőrizzük, hogy van-e nekik elég szabad hely a lemezen; a megszakított vagy sikertelen telepítés semmit nem hagy a lemezen."}},"it":{"stringUnit":{"state":"translated","value":"Nulla installato dall'avvio del launcher. Gli archivi grandi vengono confrontati con lo spazio libero su disco prima di essere estratti; un'installazione annullata o fallita non lascia nulla."}},"ja":{"stringUnit":{"state":"translated","value":"ランチャー起動後にインストールしたものはありません。大きなアーカイブは、展開する前に空きディスク容量が確認されます。キャンセルまたは失敗したインストールは何も残しません。"}},"ka":{"stringUnit":{"state":"translated","value":"გამშვების გაშვების შემდეგ არაფერი დაყენებულა. დიდი არქივები გახსნამდე მოწმდება დისკზე თავისუფალ ადგილთან; გაუქმებული ან წარუმატებელი დაყენება კვალს არ ტოვებს."}},"kk":{"stringUnit":{"state":"translated","value":"Лаунчер іске қосылғаннан бері ештеңе орнатылған жоқ. Үлкен архивтер ашылмас бұрын бос диск орнына сәйкес тексеріледі; бас тартылған не сәтсіз орнату ештеңе қалдырмайды."}},"nl":{"stringUnit":{"state":"translated","value":"Sinds het starten van de launcher is niets geïnstalleerd. Grote archieven worden vóór het uitpakken getoetst aan de vrije schijfruimte; een geannuleerde of mislukte installatie laat niets achter."}},"pl":{"stringUnit":{"state":"translated","value":"Od uruchomienia launchera nic nie zainstalowano. Duże archiwa są sprawdzane pod kątem wolnego miejsca na dysku przed rozpakowaniem; anulowana lub nieudana instalacja niczego nie zostawia."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nada foi instalado desde que o launcher iniciou. Arquivos grandes são conferidos com o espaço livre em disco antes de descompactar; uma instalação cancelada ou com falha não deixa nada."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nada foi instalado desde que o launcher iniciou. Ficheiros grandes são conferidos com o espaço livre em disco antes de descompactar; uma instalação cancelada ou com falha não deixa nada."}},"ru":{"stringUnit":{"state":"translated","value":"С момента запуска лаунчера ничего не установлено. Большие архивы проверяются на свободное место перед распаковкой; отменённая или неудачная установка ничего не оставляет."}},"sr":{"stringUnit":{"state":"translated","value":"Ništa nije instalirano od pokretanja pokretača. Velike arhive se proveravaju u odnosu na slobodan prostor na disku pre nego što se bilo šta raspakuje; otkazana ili neuspela instalacija ne ostavlja ništa iza sebe."}},"sv":{"stringUnit":{"state":"translated","value":"Inget har installerats sedan startprogrammet startades. Stora arkiv kontrolleras mot ledigt diskutrymme innan något packas upp; en avbruten eller misslyckad installation lämnar inget kvar."}},"tr":{"stringUnit":{"state":"translated","value":"Başlatıcı açıldığından beri hiçbir şey kurulmadı. Büyük arşivler açılmadan önce boş disk alanına göre denetlenir; iptal edilen veya başarısız olan kurulum geride hiçbir şey bırakmaz."}},"uk":{"stringUnit":{"state":"translated","value":"Від запуску лаунчера нічого не встановлено. Великі архіви перевіряються на вільне місце на диску до розпакування; скасоване чи невдале встановлення нічого не залишає."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自启动器以来尚未安装任何内容。大型压缩包在解压前会检查可用磁盘空间;取消或失败的安装不会留下任何残留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自啟動器啟動以來尚未安裝任何內容。大型壓縮檔在解壓前會先檢查可用磁碟空間；取消或失敗的安裝不會留下任何殘留檔案。"}}}},
    "Nothing needed changing": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Нічога не спатрэбілася мяняць"}},"ca":{"stringUnit":{"state":"translated","value":"No ha calgut canviar res"}},"cs":{"stringUnit":{"state":"translated","value":"Nic nebylo třeba měnit"}},"de":{"stringUnit":{"state":"translated","value":"Es musste nichts geändert werden"}},"es":{"stringUnit":{"state":"translated","value":"No hizo falta cambiar nada"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun changement nécessaire"}},"hi":{"stringUnit":{"state":"translated","value":"कुछ बदलने की ज़रूरत नहीं पड़ी"}},"hu":{"stringUnit":{"state":"translated","value":"Semmit sem kellett módosítani"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada yang perlu diubah"}},"it":{"stringUnit":{"state":"translated","value":"Non è stato necessario cambiare nulla"}},"ja":{"stringUnit":{"state":"translated","value":"変更の必要はありませんでした"}},"ka":{"stringUnit":{"state":"translated","value":"შესაცვლელი არაფერი იყო"}},"kk":{"stringUnit":{"state":"translated","value":"Ештеңені өзгерту қажет болмады"}},"ko":{"stringUnit":{"state":"translated","value":"바꿀 필요가 없었습니다"}},"ms":{"stringUnit":{"state":"translated","value":"Tiada apa-apa yang perlu diubah"}},"nl":{"stringUnit":{"state":"translated","value":"Er hoefde niets te veranderen"}},"pl":{"stringUnit":{"state":"translated","value":"Nic nie trzeba było zmieniać"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi preciso mudar nada"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Não foi preciso mudar nada"}},"ru":{"stringUnit":{"state":"translated","value":"Ничего менять не потребовалось"}},"sr":{"stringUnit":{"state":"translated","value":"Nije bilo potrebno ništa menjati"}},"sv":{"stringUnit":{"state":"translated","value":"Inget behövde ändras"}},"th":{"stringUnit":{"state":"translated","value":"ไม่จำเป็นต้องเปลี่ยนอะไร"}},"fil":{"stringUnit":{"state":"translated","value":"Walang kinailangang baguhin"}},"tr":{"stringUn