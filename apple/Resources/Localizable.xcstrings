    "never": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"ніколі"}},"ca":{"stringUnit":{"state":"translated","value":"mai"}},"cs":{"stringUnit":{"state":"translated","value":"nikdy"}},"de":{"stringUnit":{"state":"translated","value":"nie"}},"es":{"stringUnit":{"state":"translated","value":"nunca"}},"fr":{"stringUnit":{"state":"translated","value":"jamais"}},"hi":{"stringUnit":{"state":"translated","value":"कभी नहीं"}},"hu":{"stringUnit":{"state":"translated","value":"soha"}},"id":{"stringUnit":{"state":"translated","value":"belum pernah"}},"it":{"stringUnit":{"state":"translated","value":"mai"}},"ja":{"stringUnit":{"state":"translated","value":"なし"}},"ka":{"stringUnit":{"state":"translated","value":"არასოდეს"}},"kk":{"stringUnit":{"state":"translated","value":"ешқашан"}},"ko":{"stringUnit":{"state":"translated","value":"없음"}},"ms":{"stringUnit":{"state":"translated","value":"tidak pernah"}},"nl":{"stringUnit":{"state":"translated","value":"nooit"}},"pl":{"stringUnit":{"state":"translated","value":"nigdy"}},"pt-BR":{"stringUnit":{"state":"translated","value":"nunca"}},"pt-PT":{"stringUnit":{"state":"translated","value":"nunca"}},"ru":{"stringUnit":{"state":"translated","value":"никогда"}},"sr":{"stringUnit":{"state":"translated","value":"nikad"}},"sv":{"stringUnit":{"state":"translated","value":"aldrig"}},"th":{"stringUnit":{"state":"translated","value":"ไม่เคย"}},"fil":{"stringUnit":{"state":"translated","value":"hindi pa"}},"tr":{"stringUnit":{"state":"translated","value":"hiç"}},"uk":{"stringUnit":{"state":"translated","value":"ніколи"}},"vi":{"stringUnit":{"state":"translated","value":"chưa bao giờ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从未"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"從未"}}}},
    "never within a year": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"ні разу на працягу года"}},"ca":{"stringUnit":{"state":"translated","value":"mai en un any"}},"cs":{"stringUnit":{"state":"translated","value":"během roku nikdy"}},"de":{"stringUnit":{"state":"translated","value":"innerhalb eines Jahres nie"}},"es":{"stringUnit":{"state":"translated","value":"nunca en un año"}},"fr":{"stringUnit":{"state":"translated","value":"jamais dans l'année"}},"hi":{"stringUnit":{"state":"translated","value":"एक साल में कभी नहीं"}},"hu":{"stringUnit":{"state":"translated","value":"egy éven belül soha"}},"id":{"stringUnit":{"state":"translated","value":"tidak pernah dalam setahun"}},"it":{"stringUnit":{"state":"translated","value":"mai entro un anno"}},"ja":{"stringUnit":{"state":"translated","value":"1年以内にはありません"}},"ka":{"stringUnit":{"state":"translated","value":"წლის განმავლობაში არასოდეს"}},"kk":{"stringUnit":{"state":"translated","value":"бір жыл ішінде жоқ"}},"ko":{"stringUnit":{"state":"translated","value":"1년 안에 없음"}},"ms":{"stringUnit":{"state":"translated","value":"tiada dalam setahun"}},"nl":{"stringUnit":{"state":"translated","value":"binnen een jaar nooit"}},"pl":{"stringUnit":{"state":"translated","value":"ani razu w ciągu roku"}},"pt-BR":{"stringUnit":{"state":"translated","value":"nunca em um ano"}},"pt-PT":{"stringUnit":{"state":"translated","value":"nunca num ano"}},"ru":{"stringUnit":{"state":"translated","value":"ни разу в течение года"}},"sr":{"stringUnit":{"state":"translated","value":"nikada u roku od godinu dana"}},"sv":{"stringUnit":{"state":"translated","value":"aldrig inom ett år"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีภายในหนึ่งปี"}},"fil":{"stringUnit":{"state":"translated","value":"hindi sa loob ng isang taon"}},"tr":{"stringUnit":{"state":"translated","value":"bir yıl içinde hiç"}},"uk":{"stringUnit":{"state":"translated","value":"жодного разу протягом року"}},"vi":{"stringUnit":{"state":"translated","value":"không chạy trong vòng một năm"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一年内不运行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一年內不行駛"}}}},
    "off": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"desactivat"}},"de":{"stringUnit":{"state":"translated","value":"aus"}},"es":{"stringUnit":{"state":"translated","value":"desactivado"}},"fr":{"stringUnit":{"state":"translated","value":"désactivé"}},"ka":{"stringUnit":{"state":"translated","value":"გამორთ."}},"pt-BR":{"stringUnit":{"state":"translated","value":"desligado"}},"pt-PT":{"stringUnit":{"state":"translated","value":"desligado"}},"ru":{"stringUnit":{"state":"translated","value":"выкл."}},"sr":{"stringUnit":{"state":"translated","value":"isključeno"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關閉"}}}},
    "on": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"activat"}},"de":{"stringUnit":{"state":"translated","value":"an"}},"es":{"stringUnit":{"state":"translated","value":"activado"}},"fr":{"stringUnit":{"state":"translated","value":"activé"}},"ka":{"stringUnit":{"state":"translated","value":"ჩართ."}},"pt-BR":{"stringUnit":{"state":"translated","value":"ligado"}},"pt-PT":{"stringUnit":{"state":"translated","value":"ligado"}},"ru":{"stringUnit":{"state":"translated","value":"вкл."}},"sr":{"stringUnit":{"state":"translated","value":"uključeno"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟"}}}},
    "openOMSI": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"openOMSI"}},"ca":{"stringUnit":{"state":"translated","value":"openOMSI"}},"cs":{"stringUnit":{"state":"translated","value":"openOMSI"}},"de":{"stringUnit":{"state":"translated","value":"openOMSI"}},"es":{"stringUnit":{"state":"translated","value":"openOMSI"}},"fr":{"stringUnit":{"state":"translated","value":"openOMSI"}},"hi":{"stringUnit":{"state":"translated","value":"openOMSI"}},"hu":{"stringUnit":{"state":"translated","value":"openOMSI"}},"it":{"stringUnit":{"state":"translated","value":"openOMSI"}},"ja":{"stringUnit":{"state":"translated","value":"openOMSI"}},"ka":{"stringUnit":{"state":"translated","value":"openOMSI"}},"kk":{"stringUnit":{"state":"translated","value":"openOMSI"}},"nl":{"stringUnit":{"state":"translated","value":"openOMSI"}},"pl":{"stringUnit":{"state":"translated","value":"openOMSI"}},"pt-BR":{"stringUnit":{"state":"translated","value":"openOMSI"}},"pt-PT":{"stringUnit":{"state":"translated","value":"openOMSI"}},"ru":{"stringUnit":{"state":"translated","value":"openOMSI"}},"sr":{"stringUnit":{"state":"translated","value":"openOMSI"}},"sv":{"stringUnit":{"state":"translated","value":"openOMSI"}},"tr":{"stringUnit":{"state":"translated","value":"openOMSI"}},"uk":{"stringUnit":{"state":"translated","value":"openOMSI"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"openOMSI"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"openOMSI"}}}},
    "openOMSI needs the whole OMSI 2 folder of your computer: the one with Omsi.exe, maps and Vehicles in it.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"openOMSI патрэбна ўся тэчка OMSI 2 з вашага камп'ютара: тая, дзе ляжаць Omsi.exe, maps і Vehicles."}},"ca":{"stringUnit":{"state":"translated","value":"openOMSI necessita la carpeta sencera d'OMSI 2 del teu ordinador: la que conté Omsi.exe, maps i Vehicles."}},"cs":{"stringUnit":{"state":"translated","value":"openOMSI potřebuje celou složku OMSI 2 z vašeho počítače: tu, ve které jsou Omsi.exe, maps a Vehicles."}},"de":{"stringUnit":{"state":"translated","value":"openOMSI braucht den ganzen OMSI-2-Ordner deines Computers: den mit Omsi.exe, maps und Vehicles darin."}},"es":{"stringUnit":{"state":"translated","value":"openOMSI necesita la carpeta completa de OMSI 2 de tu ordenador: la que contiene Omsi.exe, maps y Vehicles."}},"fr":{"stringUnit":{"state":"translated","value":"openOMSI a besoin du dossier OMSI 2 complet de votre ordinateur : celui qui contient Omsi.exe, maps et Vehicles."}},"hi":{"stringUnit":{"state":"translated","value":"openOMSI को आपके कंप्यूटर का पूरा OMSI 2 फ़ोल्डर चाहिए: वही जिसमें Omsi.exe, maps और Vehicles हों।"}},"hu":{"stringUnit":{"state":"translated","value":"Az openOMSI-nak a számítógéped teljes OMSI 2 mappája kell: az, amelyben az Omsi.exe, a maps és a Vehicles található."}},"id":{"stringUnit":{"state":"translated","value":"openOMSI memerlukan seluruh folder OMSI 2 dari komputer Anda: folder yang berisi Omsi.exe, maps, dan Vehicles."}},"it":{"stringUnit":{"state":"translated","value":"openOMSI ha bisogno dell'intera cartella di OMSI 2 del tuo computer: quella che contiene Omsi.exe, maps e Vehicles."}},"ja":{"stringUnit":{"state":"translated","value":"openOMSIにはパソコンのOMSI 2フォルダ全体が必要です。Omsi.exe、maps、Vehiclesが入っているフォルダです。"}},"ka":{"stringUnit":{"state":"translated","value":"openOMSI-ს სჭირდება თქვენი კომპიუტერის მთლიანი OMSI 2 საქაღალდე: ის, რომელშიც არის Omsi.exe, maps და Vehicles."}},"kk":{"stringUnit":{"state":"translated","value":"openOMSI-ге компьютеріңіздегі OMSI 2 қалтасы толығымен керек: ішінде Omsi.exe, maps және Vehicles бар қалта."}},"ko":{"stringUnit":{"state":"translated","value":"openOMSI에는 컴퓨터의 OMSI 2 폴더 전체가 필요합니다. Omsi.exe, maps, Vehicles가 들어 있는 폴더입니다."}},"ms":{"stringUnit":{"state":"translated","value":"openOMSI memerlukan keseluruhan folder OMSI 2 daripada komputer anda: folder yang mengandungi Omsi.exe, maps dan Vehicles."}},"nl":{"stringUnit":{"state":"translated","value":"openOMSI heeft de hele OMSI 2-map van je computer nodig: die met Omsi.exe, maps en Vehicles erin."}},"pl":{"stringUnit":{"state":"translated","value":"openOMSI potrzebuje całego folderu OMSI 2 z twojego komputera: tego, w którym są Omsi.exe, maps i Vehicles."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O openOMSI precisa da pasta inteira do OMSI 2 do seu computador: aquela com Omsi.exe, maps e Vehicles dentro."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O openOMSI precisa da pasta completa do OMSI 2 do seu computador: a que contém Omsi.exe, maps e Vehicles."}},"ru":{"stringUnit":{"state":"translated","value":"openOMSI нужна вся папка OMSI 2 с вашего компьютера: та, в которой лежат Omsi.exe, maps и Vehicles."}},"sr":{"stringUnit":{"state":"translated","value":"openOMSI zahteva celu fasciklu OMSI 2 sa vašeg računara: onu koja sadrži Omsi.exe, mape i vozila."}},"sv":{"stringUnit":{"state":"translated","value":"openOMSI behöver hela OMSI 2-mappen från din dator: den med Omsi.exe, maps och Vehicles i."}},"th":{"stringUnit":{"state":"translated","value":"openOMSI ต้องใช้โฟลเดอร์ OMSI 2 ทั้งโฟลเดอร์จากคอมพิวเตอร์ของคุณ คือโฟลเดอร์ที่มี Omsi.exe, maps และ Vehicles"}},"fil":{"stringUnit":{"state":"translated","value":"Kailangan ng openOMSI ang buong OMSI 2 folder ng iyong computer: ang may Omsi.exe, maps at Vehicles."}},"tr":{"stringUnit":{"state":"translated","value":"openOMSI'nin bilgisayarınızdaki OMSI 2 klasörünün tamamına ihtiyacı var: içinde Omsi.exe, maps ve Vehicles bulunan klasör."}},"uk":{"stringUnit":{"state":"translated","value":"openOMSI потрібна вся тека OMSI 2 з вашого комп'ютера: та, у якій є Omsi.exe, maps і Vehicles."}},"vi":{"stringUnit":{"state":"translated","value":"openOMSI cần toàn bộ thư mục OMSI 2 trên máy tính của bạn: thư mục chứa Omsi.exe, maps và Vehicles."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"openOMSI需要电脑上完整的OMSI 2文件夹：即包含Omsi.exe、maps和Vehicles的那个。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"openOMSI 需要電腦上完整的 OMSI 2 資料夾：也就是包含 Omsi.exe、maps 及 Vehicles 的那個。"}}}},
    "openOMSI plays the content of an OMSI 2 installation: the original game must be installed (Steam or another copy).": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"openOMSI fa servir el contingut d'una instal·lació d'OMSI 2: cal tenir el joc original instal·lat (Steam o una altra còpia)."}},"de":{"stringUnit":{"state":"translated","value":"openOMSI spielt die Inhalte einer OMSI-2-Installation: Das Originalspiel muss installiert sein (Steam oder eine andere Kopie)."}},"es":{"stringUnit":{"state":"translated","value":"openOMSI utiliza el contenido de una instalación de OMSI 2: el juego original debe estar instalado (Steam u otra copia)."}},"fr":{"stringUnit":{"state":"translated","value":"openOMSI utilise le contenu d'une installation d'OMSI 2 : le jeu original doit être installé (Steam ou une autre copie)."}},"ka":{"stringUnit":{"state":"translated","value":"openOMSI იყენებს OMSI 2-ის ინსტალაციის კონტენტს: ორიგინალი თამაში დაყენებული უნდა იყოს (Steam ან სხვა ასლი)."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O openOMSI joga o conteúdo de uma instalação do OMSI 2: o jogo original precisa estar instalado (Steam ou outra cópia)."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O openOMSI usa o conteúdo de uma instalação do OMSI 2: o jogo original tem de estar instalado (Steam ou outra cópia)."}},"ru":{"stringUnit":{"state":"translated","value":"openOMSI использует контент установленной OMSI 2: оригинальная игра должна быть установлена (Steam или другая копия)."}},"sr":{"stringUnit":{"state":"translated","value":"openOMSI reprodukuje sadržaj OMSI 2 instalacije: originalna igra mora biti instalirana (Steam ili druga kopija)."}},"sv":{"stringUnit":{"state":"translated","value":"openOMSI använder innehållet från en OMSI 2-installation: originalspelet måste vara installerat (Steam eller annan kopia)."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"openOMSI 使用 OMSI 2 的內容：必須先安裝原版遊戲（Steam 或其他版本）。"}}}},
    "openOMSI plays the content of your own copy of OMSI 2 (Steam or another copy): the game itself is not included.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"openOMSI выкарыстоўвае змесціва вашай уласнай копіі OMSI 2 (Steam або іншай): самой гульні ў камплекце няма."}},"ca":{"stringUnit":{"state":"translated","value":"openOMSI fa servir el contingut de la teva pròpia còpia d'OMSI 2 (de Steam o una altra): el joc en si no s'hi inclou."}},"cs":{"stringUnit":{"state":"translated","value":"openOMSI používá obsah vaší vlastní kopie OMSI 2 (Steam nebo jiná kopie): samotná hra není součástí aplikace."}},"de":{"stringUnit":{"state":"translated","value":"openOMSI nutzt die Inhalte deiner eigenen Kopie von OMSI 2 (Steam oder eine andere): Das Spiel selbst ist nicht enthalten."}},"es":{"stringUnit":{"state":"translated","value":"openOMSI usa el contenido de tu propia copia de OMSI 2 (de Steam u otra): el juego en sí no está incluido."}},"fr":{"stringUnit":{"state":"translated","value":"openOMSI utilise le contenu de votre propre copie d'OMSI 2 (Steam ou autre) : le jeu lui-même n'est pas inclus."}},"hi":{"stringUnit":{"state":"translated","value":"openOMSI आपकी अपनी OMSI 2 कॉपी (Steam या कोई और कॉपी) का कंटेंट चलाता है: गेम खुद इसमें शामिल नहीं है।"}},"hu":{"stringUnit":{"state":"translated","value":"Az openOMSI a saját OMSI 2 példányod tartalmát használja (Steam vagy más példány): maga a játék nincs benne."}},"id":{"stringUnit":{"state":"translated","value":"openOMSI menjalankan konten dari salinan OMSI 2 milik Anda sendiri (Steam atau salinan lain): gamenya sendiri tidak disertakan."}},"it":{"stringUnit":{"state":"translated","value":"openOMSI usa i contenuti della tua copia di OMSI 2 (Steam o un'altra): il gioco in sé non è incluso."}},"ja":{"stringUnit":{"state":"translated","value":"openOMSIはお持ちのOMSI 2（Steam版など）のコンテンツで動作します。ゲーム本体は含まれていません。"}},"ka":{"stringUnit":{"state":"translated","value":"openOMSI იყენებს თქვენი საკუთარი OMSI 2-ის ასლის კონტენტს (Steam ან სხვა ასლი): თავად თამაში არ შედის."}},"kk":{"stringUnit":{"state":"translated","value":"openOMSI өзіңіздегі OMSI 2 көшірмесінің мазмұнын пайдаланады (Steam немесе басқа көшірме): ойынның өзі құрамына кірмейді."}},"ko":{"stringUnit":{"state":"translated","value":"openOMSI는 사용자가 보유한 OMSI 2(Steam 또는 다른 버전)의 콘텐츠로 실행됩니다. 게임 자체는 포함되어 있지 않습니다."}},"ms":{"stringUnit":{"state":"translated","value":"openOMSI memainkan kandungan salinan OMSI 2 anda sendiri (Steam atau salinan lain): permainan itu sendiri tidak disertakan."}},"nl":{"stringUnit":{"state":"translated","value":"openOMSI gebruikt de inhoud van je eigen exemplaar van OMSI 2 (Steam of een ander exemplaar): het spel zelf zit er niet bij."}},"pl":{"stringUnit":{"state":"translated","value":"openOMSI korzysta z zawartości twojej własnej kopii OMSI 2 (Steam lub inna kopia): sama gra nie jest dołączona."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O openOMSI roda o conteúdo da sua própria cópia do OMSI 2 (Steam ou outra): o jogo em si não está incluído."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O openOMSI executa o conteúdo da sua própria cópia do OMSI 2 (Steam ou outra): o jogo em si não está incluído."}},"ru":{"stringUnit":{"state":"translated","value":"openOMSI использует контент вашей собственной копии OMSI 2 (Steam или другой): сама игра не входит в комплект."}},"sr":{"stringUnit":{"state":"translated","value":"openOMSI reprodukuje sadržaj vaše sopstvene kopije OMSI 2 (Steam ili druga kopija): sama igra nije uključena."}},"sv":{"stringUnit":{"state":"translated","value":"openOMSI använder innehållet från ditt eget exemplar av OMSI 2 (Steam eller ett annat): själva spelet ingår inte."}},"th":{"stringUnit":{"state":"translated","value":"openOMSI ใช้เนื้อหาจาก OMSI 2 ที่คุณมีอยู่เอง (Steam หรือแหล่งอื่น) ตัวเกมไม่ได้รวมมาด้วย"}},"fil":{"stringUnit":{"state":"translated","value":"Pinapatakbo ng openOMSI ang content ng sarili mong kopya ng OMSI 2 (Steam o ibang kopya): hindi kasama ang mismong laro."}},"tr":{"stringUnit":{"state":"translated","value":"openOMSI, kendi OMSI 2 kopyanızın içeriğini kullanır (Steam veya başka bir kopya): oyunun kendisi dahil değildir."}},"uk":{"stringUnit":{"state":"translated","value":"openOMSI використовує вміст вашої власної копії OMSI 2 (Steam чи іншої): саму гру не включено."}},"vi":{"stringUnit":{"state":"translated","value":"openOMSI chạy nội dung từ bản OMSI 2 của chính bạn (Steam hoặc bản khác): không bao gồm trò chơi."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"openOMSI运行的是你自己的OMSI 2副本（Steam版或其他版本）中的内容：不包含游戏本身。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"openOMSI 執行的是你自己的 OMSI 2（Steam 版或其他版本）中的內容：不包含遊戲本體。"}}}},
