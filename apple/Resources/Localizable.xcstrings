    "{name} and its files are deleted from the content folder. Switch it off instead to keep it.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Se suprimeixen {name} i els seus fitxers de la carpeta de contingut. Si els vols conservar, desactiva'l."}},"de":{"stringUnit":{"state":"translated","value":"{name} und seine Dateien werden aus dem Inhaltsordner gelöscht. Schalte ihn stattdessen aus, um ihn zu behalten."}},"es":{"stringUnit":{"state":"translated","value":"Se eliminarán {name} y sus archivos de la carpeta de contenido. Desactívalo si quieres conservarlo."}},"fr":{"stringUnit":{"state":"translated","value":"{name} et ses fichiers sont supprimés du dossier de contenu. Désactivez-le plutôt pour le garder."}},"ka":{"stringUnit":{"state":"translated","value":"{name} და მისი ფაილები წაიშლება კონტენტის საქაღალდიდან. შესანარჩუნებლად ჯობს გამორთოთ."}},"pt-BR":{"stringUnit":{"state":"translated","value":"{name} e seus arquivos são excluídos da pasta de conteúdo. Desative-o se quiser mantê-lo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"{name} e os seus ficheiros são eliminados da pasta de conteúdo. Desative-o em vez disso para o manter."}},"ru":{"stringUnit":{"state":"translated","value":"{name} и его файлы будут удалены из папки контента. Чтобы сохранить мод, просто отключите его."}},"sr":{"stringUnit":{"state":"translated","value":"{name} i njegove datoteke se brišu iz fascikle sa sadržajem. Umesto toga, isključite ga da biste ga zadržali."}},"sv":{"stringUnit":{"state":"translated","value":"{name} och dess filer tas bort från innehållsmappen. Stäng av den i stället för att behålla den."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將從內容資料夾刪除 {name} 及其檔案。若要保留檔案，請改為停用。"}}}},
    "{name} is ready under Drive: choose the time and the duty.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"{name} гатовы ў раздзеле «Кіраванне»: выберыце час і змену."}},"ca":{"stringUnit":{"state":"translated","value":"{name} és a punt a Conduir: tria l'hora i el servei."}},"cs":{"stringUnit":{"state":"translated","value":"{name} je připraven v části Jízda: vyber čas a službu."}},"de":{"stringUnit":{"state":"translated","value":"{name} steht unter Fahren bereit: Wähle Uhrzeit und Dienst."}},"es":{"stringUnit":{"state":"translated","value":"{name} está listo en Conducir: elige la hora y el servicio."}},"fr":{"stringUnit":{"state":"translated","value":"{name} vous attend dans Conduire : choisissez l’heure et le service."}},"hi":{"stringUnit":{"state":"translated","value":"{name} ड्राइव में तैयार है: समय और ड्यूटी चुनें।"}},"hu":{"stringUnit":{"state":"translated","value":"{name} készen áll a Vezetés oldalon: válaszd ki az időt és a szolgálatot."}},"id":{"stringUnit":{"state":"translated","value":"{name} siap di Mengemudi: pilih waktu dan tugasnya."}},"it":{"stringUnit":{"state":"translated","value":"{name} è pronto in Guida: scegli l’orario e il servizio."}},"ja":{"stringUnit":{"state":"translated","value":"{name} の準備ができました。「運転」で時刻と勤務を選んでください。"}},"ka":{"stringUnit":{"state":"translated","value":"{name} მზადაა „მართვაში“: აირჩიეთ დრო და რეისი."}},"kk":{"stringUnit":{"state":"translated","value":"{name} «Жүргізу» бөлімінде дайын: уақыт пен ауысымды таңдаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"{name} 준비 완료: 운전에서 시간과 근무를 고르세요."}},"ms":{"stringUnit":{"state":"translated","value":"{name} sedia di Memandu: pilih masa dan tugasnya."}},"nl":{"stringUnit":{"state":"translated","value":"{name} staat klaar onder Rijden: kies de tijd en de dienst."}},"pl":{"stringUnit":{"state":"translated","value":"{name} czeka w zakładce Jazda: wybierz godzinę i służbę."}},"pt-BR":{"stringUnit":{"state":"translated","value":"{name} está pronto em Dir