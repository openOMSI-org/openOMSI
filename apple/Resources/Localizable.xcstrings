    "Star a bus to find it here.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Afegeix un autobús als preferits per trobar-lo aquí."}},"de":{"stringUnit":{"state":"translated","value":"Markiere einen Bus, um ihn hier zu finden."}},"es":{"stringUnit":{"state":"translated","value":"Marca un autobús como favorito para encontrarlo aquí."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez un bus en favori pour le retrouver ici."}},"ka":{"stringUnit":{"state":"translated","value":"მონიშნეთ ავტობუსი რჩეულად, რომ აქ იპოვოთ."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Favorite um ônibus para encontrá-lo aqui."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Marque um autocarro como favorito para o encontrar aqui."}},"ru":{"stringUnit":{"state":"translated","value":"Отметьте автобус звёздочкой, чтобы найти его здесь."}},"sr":{"stringUnit":{"state":"translated","value":"Označite autobus da biste ga pronašli ovde."}},"sv":{"stringUnit":{"state":"translated","value":"Markera en buss som favorit för att hitta den här."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"為巴士加上星號後，即可在此找到。"}}}},
