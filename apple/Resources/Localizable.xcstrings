    "Some map HOF files could not be added. Check launcher.log for details.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Не ўдалося дадаць некаторыя HOF-файлы карты. Падрабязнасці глядзіце ў launcher.log."}},"ca":{"stringUnit":{"state":"translated","value":"No s'han pogut afegir alguns fitxers HOF del mapa. Consulta launcher.log per veure'n els detalls."}},"cs":{"stringUnit":{"state":"translated","value":"Některé soubory HOF mapy se nepodařilo přidat. Podrobnosti najdete v launcher.log."}},"de":{"stringUnit":{"state":"translated","value":"Einige HOF-Dateien der Karte konnten nicht hinzugefügt werden. Details stehen in launcher.log."}},"es":{"stringUnit":{"state":"translated","value":"No se pudieron añadir algunos archivos HOF del mapa. Consulta launcher.log para ver los detalles."}},"fr":{"stringUnit":{"state":"translated","value":"Certains fichiers HOF de la carte n'ont pas pu être ajoutés. Consultez launcher.log pour les détails."}},"hi":{"stringUnit":{"state":"translated","value":"मैप की कुछ HOF फ़ाइलें नहीं जोड़ी जा सकीं। विवरण के लिए launcher.log देखें।"}},"hu":{"stringUnit":{"state":"translated","value":"Néhány térképhez tartozó HOF-fájlt nem sikerült hozzáadni. Részletek a launcher.log fájlban."}},"id":{"stringUnit":{"state":"translated","value":"Beberapa file HOF peta tidak dapat ditambahkan. Lihat launcher.log untuk detailnya."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile aggiungere alcuni file HOF della mappa. Consulta launcher.log per i dettagli."}},"ja":{"stringUnit":{"state":"translated","value":"一部のマップHOFファイルを追加できませんでした。詳細はlauncher.logを確認してください。"}},"ka":{"stringUnit":{"state":"translated","value":"რუკის ზოგიერთი HOF ფაილის დამატება ვერ მოხერხდა. დეტალებისთვის იხილეთ launcher.log."}},"kk":{"stringUnit":{"state":"translated","value":"Картаның кейбір HOF файлдарын қосу мүмкін болмады. Толығырақ launcher.log файлында."}},"ko":{"stringUnit":{"state":"translated","value":"일부 맵 HOF 파일을 추가하지 못했습니다. 자세한 내용은 launcher.log를 확인하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Beberapa fail HOF peta tidak dapat ditambah. Lihat launcher.log untuk butiran."}},"nl":{"stringUnit":{"state":"translated","value":"Sommige HOF-bestanden van de kaart konden niet worden toegevoegd. Bekijk launcher.log voor details."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się dodać niektórych plików HOF mapy. Szczegóły znajdziesz w launcher.log."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível adicionar alguns arquivos HOF do mapa. Consulte launcher.log para ver os detalhes."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Não foi possível adicionar alguns ficheiros HOF do mapa. Consulte launcher.log para ver os detalhes."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось добавить некоторые файлы HOF карты. Подробности см. в launcher.log."}},"sr":{"stringUnit":{"state":"translated","value":"Neke HOF datoteke mape nisu mogle da se dodaju. Više detalja potražite u datoteci launcher.log."}},"sv":{"stringUnit":{"state":"translated","value":"Vissa HOF-filer för kartan kunde inte läggas till. Se launcher.log för mer information."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเพิ่มไฟล์ HOF ของแผนที่บางไฟล์ได้ ดูรายละเอียดใน launcher.log"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi naidagdag ang ilang HOF file ng mapa. Tingnan ang launcher.log para sa mga detalye."}},"tr":{"stringUnit":{"state":"translated","value":"Bazı harita HOF dosyaları eklenemedi. Ayrıntılar için launcher.log dosyasına bakın."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося додати деякі HOF-файли карти. Подробиці див. у launcher.log."}},"vi":{"stringUnit":{"state":"translated","value":"Không thể thêm một số tệp HOF của bản đồ. Xem launcher.log để biết chi tiết."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法添加部分地图 HOF 文件。详情请查看 launcher.log。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"部分地圖 HOF 