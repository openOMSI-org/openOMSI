    "Timetable buses ahead of time wait only at timed stops": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Рэйсавыя аўтобусы з апярэджаннем чакаюць толькі на прыпынках з часам"}},"ca":{"stringUnit":{"state":"translated","value":"Els autobusos d'horari avançats només esperen a les parades amb hora"}},"cs":{"stringUnit":{"state":"translated","value":"Spoje v předstihu čekají jen na zastávkách s časem"}},"de":{"stringUnit":{"state":"translated","value":"Fahrplanbusse vor der Zeit warten nur an Haltestellen mit eigener Zeit"}},"es":{"stringUnit":{"state":"translated","value":"Los autobuses adelantados solo esperan en las paradas con hora"}},"fr":{"stringUnit":{"state":"translated","value":"Les bus en avance n'attendent qu'aux arrêts horaires"}},"hi":{"stringUnit":{"state":"translated","value":"समय से पहले चल रही समय-सारणी बसें केवल समय वाले स्टॉप पर रुककर इंतज़ार करती हैं"}},"hu":{"stringUnit":{"state":"translated","value":"A menetrend előtt járó buszok csak az időponttal megadott megállókban várnak"}},"id":{"stringUnit":{"state":"translated","value":"Bus jadwal yang lebih awal hanya menunggu di halte berwaktu"}},"it":{"stringUnit":{"state":"translated","value":"Gli autobus in anticipo attendono solo alle fermate con orario"}},"ja":{"stringUnit":{"state":"translated","value":"早着した時刻表バスは時刻指定のある停留所でのみ待つ"}},"ka":{"stringUnit":{"state":"translated","value":"დროზე ადრე მოსული განრიგის ავტობუსები მხოლოდ დროით გაჩერებებზე ელოდებიან"}},"kk":{"stringUnit":{"state":"translated","value":"Кестеден озған автобустар тек уақыты бар аялдамаларда күтеді"}},"ko":{"stringUnit":{"state":"translated","value":"시간표보다 이른 버스는 시각이 정해진 정류장에서만 기다림"}},"ms":{"stringUnit":{"state":"translated","value":"Bas jadual yang awal hanya menunggu di hentian yang bermasa"}},"nl":{"stringUnit":{"state":"translated","value":"Dienstregelingbussen die te vroeg zijn wachten alleen bij haltes met een tijd"}},"pl":{"stringUnit":{"state":"translated","value":"Autobusy rozkładowe przed czasem czekają tylko na przystankach z godziną"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ônibus adiantados só esperam nos pontos com horário"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Autocarros adiantados só esperam nas paragens com horário"}},"ru":{"stringUnit":{"state":"translated","value":"Рейсовые автобусы с опережением ждут только на остановках со временем"}},"sr":{"stringUnit":{"state":"translated","value":"Autobusi unapred čekaju samo na vremenskim stajalištima"}},"sv":{"stringUnit":{"state":"translated","value":"Tidiga tidtabellsbussar väntar endast vid reglerhållplatser"}},"th":{"stringUnit":{"state":"translated","value":"รถเมล์ตามตารางที่มาก่อนเวลารอเฉพาะป้ายที่มีเวลากำหนด"}},"fil":{"stringUnit":{"state":"translated","value":"Ang mga bus na mas maaga sa iskedyul ay naghihintay lamang sa mga hintuang may oras"}},"tr":{"stringUnit":{"state":"translated","value":"Erken gelen tarifeli otobüsler yalnızca saatli duraklarda bekler"}},"uk":{"stringUnit":{"state":"translated","value":"Рейсові автобуси з випередженням чекають лише на зупинках із часом"}},"vi":{"stringUnit":{"state":"translated","value":"Xe buýt theo lịch đến sớm chỉ chờ ở các trạm có giờ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提前的时刻表公交只在有时刻的车站等候"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提前的時刻表公車只在有時刻的站牌等候"}}}},
