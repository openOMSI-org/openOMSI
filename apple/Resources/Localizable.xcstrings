    "Set visibility, wind, clouds, rain, temperature and road state": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Наладзьце бачнасць, вецер, хмары, дождж, тэмпературу і стан дарогі"}},"ca":{"stringUnit":{"state":"translated","value":"Ajusta la visibilitat, el vent, els núvols, la pluja, la temperatura i l'estat de la carretera"}},"cs":{"stringUnit":{"state":"translated","value":"Nastavte viditelnost, vítr, oblaka, déšť, teplotu a stav silnice"}},"de":{"stringUnit":{"state":"translated","value":"Sichtweite, Wind, Wolken, Regen, Temperatur und Straßenzustand einstellen"}},"es":{"stringUnit":{"state":"translated","value":"Ajusta la visibilidad, el viento, las nubes, la lluvia, la temperatura y el estado de la carretera"}},"fr":{"stringUnit":{"state":"translated","value":"Réglez la visibilité, le vent, les nuages, la pluie, la température et l'état de la route"}},"hi":{"stringUnit":{"state":"translated","value":"दृश्यता, हवा, बादल, बारिश, तापमान और सड़क की स्थिति तय करें"}},"hu":{"stringUnit":{"state":"translated","value":"Állítsa be a látótávolságot, a szelet, a felhőzetet, az esőt, a hőmérsékletet és az út állapotát"}},"id":{"stringUnit":{"state":"translated","value":"Atur jarak pandang, angin, awan, hujan, suhu, dan kondisi jalan"}},"it":{"stringUnit":{"state":"translated","value":"Imposta visibilità, vento, nuvole, pioggia, temperatura e stato della strada"}},"ja":{"stringUnit":{"state":"translated","value":"視程、風、雲、雨、気温、路面の状態を設定します"}},"ka":{"stringUnit":{"state":"translated","value":"დააყენეთ ხილვადობა, ქარი, ღრუბლები, წვიმა, ტემპერატურა და გზის მდგომარეობა"}},"kk":{"stringUnit":{"state":"translated","value":"Көріну қашықтығын, желді, бұлттарды, жаңбырды, температураны және жол жағдайын баптаңыз"}},"ko":{"stringUnit":{"state":"translated","value":"가시거리, 바람, 구름, 비, 기온과 노면 상태를 설정합니다"}},"ms":{"stringUnit":{"state":"translated","value":"Tetapkan jarak penglihatan, angin, awan, hujan, suhu dan keadaan jalan"}},"nl":{"stringUnit":{"state":"translated","value":"Stel zichtbaarheid, wind, wolken, regen, temperatuur en wegtoestand in"}},"pl":{"stringUnit":{"state":"translated","value":"Ustaw widoczność, wiatr, chmury, deszcz, temperaturę i stan drogi"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ajustar visibilidade, vento, nuvens, chuva, temperatura e estado da pista"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ajustar visibilidade, vento, nuvens, chuva, temperatura e estado da estrada"}},"ru":{"stringUnit":{"state":"translated","value":"Настройте видимость, ветер, облака, дождь, температуру и состояние дороги"}},"sr":{"stringUnit":{"state":"translated","value":"Podesite vidljivost, vetar, oblake, kišu, temperaturu i stanje puta"}},"sv":{"stringUnit":{"state":"translated","value":"Ställ in sikt, vind, moln, regn, temperatur och vägens skick"}},"th":{"stringUnit":{"state":"translated","value":"ตั้งค่าทัศนวิสัย ลม เมฆ ฝน อุณหภูมิ และสภาพถนน"}},"fil":{"stringUnit":{"state":"translated","value":"Itakda ang tanaw, hangin, ulap, ulan, temperatura at kalagayan ng kalsada"}},"tr":{"stringUnit":{"state":"translated","value":"Görüş mesafesini, rüzgârı, bulutları, yağmuru, sıcaklığı ve yol durumunu ayarlayın"}},"uk":{"stringUnit":{"state":"translated","value":"Налаштуйте видимість, вітер, хмари, дощ, температуру й стан дороги"}},"vi":{"stringUnit":{"state":"translated","value":"Đặt tầm nhìn, gió, mây, mưa, nhiệt độ và tình trạng mặt đường"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设置能见度、风、云量、降雨、温度和路况"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"設定能見度、風、雲、雨、溫度和路況"}}}},
    "Sets the cabin to {temperature} when starting a drive.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Усталёўвае ў салоне {temperature} у пачатку паездкі."}},"ca":{"stringUnit":{"state":"translated","value":"Estableix la temperatura interior a {temperature} en començar a conduir."}},"cs":{"stringUnit":{"state":"translated","value":"Na začátku jízdy nastaví teplotu v interiéru na {temperature}."}},"de":{"stringUnit":{"state":"translated","value":"Setzt die Innenraumtemperatur zu Fahrtbeginn auf {temperature}."}},"es":{"stringUnit":{"state":"translated","value":"Establece la temperatura interior en {temperature} al empezar a conducir."}},"fr":{"stringUnit":{"state":"translated","value":"Règle la température intérieure à {temperature} au début de la conduite."}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइव शुरू करते समय अंदर का तापमान {temperature} पर सेट करता है। डिपो से प्रस्थान का अनुकरण करने के लिए ड्यूटी की पहली यात्रा में सामान्य तापमान बना रहता है।."}},"hu":{"stringUnit":{"state":"translated","value":"Az indítás után a hőmérséklet {temperature}-ra van állítva."}},"id":{"stringUnit":{"state":"translated","value":"Mengatur suhu kabin ke {temperature} saat mulai berkendara."}},"it":{"stringUnit":{"state":"translated","value":"Imposta la temperatura interna a {temperature} quando inizi a guidare."}},"ja":{"stringUnit":{"state":"translated","value":"運転開始時の車内温度を{temperature}に設定します。"}},"ka":{"stringUnit":{"state":"translated","value":"მართვის დაწყებისას სალონის ტემპერატურას {temperature}-ზე აყენებს."}},"kk":{"stringUnit":{"state":"translated","value":"Жүрісті бастағанда салон температурасын {temperature}-қа орнатады."}},"ko":{"stringUnit":{"state":"translated","value":"주행 시작 시 실내 온도를 {temperature}로 설정합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Menetapkan suhu kabin kepada {temperature} apabila mula memandu."}},"nl":{"stringUnit":{"state":"translated","value":"Stelt de binnentemperatuur bij aanvang van de rit in op {temperature}."}},"pl":{"stringUnit":{"state":"translated","value":"Ustawia temperaturę wewnątrz na {temperature} na początku jazdy."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Define a temperatura interna como {temperature} ao iniciar a condução."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Define a temperatura interior para {temperature} ao começar a conduzir."}},"ru":{"stringUnit":{"state":"translated","value":"Устанавливает в салоне {temperature} в начале поездки."}},"sr":{"stringUnit":{"state":"translated","value":"Postavlja temperaturu u kabini na {temperature} na početku vožnje."}},"sv":{"stringUnit":{"state":"translated","value":"Ställer in kupétemperaturen på {temperature} när körningen börjar."}},"th":{"stringUnit":{"state":"translated","value":"ตั้งอุณหภูมิภายในรถเป็น {temperature} เมื่อเริ่มขับ"}},"fil":{"stringUnit":{"state":"translated","value":"Itinatakda ang temperatura sa loob sa {temperature} sa pagsisimula ng pagmamaneho."}},"tr":{"stringUnit":{"state":"translated","value":"Sürüş başlangıcında iç sıcaklığı {temperature} olarak ayarlar."}},"uk":{"stringUnit":{"state":"translated","value":"Установлює в салоні {temperature} на початку поїздки."}},"vi":{"stringUnit":{"state":"translated","value":"Đặt nhiệt độ trong xe ở mức {temperature} khi bắt đầu lái."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始驾驶时将车内温度设为{temperature}。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開始駕駛時將車內溫度設為{temperature}。"}}}},
