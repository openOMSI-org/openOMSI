    "90 fps": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"90 fps"}},"ca":{"stringUnit":{"state":"translated","value":"90 fps"}},"cs":{"stringUnit":{"state":"translated","value":"90 fps"}},"de":{"stringUnit":{"state":"translated","value":"90 fps"}},"es":{"stringUnit":{"state":"translated","value":"90 fps"}},"fr":{"stringUnit":{"state":"translated","value":"90 fps"}},"hi":{"stringUnit":{"state":"translated","value":"90 fps"}},"hu":{"stringUnit":{"state":"translated","value":"90 fps"}},"id":{"stringUnit":{"state":"translated","value":"90 fps"}},"it":{"stringUnit":{"state":"translated","value":"90 fps"}},"ja":{"stringUnit":{"state":"translated","value":"90 fps"}},"ka":{"stringUnit":{"state":"translated","value":"90 fps"}},"kk":{"stringUnit":{"state":"translated","value":"90 fps"}},"ko":{"stringUnit":{"state":"translated","value":"90 fps"}},"ms":{"stringUnit":{"state":"translated","value":"90 fps"}},"nl":{"stringUnit":{"state":"translated","value":"90 fps"}},"pl":{"stringUnit":{"state":"translated","value":"90 fps"}},"pt-BR":{"stringUnit":{"state":"translated","value":"90 fps"}},"pt-PT":{"stringUnit":{"state":"translated","value":"90 fps"}},"ru":{"stringUnit":{"state":"translated","value":"90 fps"}},"sr":{"stringUnit":{"state":"translated","value":"90 fps"}},"sv":{"stringUnit":{"state":"translated","value":"90 fps"}},"th":{"stringUnit":{"state":"translated","value":"90 fps"}},"fil":{"stringUnit":{"state":"translated","value":"90 fps"}},"tr":{"stringUnit":{"state":"translated","value":"90 fps"}},"uk":{"stringUnit":{"state":"translated","value":"90 fps"}},"vi":{"stringUnit":{"state":"translated","value":"90 fps"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"90 fps"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"90 fps"}}}},
    "A bus, a map, scenery, a whole OMSI folder - as a folder or a .zip, .7z or .rar. The original OMSI 2 folder is never written to.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Аўтобус, мапа, дэкарацыі, цэлая тэчка OMSI - тэчкамі або як .zip/.7z/.rar. У арыгінальную тэчку OMSI 2 нічога не запісваецца."}},"ca":{"stringUnit":{"state":"translated","value":"Un autobús, un mapa, elements de l'entorn o una carpeta d'OMSI sencera, com a carpeta o fitxer .zip, .7z o .rar. La carpeta original d'OMSI 2 no es modifica mai."}},"cs":{"stringUnit":{"state":"translated","value":"Autobus, mapa, scenérie, celá složka OMSI - jako složka nebo .zip/.7z/.rar. Do originální složky OMSI 2 se nikdy nezapisuje."}},"de":{"stringUnit":{"state":"translated","value":"Ein Bus, eine Karte, Szenerie, ein ganzer OMSI-Ordner - als Ordner oder .zip/.7z/.rar. In den originalen OMSI-2-Ordner wird nie geschrieben."}},"es":{"stringUnit":{"state":"translated","value":"Un autobús, un mapa, un escenario, una carpeta OMSI entera: como carpeta o como .zip/.7z/.rar. La carpeta del OMSI 2 original nunca se modifica."}},"fr":{"stringUnit":{"state":"translated","value":"Un bus, une carte, des décors, tout un dossier OMSI - en dossier ou en .zip/.7z/.rar. Le dossier original OMSI 2 n'est jamais modifié."}},"hi":{"stringUnit":{"state":"translated","value":"एक बस, मैप, दृश्य, या पूरा OMSI फ़ोल्डर - फ़ोल्डर या .zip/.7z/.rar के रूप में। ओरिजिनल OMSI 2 फ़ोल्डर में कभी कुछ नहीं लिखा जाता।"}},"hu":{"stringUnit":{"state":"translated","value":"Busz, térkép, objektumok, egy teljes OMSI mappa - mappaként vagy .zip/.7z/.rar fájlként. Az eredeti OMSI 2 mappád érintetlen marad."}},"id":{"stringUnit":{"state":"translated","value":"Tambahkan bus, peta, objek, atau seluruh folder OMSI sebagai folder atau .zip/.7z/.rar. Folder OMSI 2 asli tidak pernah ditulis."}},"it":{"stringUnit":{"state":"translated","value":"Un bus, una mappa, uno scenario, un'intera cartella OMSI - come cartella o .zip/.7z/.rar. La cartella dell'OMSI 2 originale non viene mai modificata."}},"ja":{"stringUnit":{"state":"translated","value":"バス、マップ、風景、OMSIフォルダ丸ごと - フォルダまたは.zip/.7z/.rarで。元のOMSI 2フォルダには一切書き込みません。"}},"ka":{"stringUnit":{"state":"translated","value":"ავტობუსი, რუკა, დეკორაციები, მთელი OMSI საქაღალდე - საქაღალდის ან .zip, .7z ან .rar სახით. OMSI 2-ის ორიგინალ საქაღალდეში არაფერი იწერება."}},"kk":{"stringUnit":{"state":"translated","value":"Автобус, карта, декорация, тұтас OMSI қалтасы - қалта немесе .zip/.7z/.rar ретінде. Түпнұсқа OMSI 2 қалтасына ешқашан жазылмайды."}},"ko":{"stringUnit":{"state":"translated","value":"버스, 지도, 오브젝트 또는 전체 OMSI 폴더를 폴더나 .zip/.7z/.rar로 추가할 수 있습니다. 원본 OMSI 2 폴더에는 절대 쓰지 않습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Tambah bas, peta, objek atau seluruh folder OMSI sebagai folder atau .zip/.7z/.rar. Folder OMSI 2 asal tidak pernah ditulis."}},"nl":{"stringUnit":{"state":"translated","value":"Een bus, een kaart, een landschap, een hele OMSI-map - als map of .zip/.7z/.rar. In de map van de originele OMSI 2 wordt nooit geschreven."}},"pl":{"stringUnit":{"state":"translated","value":"Autobus, mapa, sceneria, cały folder OMSI - jako folder lub .zip/.7z/.rar. Do oryginalnego folderu OMSI 2 nic nie jest zapisywane."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um ônibus, um mapa, um cenário, uma pasta OMSI inteira: como pasta ou como .zip/.7z/.rar. A pasta do OMSI 2 original nunca é alterada."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Um autocarro, um mapa, um cenário, uma pasta OMSI inteira: como pasta ou como .zip/.7z/.rar. A pasta do OMSI 2 original nunca é alterada."}},"ru":{"stringUnit":{"state":"translated","value":"Автобус, карта, объекты, целая папка OMSI - папкой или .zip/.7z/.rar. В папку оригинальной OMSI 2 ничего не пишется."}},"sr":{"stringUnit":{"state":"translated","value":"Autobus, mapa, pejzaž, ceo OMSI folder - kao fascikla ili .zip, .7z ili .rar. U originalnu fasciklu OMSI 2 se nikada ne upisuje."}},"sv":{"stringUnit":{"state":"translated","value":"En buss, en karta, landskapsobjekt, en hel OMSI-mapp – som mapp eller .zip, .7z eller .rar. Den ursprungliga OMSI 2-mappen ändras aldrig."}},"th":{"stringUnit":{"state":"translated","value":"เพิ่มรถบัส แผนที่ ฉาก หรือโฟลเดอร์ OMSI ทั้งชุดได้ทั้งแบบโฟลเดอร์หรือ .zip/.7z/.rar โดยจะไม่เขียนลงในโฟลเดอร์ OMSI 2 ต้นฉบับ"}},"fil":{"stringUnit":{"state":"translated","value":"Magdagdag ng bus, mapa, scenery, o buong OMSI folder bilang folder o .zip/.7z/.rar. Hindi susulatan ang orihinal na OMSI 2 folder."}},"tr":{"stringUnit":{"state":"translated","value":"Bir otobüs, harita, manzara, tüm bir OMSI klasörü - klasör veya .zip/.7z/.rar olarak. Orijinal OMSI 2 klasörüne asla yazılmaz."}},"uk":{"stringUnit":{"state":"translated","value":"Автобус, мапа, декорації, ціла тека OMSI - теками або як .zip/.7z/.rar. В оригінальну теку OMSI 2 нічого не записується."}},"vi":{"stringUnit":{"state":"translated","value":"Thêm xe buýt, bản đồ, cảnh quan hoặc cả thư mục OMSI dưới dạng thư mục hoặc .zip/.7z/.rar. Không bao giờ ghi vào thư mục OMSI 2 gốc."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"巴士、地图、场景、整个OMSI文件夹--以文件夹或.zip/.7z/.rar形式。绝不会写入原版OMSI 2文件夹。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"巴士、地圖、景觀、整個 OMSI 資料夾--可為資料夾或 .zip/.7z/.rar 格式。絕不會寫入原版 OMSI 2 資料夾。"}}}},
    "A departure is not a time (h:mm).": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Адпраўленне - гэта не час (г:хх)."}},"ca":{"stringUnit":{"state":"translated","value":"Una sortida no té un format d'hora vàlid (h:mm)."}},"cs":{"stringUnit":{"state":"translated","value":"Odjezd není čas (h:mm)."}},"de":{"stringUnit":{"state":"translated","value":"Eine Abfahrt ist keine Uhrzeit (h:mm)."}},"es":{"stringUnit":{"state":"translated","value":"Una salida no es una hora (h:mm)."}},"fr":{"stringUnit":{"state":"translated","value":"Un départ n'est pas une heure (h:mm)."}},"hi":{"stringUnit":{"state":"translated","value":"प्रस्थान समय नहीं है (h:mm)।"}},"hu":{"stringUnit":{"state":"translated","value":"Az indulás nem időpont (ó:pp)."}},"id":{"stringUnit":{"state":"translated","value":"Sebuah keberangkatan bukan waktu (h:mm)."}},"it":{"stringUnit":{"state":"translated","value":"Una partenza non è un orario (h:mm)."}},"ja":{"stringUnit":{"state":"translated","value":"出発は時刻ではありません(h:mm)。"}},"ka":{"stringUnit":{"state":"translated","value":"გასვლის დრო არასწორია (h:mm)."}},"kk":{"stringUnit":{"state":"translated","value":"Жөнелту уақыт емес (ч:мм)."}},"ko":{"stringUnit":{"state":"translated","value":"출발 시각이 시간 형식이 아닙니다(h:mm)."}},"ms":{"stringUnit":{"state":"translated","value":"Satu waktu bertolak bukan masa (h:mm)."}},"nl":{"stringUnit":{"state":"translated","value":"Een vertrektijd is geen tijd (u:mm)."}},"pl":{"stringUnit":{"state":"translated","value":"Odjazd nie jest godziną (g:mm)."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uma saída não é um horário (h:mm)."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Uma saída não é um horário (h:mm)."}},"ru":{"stringUnit":{"state":"translated","value":"Отправление - это не время (ч:мм)."}},"sr":{"stringUnit":{"state":"translated","value":"Odlazak nije vreme (h:mm)."}},"sv":{"stringUnit":{"state":"translated","value":"En avgång är ingen tid (h:mm)."}},"th":{"stringUnit":{"state":"translated","value":"เวลาออกไม่ใช่รูปแบบเวลา (h:mm)"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi oras ang isang alis (h:mm)."}},"tr":{"stringUnit":{"state":"translated","value":"Kalkış bir saat değil (s:dd)."}},"uk":{"stringUnit":{"state":"translated","value":"Відправлення - це не час (г:хх)."}},"vi":{"stringUnit":{"state":"translated","value":"Một giờ xuất phát không đúng định dạng giờ (h:mm)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发车时间格式不正确(h:mm)。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"發車時間格式不正確（應為 h:mm）。"}}}},
    "A head at rest": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"El cap en repòs"}},"de":{"stringUnit":{"state":"translated","value":"Kopf in Ruheposition"}},"es":{"stringUnit":{"state":"translated","value":"Cabeza en reposo"}},"fr":{"stringUnit":{"state":"translated","value":"Tête au repos"}},"ka":{"stringUnit":{"state":"translated","value":"თავი მოსვენებულ მდგომარეობაში"}},"nl":{"stringUnit":{"state":"translated","value":"Hoofd in rust"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cabeça em repouso"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Cabeça em repouso"}},"ru":{"stringUnit":{"state":"translated","value":"Голова в состоянии покоя"}},"sr":{"stringUnit":{"state":"translated","value":"Glava u mirovanju"}},"sv":{"stringUnit":{"state":"translated","value":"Huvud i vila"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"静止时的头部"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"靜止時的頭部"}}}},
    "A map's lines: their tours and when each trip leaves. Saved as the line's .ttl (in the content folder; OMSI 2's own files stay as they are).": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Лініі мапы: іх абароты і час адпраўлення кожнага рэйса. Захоўваецца як .ttl лініі (у тэчцы змесціва; уласныя файлы OMSI 2 застаюцца як ёсць)."}},"ca":{"stringUnit":{"state":"translated","value":"Les línies d'un mapa: els torns i la sortida de cada trajecte. Es desen al .ttl de la línia (a la carpeta de contingut; els fitxers originals d'OMSI 2 es mantenen intactes)."}},"cs":{"stringUnit":{"state":"translated","value":"Linky mapy: jejich turnusy a odjezdy jednotlivých spojů. Uloženo jako .ttl linky (ve složce obsahu; vlastní soubory OMSI 2 zůstávají beze změny)."}},"de":{"stringUnit":{"state":"translated","value":"Die Linien einer Karte: ihre Umläufe und wann jede Fahrt abfährt. Wird als .ttl der Linie gespeichert (im Inhaltsordner; die Originaldateien von OMSI 2 bleiben unverändert)."}},"es":{"stringUnit":{"state":"translated","value":"Las líneas de un mapa: sus turnos y cuándo sale cada viaje. Se guarda como el .ttl de la línea (en la carpeta de contenido; los archivos propios de OMSI 2 no se tocan)."}},"fr":{"stringUnit":{"state":"translated","value":"Les lignes d'une carte : leurs services et l'heure de départ de chaque trajet. Enregistré comme .ttl de la ligne (dans le dossier de contenu ; les fichiers d'OMSI 2 restent inchangés)."}},"hi":{"stringUnit":{"state":"translated","value":"मैप की लाइनें: उनके टूर और हर ट्रिप कब जाती है। लाइन की .ttl के रूप में सेव होती है (कंटेंट फ़ोल्डर में; OMSI 2 की अपनी फ़ाइलें जस की तस रहती हैं)।"}},"hu":{"stringUnit":{"state":"translated","value":"A pálya járatai: fordák és az egyes menetek indulása. Mentés a járat .ttl fájljaként (a tartalommappában; az OMSI 2 saját fájljai változatlanok maradnak)."}},"id":{"stringUnit":{"state":"translated","value":"Jalur sebuah peta: perjalanannya dan kapan setiap rit berangkat. Disimpan sebagai .ttl jalur (di folder konten; file milik OMSI 2 sendiri tetap seperti semula)."}},"it":{"stringUnit":{"state":"translated","value":"Le linee di una mappa: i loro turni e quando parte ogni corsa. Salvato come .ttl della linea (nella cartella dei contenuti; i file di OMSI 2 restano invariati)."}},"ja":{"stringUnit":{"state":"translated","value":"マップの系統:その行路と各便の出発時刻。系統の.ttlとして保存されます(コンテンツフォルダ内。OMSI 2自身のファイルは変更されません)。"}},"ka":{"stringUnit":{"state":"translated","value":"რუკის ხაზები: მათი რეისები და როდის გადის თითოეული მგზავრობა. ინახება ხაზის .ttl-ად (კონტენტის საქაღალდეში; OMSI 2-ის საკუთარი ფაილები უცვლელი რჩება)."}},"kk":{"stringUnit":{"state":"translated","value":"Картаның желілері: олардың рейстер тізбегі мен әр рейстің жөнелу уақыты. Желінің .ttl файлы ретінде сақталады (контент қалтасында; OMSI 2-нің өз файлдары өзгеріссіз қалады)."}},"ko":{"stringUnit":{"state":"translated","value":"지도의 노선: 운행 순번과 각 운행의 출발 시각. 노선의 .ttl로 저장됩니다(콘텐츠 폴더에; OMSI 2 자체 파일은 그대로 유지됩니다)."}},"ms":{"stringUnit":{"state":"translated","value":"Laluan sesebuah peta: pusingannya dan bila setiap perjalanan bertolak. Disimpan sebagai .ttl laluan (dalam folder kandungan; fail OMSI 2 sendiri kekal seperti asal)."}},"nl":{"stringUnit":{"state":"translated","value":"De lijnen van een kaart: hun omlopen en wanneer elke rit vertrekt. Opgeslagen als .ttl van de lijn (in de inhoudsmap; de eigen bestanden van OMSI 2 blijven ongewijzigd)."}},"pl":{"stringUnit":{"state":"translated","value":"Linie mapy: ich brygady i godziny odjazdów każdego kursu. Zapisywane jako .ttl linii (w folderze z zawartością; pliki samego OMSI 2 zostają bez zmian)."}},"pt-BR":{"stringUnit":{"state":"translated","value":"As linhas de um mapa: suas escalas e quando cada viagem sai. Salvo como o .ttl da linha (na pasta de conteúdo; os arquivos do próprio OMSI 2 não são alterados)."}},"pt-PT":{"stringUnit":{"state":"translated","value":"As linhas de um mapa: as suas escalas e quando cada viagem sai. Guardado como o .ttl da linha (na pasta de conteúdo; os ficheiros do próprio OMSI 2 não são alterados)."}},"ru":{"stringUnit":{"state":"translated","value":"Линии карты: их выходы и время отправления каждого рейса. Сохраняется как .ttl линии (в папке контента; файлы самой OMSI 2 не затрагиваются)."}},"sr":{"stringUnit":{"state":"translated","value":"Linije na mapi: njihove ture i kada svako putovanje kreće. Sačuvano kao .ttl linije (u fascikli sa sadržajem; sopstvene datoteke OMSI 2 ostaju onakve kakve jesu)."}},"sv":{"stringUnit":{"state":"translated","value":"En kartas linjer: deras omlopp och när varje tur avgår. Sparas som linjens .ttl (i innehållsmappen; OMSI 2:s egna filer lämnas orörda)."}},"th":{"stringUnit":{"state":"translated","value":"สายรถของแผนที่: รอบเดินรถและเวลาออกของแต่ละเที่ยว บันทึกเป็นไฟล์ .ttl ของสายรถ (ในโฟลเดอร์เนื้อหา; ไฟล์ของ OMSI 2 เองไม่ถูกเปลี่ยน)"}},"fil":{"stringUnit":{"state":"translated","value":"Ang mga linya ng isang mapa: ang kanilang mga biyahe at kung kailan umaalis ang bawat takbo. Sine-save bilang .ttl ng linya (sa content folder; hindi binabago ang sariling mga file ng OMSI 2)."}},"tr":{"stringUnit":{"state":"translated","value":"Bir haritanın hatları: sefer turları ve her seferin ne zaman kalktığı. Hattın .ttl dosyası olarak kaydedilir (içerik klasöründe; OMSI 2'nin kendi dosyaları olduğu gibi kalır)."}},"uk":{"stringUnit":{"state":"translated","value":"Лінії мапи: їхні обороти та час відправлення кожного рейсу. Зберігається як .ttl лінії (у теці вмісту; власні файли OMSI 2 залишаються як є)."}},"vi":{"stringUnit":{"state":"translated","value":"Các tuyến của bản đồ: lượt chạy và giờ xuất phát của từng chuyến. Lưu thành tệp .ttl của tuyến (trong thư mục nội dung; các tệp gốc của OMSI 2 giữ nguyên)."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"地图的线路:其班次以及每个行程的发车时间。保存为该线路的.ttl(在内容文件夹中;OMSI 2自带的文件保持不变)。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"地圖路線：其更次及各班次的發車時間。儲存為路線的 .ttl 檔案（位於內容資料夾中；OMSI 2 原始檔案保持不變）。"}}}},
    "A radio's station button n plays the n-th station, a cassette player the first; Shift+R steps through them. An address is an MP3, AAC or Ogg stream or an .m3u/.pls playlist.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Кнопка станцыі n радыё грае n-ю станцыю, касетны прайгравальнік — першую; Shift+R перамыкае іх па чарзе. Адрас — гэта струмень MP3, AAC або Ogg ці плэйліст .m3u/.pls."}},"ca":{"stringUnit":{"state":"translated","value":"El botó n de la ràdio reprodueix l'emissora n; un casset, la primera. Maj+R les recorre. Una adreça pot ser un flux MP3, AAC o Ogg o una llista .m3u/.pls."}},"cs":{"stringUnit":{"state":"translated","value":"Tlačítko stanice n na rádiu hraje n-tou stanici, kazetový přehrávač první; Shift+R mezi nimi přepíná. Adresa je stream MP3, AAC nebo Ogg nebo seznam skladeb .m3u/.pls."}},"de":{"stringUnit":{"state":"translated","value":"Die Sendertaste n eines Radios spielt den n-ten Sender, ein Kassettenspieler den ersten; Umschalt+R schaltet sie durch. Eine Adresse ist ein MP3-, AAC- oder Ogg-Stream oder eine .m3u/.pls-Playlist."}},"es":{"stringUnit":{"state":"translated","value":"El botón de emisora n de una radio reproduce la n-ésima emisora; un reproductor de casetes, la primera. Mayús+R las recorre. Una dirección es un flujo MP3, AAC u Ogg o una lista .m3u/.pls."}},"fr":{"stringUnit":{"state":"translated","value":"Le bouton de station n d'une radio lit la n-ième station, un lecteur de cassettes lit la première. Maj+R parcourt les stations. Une adresse peut être un flux MP3, AAC ou Ogg ou une liste de lecture .m3u/.pls."}},"hi":{"stringUnit":{"state":"translated","value":"रेडियो का स्टेशन बटन n, n-वाँ स्टेशन बजाता है, कैसेट प्लेयर पहला; Shift+R से स्टेशन बारी-बारी से बदलते हैं। पता एक MP3, AAC या Ogg स्ट्रीम या .m3u/.pls प्लेलिस्ट होता है।"}},"hu":{"stringUnit":{"state":"translated","value":"A rádió n. állomásgombja az n. állomást játssza, a kazettás lejátszó az elsőt; a Shift+R végiglépteti őket. A cím egy MP3, AAC vagy Ogg stream, vagy egy .m3u/.pls lejátszási lista."}},"id":{"stringUnit":{"state":"translated","value":"Tombol stasiun n pada radio memutar stasiun ke-n, pemutar kaset memutar yang pertama; Shift+R berpindah di antaranya. Alamat berupa stream MP3, AAC atau Ogg, atau daftar putar .m3u/.pls."}},"it":{"stringUnit":{"state":"translated","value":"Il tasto stazione n di una radio riproduce l'n-esima stazione, un mangianastri la prima; Maiusc+R le scorre. Un indirizzo è uno stream MP3, AAC o Ogg o una playlist .m3u/.pls."}},"ja":{"stringUnit":{"state":"translated","value":"ラジオの選局ボタン n は n 番目の局を、カセットプレーヤーは最初の局を再生します。Shift+R で順に切り替えます。アドレスは MP3、AAC、Ogg のストリーム、または .m3u/.pls プレイリストです。"}},"ka":{"stringUnit":{"state":"translated","value":"რადიოს n-ე სადგურის ღილაკი რთავს n-ე სადგურს, კასეტური ფლეერი კი პირველს; Shift+R მათ რიგრიგობით ცვლის. მისამართი არის MP3, AAC ან Ogg ნაკადი ან .m3u/.pls დასაკრავი სია."}},"kk":{"stringUnit":{"state":"translated","value":"Радионың n-ші станция түймесі n-ші станцияны ойнатады, кассеталық ойнатқыш — біріншісін; Shift+R оларды кезекпен ауыстырады. Мекенжай — MP3, AAC не Ogg ағыны немесе .m3u/.pls ойнату тізімі."}},"ko":{"stringUnit":{"state":"translated","value":"라디오의 방송국 버튼 n은 n번째 방송국을, 카세트 플레이어는 첫 번째 방송국을 재생합니다. Shift+R로 차례로 바꿉니다. 주소는 MP3, AAC, Ogg 스트림 또는 .m3u/.pls 재생 목록입니다."}},"ms":{"stringUnit":{"state":"translated","value":"Butang stesen n pada radio memainkan stesen ke-n, pemain kaset memainkan yang pertama; Shift+R menukar antara stesen. Alamat ialah strim MP3, AAC atau Ogg, atau senarai main .m3u/.pls."}},"nl":{"stringUnit":{"state":"translated","value":"Radioknop n speelt zender n; een cassettespeler de eerste. Shift+R schakelt tussen zenders. Gebruik een MP3-, AAC- of Ogg-stream of een .m3u/.pls-afspeellijst."}},"pl":{"stringUnit":{"state":"translated","value":"Przycisk stacji n w radiu odtwarza n-tą stację, magnetofon kasetowy pierwszą; Shift+R przełącza między nimi. Adres to strumień MP3, AAC lub Ogg albo playlista .m3u/.pls."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O botão de estação n de um rádio reproduz a n-ésima estação; um toca-fitas reproduz a primeira. Shift+R percorre as estações. Um endereço pode ser uma transmissão MP3, AAC ou Ogg ou uma lista .m3u/.pls."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O botão de estação n de um rádio reproduz a n.ª estação; um leitor de cassetes reproduz a primeira. Shift+R percorre as estações. Um endereço pode ser um fluxo MP3, AAC ou Ogg ou uma lista de reprodução .m3u/.pls."}},"ru":{"stringUnit":{"state":"translated","value":"Кнопка станции n на радио включает n-ю станцию, кассетный плеер — первую; Shift+R переключает их по очереди. Адрес — это поток MP3, AAC или Ogg либо плейлист .m3u/.pls."}},"sr":{"stringUnit":{"state":"translated","value":"Dugme radio stanice n pušta n-tu stanicu, a kasetofon prvu; Shift+R prelazi kroz njih. Adresa je MP3, AAC ili Ogg strim ili .m3u/.pls lista za reprodukciju."}},"sv":{"stringUnit":{"state":"translated","value":"En radios stationsknapp n spelar den n:e stationen, en kassettspelare den första; Shift+R växlar mellan dem. En adress kan vara en MP3-, AAC- eller Ogg-ström eller en .m3u/.pls-spellista."}},"th":{"stringUnit":{"state":"translated","value":"ปุ่มสถานี n ของวิทยุจะเล่นสถานีที่ n ส่วนเครื่องเล่นเทปจะเล่นสถานีแรก กด Shift+R เพื่อเปลี่ยนสถานีไปตามลำดับ ที่อยู่คือสตรีม MP3, AAC หรือ Ogg หรือเพลย์ลิสต์ .m3u/.pls"}},"fil":{"stringUnit":{"state":"translated","value":"Pinapatugtog ng button n ng radyo ang ika-n na istasyon, at ng cassette player ang una; pinapalipat-lipat ng Shift+R ang mga ito. Ang address ay isang MP3, AAC o Ogg stream o isang .m3u/.pls na playlist."}},"tr":{"stringUnit":{"state":"translated","value":"Radyonun n numaralı istasyon düğmesi n. istasyonu, kaset çalar ilkini çalar; Shift+R aralarında geçiş yapar. Adres bir MP3, AAC ya da Ogg yayını veya .m3u/.pls çalma listesidir."}},"uk":{"stringUnit":{"state":"translated","value":"Кнопка станції n на радіо вмикає n-ту станцію, касетний програвач — першу; Shift+R перемикає їх по черзі. Адреса — це потік MP3, AAC або Ogg чи плейлист .m3u/.pls."}},"vi":{"stringUnit":{"state":"translated","value":"Nút đài số n của radio phát đài thứ n, máy cát-xét phát đài đầu tiên; Shift+R chuyển lần lượt qua các đài. Địa chỉ là luồng MP3, AAC hoặc Ogg hoặc danh sách phát .m3u/.pls."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"电台的第 n 个按钮播放第 n 个电台，磁带播放器播放第一个；按 Shift+R 可逐个切换。地址可以是 MP3、AAC 或 Ogg 流，也可以是 .m3u/.pls 播放列表。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"廣播的電台按鈕 n 會播放第 n 個電台，卡式播放器則播放第一個；按 Shift+R 可切換電台。位址可以是 MP3、AAC 或 Ogg 串流，或 .m3u／.pls 播放清單。"}}}},
    "A right click ends the mouse steering (as in OMSI)": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Un clic dret desactiva la direcció amb ratolí (com a OMSI)"}},"de":{"stringUnit":{"state":"translated","value":"Ein Rechtsklick beendet die Maussteuerung"}},"es":{"stringUnit":{"state":"translated","value":"Un clic derecho desactiva la dirección con el ratón (como en OMSI)"}},"fr":{"stringUnit":{"state":"translated","value":"Un clic droit arrête la direction à la souris (comme sur OMSI)"}},"ka":{"stringUnit":{"state":"translated","value":"მარჯვენა დაწკაპუნება ასრულებს მაუსით მართვას (როგორც OMSI-ში)"}},"nl":{"stringUnit":{"state":"translated","value":"Een rechtermuisklik beëindigt de muissturing (zoals in OMSI)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um clique com o botão direito encerra a direção pelo mouse (como no OMSI)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Um clique com o botão direito termina a direção pelo rato (como no OMSI)"}},"ru":{"stringUnit":{"state":"translated","value":"Правый клик завершает управление мышью (как в OMSI)"}},"sr":{"stringUnit":{"state":"translated","value":"Desni klik prekida upravljanje mišem (kao u OMSI)"}},"sv":{"stringUnit":{"state":"translated","value":"Högerklick avslutar musstyrningen (som i OMSI)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"单击右键停止鼠标转向（与 OMSI 相同）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按一下滑鼠右鍵即可停止滑鼠轉向（與 OMSI 相同）"}}}},
    "AI vehicles on the map": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"ШІ-транспарт на мапе"}},"ca":{"stringUnit":{"state":"translated","value":"Vehicles d'IA al mapa"}},"cs":{"stringUnit":{"state":"translated","value":"AI vozidla na mapě"}},"de":{"stringUnit":{"state":"translated","value":"KI-Fahrzeuge auf der Karte"}},"es":{"stringUnit":{"state":"translated","value":"Vehículos IA en el mapa"}},"fr":{"stringUnit":{"state":"translated","value":"Véhicules IA sur la carte"}},"hi":{"stringUnit":{"state":"translated","value":"मैप पर AI वाहन"}},"hu":{"stringUnit":{"state":"translated","value":"MI-járművek a térképen"}},"id":{"stringUnit":{"state":"translated","value":"Kendaraan AI di peta"}},"it":{"stringUnit":{"state":"translated","value":"Veicoli IA sulla mappa"}},"ja":{"stringUnit":{"state":"translated","value":"地図上のAI車両"}},"ka":{"stringUnit":{"state":"translated","value":"AI მანქანები რუკაზე"}},"kk":{"stringUnit":{"state":"translated","value":"Картадағы ЖИ көліктері"}},"ko":{"stringUnit":{"state":"translated","value":"지도에 AI 차량 표시"}},"ms":{"stringUnit":{"state":"translated","value":"Kenderaan AI pada peta"}},"nl":{"stringUnit":{"state":"translated","value":"AI-voertuigen op de kaart"}},"pl":{"stringUnit":{"state":"translated","value":"Pojazdy AI na mapie"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Veículos de IA no mapa"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Veículos de IA no mapa"}},"ru":{"stringUnit":{"state":"translated","value":"ИИ-транспорт на карте"}},"sr":{"stringUnit":{"state":"translated","value":"AI vozila na mapi"}},"sv":{"stringUnit":{"state":"translated","value":"AI-fordon på kartan"}},"th":{"stringUnit":{"state":"translated","value":"แสดงรถ AI บนแผนที่"}},"fil":{"stringUnit":{"state":"translated","value":"Mga AI na sasakyan sa mapa"}},"tr":{"stringUnit":{"state":"translated","value":"Haritada yapay zekâ araçları"}},"uk":{"stringUnit":{"state":"translated","value":"ШІ-транспорт на мапі"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện xe AI trên bản đồ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"地图上显示AI车辆"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"地圖上顯示 AI 車輛"}}}},
    "Ability to get up (Ctrl+Shift+G)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Магчымасць уставаць (Ctrl+Shift+G)"}},"ca":{"stringUnit":{"state":"translated","value":"Permet aixecar-se (Ctrl+Maj+G)"}},"cs":{"stringUnit":{"state":"translated","value":"Možnost vstát (Ctrl+Shift+G)"}},"de":{"stringUnit":{"state":"translated","value":"Aufstehen möglich (Ctrl+Shift+G)"}},"es":{"stringUnit":{"state":"translated","value":"Poder levantarse (Ctrl+Shift+G)"}},"fr":{"stringUnit":{"state":"translated","value":"Se lever (Ctrl+Shift+G)"}},"hi":{"stringUnit":{"state":"translated","value":"उठ पाने की सुविधा (Ctrl+Shift+G)"}},"hu":{"stringUnit":{"state":"translated","value":"Felállás lehetősége (Ctrl+Shift+G)"}},"id":{"stringUnit":{"state":"translated","value":"Izinkan berdiri (Ctrl+Shift+G)"}},"it":{"stringUnit":{"state":"translated","value":"Possibilità di alzarsi (Ctrl+Shift+G)"}},"ja":{"stringUnit":{"state":"translated","value":"立ち上がり機能(Ctrl+Shift+G)"}},"ka":{"stringUnit":{"state":"translated","value":"ადგომის შესაძლებლობა (Ctrl+Shift+G)"}},"kk":{"stringUnit":{"state":"translated","value":"Тұру мүмкіндігі (Ctrl+Shift+G)"}},"ko":{"stringUnit":{"state":"translated","value":"일어나기 허용 (Ctrl+Shift+G)"}},"ms":{"stringUnit":{"state":"translated","value":"Benarkan bangun (Ctrl+Shift+G)"}},"nl":{"stringUnit":{"state":"translated","value":"Opstaan mogelijk (Ctrl+Shift+G)"}},"pl":{"stringUnit":{"state":"translated","value":"Możliwość wstania (Ctrl+Shift+G)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Poder levantar-se (Ctrl+Shift+G)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Poder levantar-se (Ctrl+Shift+G)"}},"ru":{"stringUnit":{"state":"translated","value":"Возможность встать (Ctrl+Shift+G)"}},"sr":{"stringUnit":{"state":"translated","value":"Mogućnost ustajanja (Ctrl+Shift+G)"}},"sv":{"stringUnit":{"state":"translated","value":"Möjlighet att resa sig (Ctrl+Shift+G)"}},"th":{"stringUnit":{"state":"translated","value":"อนุญาตให้ลุกจากที่