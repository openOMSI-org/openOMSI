    "Send the complete code to your friends; they choose Join friends.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Дашліце поўны код сябрам; яны выбіраюць «Далучыцца да сяброў»."}},"ca":{"stringUnit":{"state":"translated","value":"Envia el codi complet als teus amics; ells trien Uneix-te als amics."}},"cs":{"stringUnit":{"state":"translated","value":"Pošlete celý kód kamarádům; ti zvolí Připojit se ke kamarádům."}},"de":{"stringUnit":{"state":"translated","value":"Schicke den vollständigen Code an deine Freunde; sie wählen „Freunden beitreten“."}},"es":{"stringUnit":{"state":"translated","value":"Envía el código completo a tus amigos; ellos eligen Unirse a amigos."}},"fr":{"stringUnit":{"state":"translated","value":"Envoyez le code complet à vos amis ; ils choisissent Rejoindre des amis."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा कोड दोस्तों को भेजें; वे \"दोस्तों से जुड़ें\" चुनें।"}},"hu":{"stringUnit":{"state":"translated","value":"Küldd el a teljes kódot a barátaidnak; ők a Csatlakozás barátokhoz lehetőséget választják."}},"id":{"stringUnit":{"state":"translated","value":"Kirim kode lengkap ke teman Anda; mereka memilih Gabung teman."}},"it":{"stringUnit":{"state":"translated","value":"Invia il codice completo ai tuoi amici; loro scelgono Unisciti agli amici."}},"ja":{"stringUnit":{"state":"translated","value":"コード全体を友達に送ります。友達は「友達に参加」を選びます。"}},"ka":{"stringUnit":{"state":"translated","value":"გაუგზავნეთ სრული კოდი მეგობრებს; ისინი ირჩევენ „მეგობრებთან შეერთებას“."}},"kk":{"stringUnit":{"state":"translated","value":"Толық кодты достарыңызға жіберіңіз; олар «Достарға қосылу» тармағын таңдайды."}},"ko":{"stringUnit":{"state":"translated","value":"전체 코드를 친구에게 보내세요. 친구는 '친구 게임 참가'를 선택합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Hantar kod penuh kepada rakan anda; mereka memilih Sertai rakan."}},"nl":{"stringUnit":{"state":"translated","value":"Stuur de volledige code naar je vrienden; zij kiezen Deelnemen bij vrienden."}},"pl":{"stringUnit":{"state":"translated","value":"Wyślij pełny kod znajomym; oni wybierają Dołącz do znajomych."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Envie o código completo aos seus amigos; eles escolhem Juntar-se a amigos."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Envie o código completo aos seus amigos; eles escolhem Juntar-se a amigos."}},"ru":{"stringUnit":{"state":"translated","value":"Отправьте полный код друзьям; они выбирают «Присоединиться к друзьям»."}},"sr":{"stringUnit":{"state":"translated","value":"Pošaljite prijateljima ceo kod; oni treba da izaberu „Pridruži se prijateljima“."}},"sv":{"stringUnit":{"state":"translated","value":"Skicka hela koden till dina vänner; de väljer Anslut till vänner."}},"th":{"stringUnit":{"state":"translated","value":"ส่งรหัสฉบับเต็มให้เพื่อน แล้วให้เพื่อนเลือก “เข้าร่วมกับเพื่อน”"}},"fil":{"stringUnit":{"state":"translated","value":"Ipadala ang buong code sa mga kaibigan mo; pipiliin nila ang Sumali sa mga kaibigan."}},"tr":{"stringUnit":{"state":"translated","value":"Kodun tamamını arkadaşlarınıza gönderin; onlar Arkadaşlara katıl'ı seçer."}},"uk":{"stringUnit":{"state":"translated","value":"Надішліть повний код друзям; вони вибирають «Приєднатися до друзів»."}},"vi":{"stringUnit":{"state":"translated","value":"Gửi toàn bộ mã cho bạn bè; họ chọn Tham gia cùng bạn bè."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"把完整会话码发给朋友，请他们选择“加入朋友”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"把完整連線碼傳給朋友，請他們選擇「加入朋友」。"}}}},
