    "Return to Multiplayer to copy your running session code.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вярніцеся ў «Мультыплеер», каб скапіяваць код бягучай сесіі."}},"ca":{"stringUnit":{"state":"translated","value":"Torna a Multijugador per copiar el codi de la sessió en curs."}},"cs":{"stringUnit":{"state":"translated","value":"Vraťte se do sekce Multiplayer a zkopírujte kód běžící relace."}},"de":{"stringUnit":{"state":"translated","value":"Kehre zu „Mehrspieler“ zurück, um den Code deiner laufenden Sitzung zu kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Vuelve a Multijugador para copiar el código de la sesión en curso."}},"fr":{"stringUnit":{"state":"translated","value":"Revenez dans Multijoueur pour copier le code de la session en cours."}},"hi":{"stringUnit":{"state":"translated","value":"चल रहे सेशन का कोड कॉपी करने के लिए मल्टीप्लेयर पर लौटें।"}},"hu":{"stringUnit":{"state":"translated","value":"Térj vissza a Többjátékos mód oldalra, és másold ki a futó munkamenet kódját."}},"id":{"stringUnit":{"state":"translated","value":"Kembali ke Multipemain untuk menyalin kode sesi yang sedang berjalan."}},"it":{"stringUnit":{"state":"translated","value":"Torna a Multigiocatore per copiare il codice della sessione in corso."}},"ja":{"stringUnit":{"state":"translated","value":"「マルチプレイ」に戻って、実行中のセッションコードをコピーします。"}},"ka":{"stringUnit":{"state":"translated","value":"დაბრუნდით „მრავალმოთამაშიანში“ მიმდინარე სესიის კოდის დასაკოპირებლად."}},"kk":{"stringUnit":{"state":"translated","value":"Ағымдағы сессия кодын көшіру үшін «Мультиплеер» бөліміне оралыңыз."}},"ko":{"stringUnit":{"state":"translated","value":"'멀티플레이'로 돌아가 실행 중인 세션 코드를 복사하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Kembali ke Berbilang pemain untuk menyalin kod sesi yang sedang berjalan."}},"nl":{"stringUnit":{"state":"translated","value":"Ga terug naar Multiplayer om de code van je lopende sessie te kopiëren."}},"pl":{"stringUnit":{"state":"translated",