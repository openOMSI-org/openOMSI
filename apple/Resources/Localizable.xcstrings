是包含 maps 和 Vehicles 的那個資料夾（任何完整安裝皆可）。"}}}},
    "The bus's own keys": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Tecles pròpies de l'autobús"}},"de":{"stringUnit":{"state":"translated","value":"Die eigenen Tasten des Busses"}},"es":{"stringUnit":{"state":"translated","value":"Teclas propias del autobús"}},"fr":{"stringUnit":{"state":"translated","value":"Les boutons du bus"}},"ka":{"stringUnit":{"state":"translated","value":"ავტობუსის საკუთარი კლავიშები"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Teclas do próprio ônibus"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Teclas do próprio autocarro"}},"ru":{"stringUnit":{"state":"translated","value":"Собственные клавиши автобуса"}},"sr":{"stringUnit":{"state":"translated","value":"Sopstveni ključevi autobusa"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"巴士專用按鍵"}}}},
    "The buses of {name} stay in the list, in no depot.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Аўтобусы {name} застаюцца ў спісе, без гаража."}},"ca":{"stringUnit":{"state":"translated","value":"Els autobusos de {name} es queden a la llista, sense cotxeres."}},"cs":{"stringUnit":{"state":"translated","value":"Autobusy z {name} zůstanou v seznamu, bez garáže."}},"de":{"stringUnit":{"state":"translated","value":"Die Busse von {name} bleiben in der Liste, ohne Depot."}},"es":{"stringUnit":{"state":"translated","value":"Los autobuses de {name} se quedan en la lista, sin cochera."}},"fr":{"stringUnit":{"state":"translated","value":"Les bus de {name} restent dans la liste, sans dépôt."}},"hi":{"stringUnit":{"state":"translated","value":"{name} की बसें बिना डिपो के सूची में रहेंगी।"}},"hu":{"stringUnit":{"state":"translated","value":"A(z) {name} buszai a listában maradnak, garázs nélkül."}},"id":{"stringUnit":{"state":"translated","value":"Bus dari {name} tetap ada di daftar, tanpa garasi."}},"it":{"stringUnit":{"state":"translated","value":"Gli autobus di {name} restano nell'elenco, senza deposito."}},"ja":{"stringUnit":{"state":"translated","value":"{name} のバスは車庫なしでリストに残ります。"}},"ka":{"stringUnit":{"state":"translated","value":"{name}-ის ავტობუსები სიაში რჩება, დეპოს გარეშე."}},"kk":{"stringUnit":{"state":"translated","value":"{name} автобустары тізімде гаражсыз қалады."}},"ko":{"stringUnit":{"state":"translated","value":"{name}의 버스는 차고 없이 목록에 남습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Bas {name} kekal dalam senarai, tanpa depoh."}},"nl":{"stringUnit":{"state":"translated","value":"De bussen van {name} blijven in de lijst, zonder depot."}},"pl":{"stringUnit":{"state":"translated","value":"Autobusy z {name} zostaną na liście, bez zajezdni."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os ônibus de {name} continuam na lista, sem garagem."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Os autocarros de {name} ficam na lista, sem garagem."}},"ru":{"stringUnit":{"state":"translated","value":"Автобусы {name} останутся в списке, без гаража."}},"sr":{"stringUnit":{"state":"translated","value":"Autobusi iz {name} ostaju na listi, bez garaže."}},"sv":{"stringUnit":{"state":"translated","value":"Bussarna i {name} stannar kvar i listan, utan depå."}},"th":{"stringUnit":{"state":"translated","value":"รถบัสของ {name} ยังอยู่ในรายการ โดยไม่มีอู่"}},"fil":{"stringUnit":{"state":"translated","value":"Mananatili sa listahan ang mga bus ng {name}, nang walang depot."}},"tr":{"stringUnit":{"state":"translated","value":"{name} otobüsleri listede garajsız olarak kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Автобуси {name} залишаться в списку, без гаража."}},"vi":{"stringUnit":{"state":"translated","value":"Các xe buýt của {name} vẫn ở trong danh sách, không thuộc xưởng nào."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"{name} 的公交车会留在列表中，不属于任何车库。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"{name} 的公車會留在清單中，不屬於任何車庫。"}}}},
    "The driver sells the ticket": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіцель прадае білет"}},"ca":{"stringUnit":{"state":"translated","value":"El conductor ven el bitllet"}},"cs":{"stringUnit":{"state":"translated","value":"Řidič prodává jízdenku"}},"de":{"stringUnit":{"state":"translated","value":"Der Fahrer verkauft den Fahrschein"}},"es":{"stringUnit":{"state":"translated","value":"El conductor vende el billete"}},"fr":{"stringUnit":{"state":"translated","value":"Le conducteur vend le ticket"}},"hi":{"stringUnit":{"state":"translated","value":"टिकट ड्राइवर बेचता है"}},"hu":{"stringUnit":{"state":"translated","value":"Realisztikus/Valós"}},"id":{"stringUnit":{"state":"translated","value":"Sopir menjual tiket"}},"it":{"stringUnit":{"state":"translated","value":"Il conducente vende il biglietto"}},"ja":{"stringUnit":{"state":"translated","value":"運転手が乗車券を販売"}},"ka":{"stringUnit":{"state":"translated","value":"მძღოლი ყიდის ბილეთს"}},"kk":{"stringUnit":{"state":"translated","value":"Билетті жүргізуші сатады"}},"ko":{"stringUnit":{"state":"translated","value":"운전자가 승차권 판매"}},"ms":{"stringUnit":{"state":"translated","value":"Pemandu menjual tiket"}},"nl":{"stringUnit":{"state":"translated","value":"De bestuurder verkoopt het kaartje"}},"pl":{"stringUnit":{"state":"translated","value":"Kierowca sprzedaje bilet"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O motorista vende a passagem"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O condutor vende a bilhete"}},"ru":{"stringUnit":{"state":"translated","value":"Билет продаёт водитель"}},"sr":{"stringUnit":{"state":"translated","value":"Vozač prodaje kartu"}},"sv":{"stringUnit":{"state":"translated","value":"Föraren säljer biljetten"}},"th":{"stringUnit":{"state":"translated","value":"คนขับขายตั๋ว"}},"fil":{"stringUnit":{"state":"translated","value":"Driver ang nagbebenta ng tiket"}},"tr":{"stringUnit":{"state":"translated","value":"Bileti sürücü satar"}},"uk":{"stringUnit":{"state":"translated","value":"Водій продає квиток"}},"vi":{"stringUnit":{"state":"translated","value":"Tài xế bán vé"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"司机售票"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"由司機售票"}}}},
    "The driver whose personnel file the game writes: hours, kilometres, punctuality, tickets.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Вадзіцель, чыю асабістую справу вядзе гульня: гадзіны, кіламетры, пунктуальнасць, білеты."}},"ca":{"stringUnit":{"state":"translated","value":"El conductor del qual el joc desa l'expedient: hores, quilòmetres, puntualitat i bitllets."}},"cs":{"stringUnit":{"state":"translated","value":"Řidič, jehož osobní spis hra vede: hodiny, kilometry, dochvilnost, jízdenky."}},"de":{"stringUnit":{"state":"translated","value":"Der Fahrer, dessen Personalakte das Spiel führt: Stunden, Kilometer, Pünktlichkeit, Fahrscheine."}},"es":{"stringUnit":{"state":"translated","value":"El conductor cuyo expediente escribe el juego: horas, kilómetros, puntualidad, billetes."}},"fr":{"stringUnit":{"state":"translated","value":"Le conducteur dont le jeu maintient le dossier : heures, kilomètres, ponctualité, billets."}},"hi":{"stringUnit":{"state":"translated","value":"वह ड्राइवर जिसकी पर्सनल फ़ाइल गेम लिखता है: घंटे, किलोमीटर, समय-पालन, टिकट।"}},"hu":{"stringUnit":{"state":"translated","value":"A sofőr, akinek a személyi lapját a játék vezeti: Órák, kilométerek, pontosság, jegyeladások és sok más."}},"id":{"stringUnit":{"state":"translated","value":"Game mencatat jam, kilometer, ketepatan waktu, dan tiket pengemudi ini."}},"it":{"stringUnit":{"state":"translated","value":"Il conducente del cui fascicolo personale il gioco tiene traccia: ore, chilometri, puntualità, biglietti."}},"ja":{"stringUnit":{"state":"translated","value":"ゲームが人事ファイルに記録する運転手:時間、キロ数、定時性、乗車券。"}},"ka":{"stringUnit":{"state":"translated","value":"მძღოლი, რომლის პირად საქმეს თამაში წერს: საათები, კილომეტრები, პუნქტუალურობა, ბილეთები."}},"kk":{"stringUnit":{"state":"translated","value":"Ойын жеке іс парағын жазатын жүргізуші: сағаттар, километрлер, тұрақтылық, билеттер."}},"ko":{"stringUnit":{"state":"translated","value":"게임이 이 운전자의 운전 시간, 거리, 정시성, 승차권 판매를 기록합니다."}},"ms":{"stringUnit":{"state":"translated","value":"Permainan merekod jam, kilometer, ketepatan masa dan tiket pemandu ini."}},"nl":{"stringUnit":{"state":"translated","value":"De bestuurder van wie het spel het personeelsdossier bijhoudt: uren, kilometers, punctualiteit, kaartjes."}},"pl":{"stringUnit":{"state":"translated","value":"Kierowca, dla którego gra prowadzi akta osobowe: godziny, kilometry, punktualność, bilety."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O motorista cujo registro o jogo mantém: horas, quilômetros, pontualidade e passagens."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O condutor cujo registro o jogo mantém: horas, quilómetros, pontualidade e bilhetes."}},"ru":{"stringUnit":{"state":"translated","value":"Водитель, в личное дело которого игра пишет: часы, километры, пунктуальность, билеты."}},"sr":{"stringUnit":{"state":"translated","value":"Vozač u čijem personalnom dosijeu igra piše: sati, kilometri, tačnost, karte."}},"sv":{"stringUnit":{"state":"translated","value":"Föraren vars personalakt spelet skriver: timmar, kilometer, punktlighet och biljetter."}},"th":{"stringUnit":{"state":"translated","value":"เกมจะบันทึกชั่วโมงขับรถ ระยะทาง ความตรงเวลา และการขายตั๋วของคนขับนี้"}},"fil":{"stringUnit":{"state":"translated","value":"Itinatala ng laro ang oras, kilometro, pagiging nasa oras at tickets ng driver na ito."}},"tr":{"stringUnit":{"state":"translated","value":"Oyunun özlük dosyasını yazdığı sürücü: saat, kilometre, dakiklik, biletler."}},"uk":{"stringUnit":{"state":"translated","value":"Водій, чиє особове діло веде гра: години, кілометри, пунктуальність, квитки."}},"vi":{"stringUnit":{"state":"translated","value":"Trò chơi ghi lại số giờ lái, quãng đường, độ đúng giờ và vé đã bán của tài xế này."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"游戏为其写入人事档案的司机:工时、公里数、准点率、车票。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"遊戲會為這名司機記錄駕駛時數、里程、準時率及售票數據。"}}}},
    "The game": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гульня"}},"ca":{"stringUnit":{"state":"translated","value":"El joc"}},"cs":{"stringUnit":{"state":"translated","value":"Hra"}},"de":{"stringUnit":{"state":"translated","value":"Das Spiel"}},"es":{"stringUnit":{"state":"translated","value":"El juego"}},"fr":{"stringUnit":{"state":"translated","value":"Le jeu"}},"hi":{"stringUnit":{"state":"translated","value":"गेम"}},"hu":{"stringUnit":{"state":"translated","value":"A játék"}},"id":{"stringUnit":{"state":"translated","value":"Game"}},"it":{"stringUnit":{"state":"translated","value":"Il gioco"}},"ja":{"stringUnit":{"state":"translated","value":"ゲーム"}},"ka":{"stringUnit":{"state":"translated","value":"თამაში"}},"kk":{"stringUnit":{"state":"translated","value":"Ойын"}},"ko":{"stringUnit":{"state":"translated","value":"게임"}},"ms":{"stringUnit":{"state":"translated","value":"Permainan"}},"nl":{"stringUnit":{"state":"translated","value":"Het spel"}},"pl":{"stringUnit":{"state":"translated","value":"Gra"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O jogo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O jogo"}},"ru":{"stringUnit":{"state":"translated","value":"Игра"}},"sr":{"stringUnit":{"state":"translated","value":"Igra"}},"sv":{"stringUnit":{"state":"translated","value":"Spelet"}},"th":{"stringUnit":{"state":"translated","value":"เกม"}},"fil":{"stringUnit":{"state":"translated","value":"Ang laro"}},"tr":{"stringUnit":{"state":"translated","value":"Oyun"}},"uk":{"stringUnit":{"state":"translated","value":"Гра"}},"vi":{"stringUnit":{"state":"translated","value":"Trò chơi"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"游戏"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"遊戲"}}}},
    "The game closed on an error": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"El joc s'ha tancat per un error"}},"de":{"stringUnit":{"state":"translated","value":"Das Spiel wurde wegen eines Fehlers beendet"}},"es":{"stringUnit":{"state":"translated","value":"El juego se ha cerrado por un error"}},"fr":{"stringUnit":{"state":"translated","value":"Le jeu a crashé à cause d'une erreur"}},"ka":{"stringUnit":{"state":"translated","value":"თამაში შეცდომით დაიხურა"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O jogo fechou por causa de um erro"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O jogo fechou devido a um erro"}},"ru":{"stringUnit":{"state":"translated","value":"Игра закрылась из-за ошибки"}},"sr":{"stringUnit":{"state":"translated","value":"Igra je zatvorena greškom"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"遊戲因錯誤而關閉"}}}},
    "The game ends as if Escape and Quit were chosen; an unsaved session is lost.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"La partida acaba com si triessis Esc i Surt; es perd la sessió si no s'ha desat."}},"de":{"stringUnit":{"state":"translated","value":"Das Spiel endet wie mit Esc und Beenden; eine ungespeicherte Sitzung geht verloren."}},"es":{"stringUnit":{"state":"translated","value":"El juego termina como si hubieras elegido Esc y Salir; se pierde cualquier sesión sin guardar."}},"fr":{"stringUnit":{"state":"translated","value":"Le jeu se ferme comme avec Échap puis Quitter ; une session non enregistrée est perdue."}},"ka":{"stringUnit":{"state":"translated","value":"თამაში დასრულდება, თითქოს Escape და გასვლა აირჩიეს; შეუნახავი სესია დაიკარგება."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O jogo termina como se Esc e Sair tivessem sido escolhidos; uma sessão não salva é perdida."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O jogo termina como se tivesse escolhido Esc e Sair; uma sessão não guardada perde-se."}},"ru":{"stringUnit":{"state":"translated","value":"Игра закроется так, будто выбраны Escape и «Выход»; несохранённая сессия пропадёт."}},"sr":{"stringUnit":{"state":"translated","value":"Igra se završava kao da su izabrani Esc i Izlaz; nesačuvana sesija se gubi."}},"sv":{"stringUnit":{"state":"translated","value":"Spelet avslutas som om Escape och Avsluta valts; en osparad session försvinner."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結束遊戲的方式等同於按 Escape 並選擇退出；未儲存的進度將會遺失。"}}}},
    "The game was closed by the system": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"El sistema ha tancat el joc"}},"de":{"stringUnit":{"state":"translated","value":"Das Spiel wurde vom System beendet"}},"es":{"stringUnit":{"state":"translated","value":"El sistema ha cerrado el juego"}},"fr":{"stringUnit":{"state":"translated","value":"Le jeu a été fermé par le système"}},"ka":{"stringUnit":{"state":"translated","value":"თამაში სისტემამ დახურა"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O jogo foi fechado pelo sistema"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O jogo foi fechado pelo sistema"}},"ru":{"stringUnit":{"state":"translated","value":"Игра была закрыта системой"}},"sr":{"stringUnit":{"state":"translated","value":"Sistem je zatvorio igru"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"遊戲被系統關閉"}}}},
    "The graphics driver stopped the game. Updating the graphics driver usually helps; Settings → Graphics API can switch to OpenGL.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"El controlador gràfic ha aturat el joc. Actualitzar-lo sol ajudar; a Configuració → API gràfica pots canviar a OpenGL."}},"de":{"stringUnit":{"state":"translated","value":"Der Grafiktreiber hat das Spiel beendet. Ein Update des Grafiktreibers hilft meist; unter Einstellungen → Grafik-API kannst du auf OpenGL wechseln."}},"es":{"stringUnit":{"state":"translated","value":"El controlador gráfico ha detenido el juego. Actualizarlo suele ayudar; puedes cambiar a OpenGL en Ajustes → API gráfica."}},"fr":{"stringUnit":{"state":"translated","value":"Le pilote graphique a arrêté le jeu. Mettre à jour le pilote aide généralement ; Réglages → API graphique permet de passer à OpenGL."}},"ka":{"stringUnit":{"state":"translated","value":"გრაფიკულმა დრაივერმა თამაში გათიშა. როგორც წესი, გრაფიკული დრაივერის განახლება ეხმარება; პარამეტრები → გრაფიკული API საშუალებას გაძლევთ გადახვიდეთ OpenGL-ზე."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O driver gráfico interrompeu o jogo. Atualizar o driver gráfico costuma ajudar; em Configurações → API gráfica você pode mudar para OpenGL."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O controlador gráfico parou o jogo. Atualizar o controlador gráfico costuma ajudar; em Definições → API gráfica pode mudar para OpenGL."}},"ru":{"stringUnit":{"state":"translated","value":"Графический драйвер остановил игру. Обычно помогает обновление графического драйвера; в Настройки → Графический API можно переключиться на OpenGL."}},"sr":{"stringUnit":{"state":"translated","value":"Grafički drajver je zaustavio igru. Ažuriranje drajvera obično pomaže; u Podešavanja → Grafički API možete izabrati OpenGL."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示驅動程式導致遊戲停止。更新顯示驅動程式通常會有幫助；可在「設定 → 圖形 API」切換至 OpenGL。"}}}},
    "The installed buses' own script triggers are not listed here: type the trigger's name in the list's filter to add it.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Уласныя трыгеры скрыптоў усталяваных аўтобусаў тут не пералічаны: увядзіце назву трыгера ў фільтр спіса, каб дадаць яго."}},"ca":{"stringUnit":{"state":"translated","value":"Els activadors propis dels scripts dels autobusos instal·lats no apareixen aquí: escriu el nom de l'activador al filtre de la llista per afegir-lo."}},"cs":{"stringUnit":{"state":"translated","value":"Vlastní spouštěče skriptů nainstalovaných autobusů zde nejsou uvedeny: zadejte název spouštěče do filtru seznamu a přidejte jej."}},"de":{"stringUnit":{"state":"translated","value":"Die eigenen Skript-Trigger der Busse stehen nicht hier: Gib den Namen des Triggers in den Filter der Liste ein, um ihn hinzuzufügen."}},"es":{"stringUnit":{"state":"translated","value":"Los disparadores propios de los scripts de los autobuses instalados no aparecen aquí: escribe el nombre del disparador en el filtro de la lista para añadirlo."}},"fr":{"stringUnit":{"state":"translated","value":"Les triggers propres aux scripts des bus installés ne sont pas listés ici : tapez le nom du trigger dans le filtre de la liste pour l'ajouter."}},"hi":{"stringUnit":{"state":"translated","value":"इंस्टॉल की गई बसों के अपने स्क्रिप्ट ट्रिगर यहाँ नहीं दिखते: जोड़ने के लिए सूची के फ़िल्टर में ट्रिगर का नाम लिखें।"}},"hu":{"stringUnit":{"state":"translated","value":"A telepített buszok saját szkript-triggerei nincsenek itt felsorolva: írd be a trigger nevét a lista szűrőjébe a hozzáadásához."}},"id":{"stringUnit":{"state":"translated","value":"Pemicu skrip milik bus yang terpasang tidak tercantum di sini: ketik nama pemicu di filter daftar untuk menambahkannya."}},"it":{"stringUnit":{"state":"translated","value":"I trigger propri degli script degli autobus installati non sono elencati qui: digita il nome del trigger nel filtro dell'elenco per aggiungerlo."}},"ja":{"stringUnit":{"state":"translated","value":"インストール済みのバス独自のスクリプトトリガーはここに表示されません。追加するには、一覧のフィルターにトリガー名を入力してください。"}},"ka":{"stringUnit":{"state":"translated","value":"დაყენებული ავტობუსების საკუთარი სკრიპტის ტრიგერები აქ არ არის: დასამატებლად აკრიფეთ ტრიგერის სახელი სიის ფილტრში."}},"kk":{"stringUnit":{"state":"translated","value":"Орнатылған автобустардың өз скрипт триггерлері мұнда көрсетілмеген: қосу үшін триггер атын тізім сүзгісіне енгізіңіз."}},"ko":{"stringUnit":{"state":"translated","value":"설치된 버스의 자체 스크립트 트리거는 여기에 나오지 않습니다. 추가하려면 목록 필터에 트리거 이름을 입력하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pencetus skrip milik bas yang dipasang tidak disenaraikan di sini: taip nama pencetus dalam penapis senarai untuk menambahnya."}},"nl":{"stringUnit":{"state":"translated","value":"De eigen scripttriggers van de geïnstalleerde bussen staan hier niet: typ de naam van de trigger in het filter van de lijst om hem toe te voegen."}},"pl":{"stringUnit":{"state":"translated","value":"Własne wyzwalacze skryptów zainstalowanych autobusów nie są tu wymienione: wpisz nazwę wyzwalacza w filtrze listy, aby go dodać."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os gatilhos próprios dos scripts dos ônibus instalados não aparecem aqui: digite o nome do gatilho no filtro da lista para adicioná-lo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Os gatilhos próprios dos scripts dos autocarros instalados não aparecem aqui: escreva o nome do gatilho no filtro da lista para o adicionar."}},"ru":{"stringUnit":{"state":"translated","value":"Собственные триггеры скриптов автобусов здесь не перечислены: введите имя триггера в фильтр списка, чтобы добавить его."}},"sr":{"stringUnit":{"state":"translated","value":"Okidači sopstvenih skripti instaliranih magistrala nisu navedeni ovde: unesite ime okidača u filter liste da biste ga dodali."}},"sv":{"stringUnit":{"state":"translated","value":"De installerade bussarnas egna skripthändelser listas inte här: skriv händelsens namn i listans filter för att lägga till den."}},"th":{"stringUnit":{"state":"translated","value":"ทริกเกอร์สคริปต์ของรถบัสที่ติดตั้งไว้ไม่ได้แสดงที่นี่: พิมพ์ชื่อทริกเกอร์ในตัวกรองของรายการเพื่อเพิ่ม"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi nakalista rito ang sariling script trigger ng mga naka-install na bus: i-type ang pangalan ng trigger sa filter ng listahan para idagdag ito."}},"tr":{"stringUnit":{"state":"translated","value":"Yüklü otobüslerin kendi betik tetikleyicileri burada listelenmez: eklemek için tetikleyicinin adını listenin filtresine yazın."}},"uk":{"stringUnit":{"state":"translated","value":"Власні тригери скриптів встановлених автобусів тут не перелічено: введіть назву тригера у фільтр списку, щоб додати його."}},"vi":{"stringUnit":{"state":"translated","value":"Các trigger riêng trong script của xe buýt đã cài không được liệt kê ở đây: hãy gõ tên trigger vào bộ lọc của danh sách để thêm."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装巴士自己的脚本触发器不会列在这里：请在列表的筛选栏输入触发器名称来添加。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝巴士自己的腳本觸發器不會列在這裡：請在清單的篩選欄輸入觸發器名稱來新增。"}}}},
    "The keyboard brake stays on until the throttle (as in OMSI)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Тормаз з клавіятуры трымаецца да націску газу (як у OMSI)"}},"ca":{"stringUnit":{"state":"translated","value":"El fre del teclat es manté fins que acceleres (com a OMSI)"}},"cs":{"stringUnit":{"state":"translated","value":"Brzda z klávesnice drží až do plynu (jako v OMSI)"}},"de":{"stringUnit":{"state":"translated","value":"Die Tastaturbremse bleibt bis zum Gasgeben (wie in OMSI)"}},"es":{"stringUnit":{"state":"translated","value":"El freno del teclado se mantiene hasta acelerar (como en OMSI)"}},"fr":{"stringUnit":{"state":"translated","value":"Le frein au clavier reste serré jusqu'à l'accélérateur (comme sur OMSI)"}},"hi":{"stringUnit":{"state":"translated","value":"कीबोर्ड ब्रेक थ्रॉटल दबाने तक लगा रहता है (OMSI की तरह)"}},"hu":{"stringUnit":{"state":"translated","value":"A billentyűzetes fék a gázadásig behúzva marad (mint az OMSI-ban)"}},"id":{"stringUnit":{"state":"translated","value":"Rem keyboard tetap tertahan sampai gas ditekan (seperti di OMSI)"}},"it":{"stringUnit":{"state":"translated","value":"Il freno da tastiera resta tirato fino all'acceleratore (come in OMSI)"}},"ja":{"stringUnit":{"state":"translated","value":"キーボードのブレーキはアクセルを踏むまで保持(OMSIと同じ)"}},"ka":{"stringUnit":{"state":"translated","value":"კლავიატურის მუხრუჭი აჩქარებამდე რჩება (როგორც OMSI-ში)"}},"kk":{"stringUnit":{"state":"translated","value":"Пернетақта тежегіші газ басылғанша ұсталады (OMSI-дегідей)"}},"ko":{"stringUnit":{"state":"translated","value":"키보드 브레이크는 가속할 때까지 유지(OMSI와 같음)"}},"ms":{"stringUnit":{"state":"translated","value":"Brek papan kekunci kekal sehingga pendikit ditekan (seperti dalam OMSI)"}},"nl":{"stringUnit":{"state":"translated","value":"De toetsenbordrem blijft aan tot je gas geeft (zoals in OMSI)"}},"pl":{"stringUnit":{"state":"translated","value":"Hamulec z klawiatury trzyma do wciśnięcia gazu (jak w OMSI)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O freio do teclado fica acionado até acelerar (como no OMSI)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O freio do teclado fica acionado até acelerar (como no OMSI)"}},"ru":{"stringUnit":{"state":"translated","value":"Тормоз с клавиатуры держится до нажатия газа (как в OMSI)"}},"sr":{"stringUnit":{"state":"translated","value":"Kočnica tastature ostaje uključena do gasa (kao u OMSI)"}},"sv":{"stringUnit":{"state":"translated","value":"Tangentbordsbromsen förblir på tills du gasar (som i OMSI)"}},"th":{"stringUnit":{"state":"translated","value":"เบรกจากคีย์บอร์ดค้างไว้จนกว่าจะเหยียบคันเร่ง (เหมือนใน OMSI)"}},"fil":{"stringUnit":{"state":"translated","value":"Nananatili ang preno ng keyboard hanggang sa gas (tulad sa OMSI)"}},"tr":{"stringUnit":{"state":"translated","value":"Klavye freni gaza basılana kadar basılı kalır (OMSI'deki gibi)"}},"uk":{"stringUnit":{"state":"translated","value":"Гальмо з клавіатури тримається до натискання газу (як в OMSI)"}},"vi":{"stringUnit":{"state":"translated","value":"Phanh bàn phím giữ nguyên cho đến khi nhấn ga (như trong OMSI)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"键盘刹车保持到踩油门为止(与OMSI相同)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"鍵盤煞車保持到踩油門為止(與OMSI相同)"}}}},
    "The keys of the game are OMSI's Inputs/keyboard.cfg: the openOMSI launcher of Windows and Linux sets them on its Controls page, which reads and writes the same file.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Клавішы гульні бяруцца з файла OMSI Inputs/keyboard.cfg: лаўнчар openOMSI для Windows і Linux наладжвае іх на старонцы «Кіраванне», якая чытае і запісвае той самы файл."}},"ca":{"stringUnit":{"state":"translated","value":"Les tecles del joc són les d'OMSI, a Inputs/keyboard.cfg: el launcher d'openOMSI de Windows i Linux les configura a la seva pàgina Controls, que llegeix i escriu aquest mateix fitxer."}},"cs":{"stringUnit":{"state":"translated","value":"Klávesy hry jsou v souboru Inputs/keyboard.cfg z OMSI: launcher openOMSI pro Windows a Linux je nastavuje na stránce Ovládání, která čte a zapisuje stejný soubor."}},"de":{"stringUnit":{"state":"translated","value":"Die Tasten des Spiels stehen in OMSIs Inputs/keyboard.cfg: Der openOMSI-Launcher für Windows und Linux stellt sie auf seiner Seite Steuerung ein, die dieselbe Datei liest und schreibt."}},"es":{"stringUnit":{"state":"translated","value":"Las teclas del juego son las de OMSI, en Inputs/keyboard.cfg: el lanzador openOMSI de Windows y Linux las configura en su página Controles, que lee y escribe ese mismo archivo."}},"fr":{"stringUnit":{"state":"translated","value":"Les touches du jeu sont celles d'OMSI, dans Inputs/keyboard.cfg : le lanceur openOMSI de Windows et Linux les règle dans sa page Commandes, qui lit et écrit ce même fichier."}},"hi":{"stringUnit":{"state":"translated","value":"गेम की कीज़ OMSI की Inputs/keyboard.cfg हैं: Windows और Linux का openOMSI लॉन्चर उन्हें अपने कंट्रोल पेज पर सेट करता है, जो इसी फ़ाइल को पढ़ता और लिखता है।"}},"hu":{"stringUnit":{"state":"translated","value":"A játék billentyűi az OMSI Inputs/keyboard.cfg fájljában vannak: a Windowsos és linuxos openOMSI indító az Irányítás oldalon állítja be őket, amely ugyanezt a fájlt olvassa és írja."}},"id":{"stringUnit":{"state":"translated","value":"Tombol game adalah Inputs/keyboard.cfg milik OMSI: peluncur openOMSI di Windows dan Linux mengaturnya di halaman Kontrol, yang membaca dan menulis file yang sama."}},"it":{"stringUnit":{"state":"translated","value":"I tasti del gioco sono in Inputs/keyboard.cfg di OMSI: il launcher di openOMSI per Windows e Linux li imposta nella sua pagina Comandi, che legge e scrive lo stesso file."}},"ja":{"stringUnit":{"state":"translated","value":"ゲームのキーは OMSI の Inputs/keyboard.cfg です。Windows と Linux の openOMSI ランチャーでは「操作」ページで設定でき、同じファイルを読み書きします。"}},"ka":{"stringUnit":{"state":"translated","value":"თამაშის კლავიშები OMSI-ის Inputs/keyboard.cfg ფაილშია: Windows-ისა და Linux-ის openOMSI გამშვები მათ თავის „მართვის საშუალებების“ გვერდზე აყენებს, რომელიც იმავე ფაილს კითხულობს და წერს."}},"kk":{"stringUnit":{"state":"translated","value":"Ойын пернелері OMSI-дің Inputs/keyboard.cfg файлында: Windows пен Linux-қа арналған openOMSI лаунчері оларды Басқару бетінде орнатады, ол да осы файлды оқып, жазады."}},"ko":{"stringUnit":{"state":"translated","value":"게임 키는 OMSI의 Inputs/keyboard.cfg입니다. Windows와 Linux의 openOMSI 런처는 조작 페이지에서 키를 설정하며, 같은 파일을 읽고 씁니다."}},"ms":{"stringUnit":{"state":"translated","value":"Kekunci permainan ialah Inputs/keyboard.cfg OMSI: pelancar openOMSI di Windows dan Linux menetapkannya pada halaman Kawalan, yang membaca dan menulis fail yang sama."}},"nl":{"stringUnit":{"state":"translated","value":"De toetsen van het spel staan in OMSI's Inputs/keyboard.cfg: de openOMSI-launcher voor Windows en Linux stelt ze in op zijn pagina Besturing, die hetzelfde bestand leest en schrijft."}},"pl":{"stringUnit":{"state":"translated","value":"Klawisze gry to plik Inputs/keyboard.cfg z OMSI: launcher openOMSI dla Windows i Linuksa ustawia je na stronie Sterowanie, która odczytuje i zapisuje ten sam plik."}},"pt-BR":{"stringUnit":{"state":"translated","value":"As teclas do jogo ficam no Inputs/keyboard.cfg do OMSI: o launcher do openOMSI para Windows e Linux as define na sua página Controles, que lê e grava o mesmo arquivo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"As teclas do jogo ficam no Inputs/keyboard.cfg do OMSI: o launcher do openOMSI para Windows e Linux define-as na sua página Controlos, que lê e grava o mesmo ficheiro."}},"ru":{"stringUnit":{"state":"translated","value":"Клавиши игры хранятся в Inputs/keyboard.cfg из OMSI: лаунчер openOMSI для Windows и Linux настраивает их на странице «Управление», которая читает и записывает тот же файл."}},"sr":{"stringUnit":{"state":"translated","value":"Tasteri igre su u OMSI datoteci Inputs/keyboard.cfg: openOMSI pokretač za Windows i Linux ih podešava na stranici Kontrole, koja čita i upisuje istu datoteku."}},"sv":{"stringUnit":{"state":"translated","value":"Spelets tangenter finns i OMSI:s Inputs/keyboard.cfg: openOMSI-startprogrammet för Windows och Linux ställer in dem på sidan Kontroller, som läser och skriver samma fil."}},"th":{"stringUnit":{"state":"translated","value":"ปุ่มของเกมคือ Inputs/keyboard.cfg ของ OMSI ตัวเปิดเกม openOMSI บน Windows และ Linux ตั้งค่าได้ในหน้าการควบคุม ซึ่งอ่านและเขียนไฟล์เดียวกัน"}},"fil":{"stringUnit":{"state":"translated","value":"Ang mga key ng laro ay ang Inputs/keyboard.cfg ng OMSI: itinatakda ito ng openOMSI launcher sa Windows at Linux sa page na Mga kontrol, na bumabasa at sumusulat sa parehong file."}},"tr":{"stringUnit":{"state":"translated","value":"Oyunun tuşları OMSI'nin Inputs/keyboard.cfg dosyasındadır: Windows ve Linux için openOMSI başlatıcısı bunları Kontroller sayfasında ayarlar; bu sayfa aynı dosyayı okur ve yazar."}},"uk":{"stringUnit":{"state":"translated","value":"Клавіші гри зберігаються в Inputs/keyboard.cfg з OMSI: лаунчер openOMSI для Windows і Linux налаштовує їх на сторінці «Керування», яка читає й записує той самий файл."}},"vi":{"stringUnit":{"state":"translated","value":"Phím của trò chơi là Inputs/keyboard.cfg của OMSI: trình khởi chạy openOMSI trên Windows và Linux đặt chúng ở trang Điều khiển, trang này đọc và ghi cùng tệp đó."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"游戏按键来自 OMSI 的 Inputs/keyboard.cfg：Windows 和 Linux 版 openOMSI 启动器在其“操作”页面设置按键，读写的是同一个文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"遊戲按鍵來自 OMSI 的 Inputs/keyboard.cfg：Windows 和 Linux 版 openOMSI 啟動器在其「操作」頁面設定按鍵，讀寫的是同一個檔案。"}}}},
    "The launcher rests while a game runs (gives the graphics card to the game)": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"El launcher queda en repòs mentre hi ha una partida (cedeix la targeta gràfica al joc)"}},"de":{"stringUnit":{"state":"translated","value":"Der Launcher ist pausiert während ein Spiel läuft (Spiel kann Grafikkarte voll nutzen)"}},"es":{"stringUnit":{"state":"translated","value":"El lanzador descansa mientras hay una partida en marcha (deja la tarjeta gráfica al juego)"}},"fr":{"stringUnit":{"state":"translated","value":"Le lanceur se met en pause pendant une partie (laisse la carte graphique au jeu)"}},"ka":{"stringUnit":{"state":"translated","value":"გამშვები ისვენებს, სანამ თამაში მიმდინარეობს (ვიდეობარათს თამაშს უთმობს)"}},"nl":{"stringUnit":{"state":"translated","value":"De launcher pauzeert tijdens het spelen (zodat het spel de grafische kaart kan gebruiken)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O launcher fica em repouso enquanto um jogo está em execução (deixa a placa de vídeo para o jogo)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O launcher fica em repouso enquanto um jogo está em execução (deixa a placa gráfica para o jogo)"}},"ru":{"stringUnit":{"state":"translated","value":"Лаунчер бездействует, пока запущена игра (отдаёт видеокарту игре)"}},"sr":{"stringUnit":{"state":"translated","value":"Pokretač miruje dok igra radi (daje grafičku karticu igri)"}},"sv":{"stringUnit":{"state":"translated","value":"Startprogrammet vilar medan ett spel körs (ger grafikkortet till spelet)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"游戏运行时启动器暂停（将显卡资源让给游戏）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"遊戲運行時啟動器休息（提供遊戲顯示卡）"}}}},
    "The mouse works the pedals": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Мыш кіруе педалямі"}},"ca":{"stringUnit":{"state":"translated","value":"El ratolí acciona els pedals"}},"cs":{"stringUnit":{"state":"translated","value":"Myš ovládá pedály"}},"de":{"stringUnit":{"state":"translated","value":"Die Maus bedient die Pedale"}},"es":{"stringUnit":{"state":"translated","value":"El ratón acciona los pedales"}},"fr":{"stringUnit":{"state":"translated","value":"La souris actionne les pédales"}},"hi":{"stringUnit":{"state":"translated","value":"माउस पैडल चलाता है"}},"hu":{"stringUnit":{"state":"translated","value":"Az egér kezeli a pedálokat"}},"id":{"stringUnit":{"state":"translated","value":"Mouse mengendalikan pedal"}},"it":{"stringUnit":{"state":"translated","value":"Il mouse aziona i pedali"}},"ja":{"stringUnit":{"state":"translated","value":"マウスでペダルを操作"}},"ka":{"stringUnit":{"state":"translated","value":"მაუსი მართავს პედლებს"}},"kk":{"stringUnit":{"state":"translated","value":"Тінтуір педальдарды басқарады"}},"ko":{"stringUnit":{"state":"translated","value":"마우스로 페달 조작"}},"ms":{"stringUnit":{"state":"translated","value":"Tetikus mengawal pedal"}},"nl":{"stringUnit":{"state":"translated","value":"De muis bedient de pedalen"}},"pl":{"stringUnit":{"state":"translated","value":"Mysz obsługuje pedały"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O mouse aciona os pedais"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O rato aciona os pedais"}},"ru":{"stringUnit":{"state":"translated","value":"Мышь управляет педалями"}},"sr":{"stringUnit":{"state":"translated","value":"Miš upravlja pedalima"}},"sv":{"stringUnit":{"state":"translated","value":"Musen styr pedalerna"}},"th":{"stringUnit":{"state":"translated","value":"เมาส์ควบคุมแป้นเหยียบ"}},"fil":{"stringUnit":{"state":"translated","value":"Ang mouse ang gumagamit ng mga pedal"}},"tr":{"stringUnit":{"state":"translated","value":"Fare pedalları kullanır"}},"uk":{"stringUnit":{"state":"translated","value":"Миша керує педалями"}},"vi":{"stringUnit":{"state":"translated","value":"Chuột điều khiển bàn đạp"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"鼠标控制踏板"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"滑鼠控制踏板"}}}},
    "The next drive is hosted for others to join.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Наступная паездка адкрыта для іншых гульцоў."}},"ca":{"stringUnit":{"state":"translated","value":"La propera partida s'allotja perquè altres s'hi uneixin."}},"cs":{"stringUnit":{"state":"translated","value":"Další jízda je hostovaná, ostatní se mohou připojit."}},"de":{"stringUnit":{"state":"translated","value":"Die nächste Fahrt wird gehostet, damit andere beitreten können."}},"es":{"stringUnit":{"state":"translated","value":"La próxima partida se aloja para que otros se unan."}},"fr":{"stringUnit":{"state":"translated","value":"La prochaine partie est hébergée pour que d'autres la rejoignent."}},"hi":{"stringUnit":{"state":"translated","value":"अगली ड्राइव दूसरों के जुड़ने के लिए होस्ट की जाएगी।"}},"hu":{"stringUnit":{"state":"translated","value":"A következő vezetést hosztolod, mások csatlakozhatnak."}},"id":{"stringUnit":{"state":"translated","value":"Perjalanan berikutnya di-host agar orang lain bisa bergabung."}},"it":{"stringUnit":{"state":"translated","value":"La prossima partita è ospitata perché altri possano unirsi."}},"ja":{"stringUnit":{"state":"translated","value":"次の運転は他のプレイヤーが参加できるようホストされます。"}},"ka":{"stringUnit":{"state":"translated","value":"შემდეგი მართვა გაიხსნება, რომ სხვა მოთამაშეები შემოგიერთდნენ."}},"kk":{"stringUnit":{"state":"translated","value":"Келесі сапарға басқа ойыншылар қосыла алады."}},"ko":{"stringUnit":{"state":"translated","value":"다음 운전은 다른 사람이 참가할 수 있도록 호스팅됩니다."}},"ms":{"stringUnit":{"state":"translated","value":"Pemanduan seterusnya dihos supaya orang lain boleh sertai."}},"nl":{"stringUnit":{"state":"translated","value":"De volgende rit wordt gehost zodat anderen kunnen deelnemen."}},"pl":{"stringUnit":{"state":"translated","value":"Następna jazda jest hostowana, inni mogą dołączyć."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A próxima viagem é hospedada para outros entrarem."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A próxima condução é alojada para outros se juntarem."}},"ru":{"stringUnit":{"state":"translated","value":"Следующая поездка открыта для подключения других игроков."}},"sr":{"stringUnit":{"state":"translated","value":"Sledeća vožnja je ugošćena, drugi mogu da se pridruže."}},"sv":{"stringUnit":{"state":"translated","value":"Nästa körning hostas så att andra kan ansluta."}},"th":{"stringUnit":{"state":"translated","value":"การขับครั้งถัดไปจะเปิดเป็นโฮสต์ให้ผู้อื่นเข้าร่วม"}},"fil":{"stringUnit":{"state":"translated","value":"Iho-host ang susunod na pagmamaneho para makasali ang iba."}},"tr":{"stringUnit":{"state":"translated","value":"Sonraki sürüş, başkalarının katılabilmesi için sunulur."}},"uk":{"stringUnit":{"state":"translated","value":"Наступна поїздка відкрита, щоб інші могли приєднатися."}},"vi":{"stringUnit":{"state":"translated","value":"Lần lái tiếp theo sẽ tạo phòng để người khác tham gia."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一次驾驶将作为主机开放，供其他人加入。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下一次駕駛將建立房間，供其他人加入。"}}}},
    "The original OMSI 2 was not found.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Арыгінальны OMSI 2 не знойдзены."}},"ca":{"stringUnit":{"state":"translated","value":"No s'ha trobat l'OMSI 2 original."}},"cs":{"stringUnit":{"state":"translated","value":"Původní OMSI 2 nebylo nalezeno."}},"de":{"stringUnit":{"state":"translated","value":"Das originale OMSI 2 wurde nicht gefunden."}},"es":{"stringUnit":{"state":"translated","value":"No se ha encontrado el OMSI 2 original."}},"fr":{"stringUnit":{"state":"translated","value":"L'OMSI 2 original est introuvable."}},"hi":{"stringUnit":{"state":"translated","value":"ओरिजिनल OMSI 2 नहीं मिला।"}},"hu":{"stringUnit":{"state":"translated","value":"Az eredeti OMSI 2 nem található."}},"id":{"stringUnit":{"state":"translated","value":"OMSI 2 asli tidak ditemukan."}},"it":{"stringUnit":{"state":"translated","value":"L'OMSI 2 originale non è stato trovato."}},"ja":{"stringUnit":{"state":"translated","value":"オリジナルの OMSI 2 が見つかりませんでした。"}},"ka":{"stringUnit":{"state":"translated","value":"ორიგინალი OMSI 2 ვერ მოიძებნა."}},"kk":{"stringUnit":{"state":"translated","value":"Түпнұсқа OMSI 2 табылмады."}},"ko":{"stringUnit":{"state":"translated","value":"원본 OMSI 2를 찾지 못했습니다."}},"ms":{"stringUnit":{"state":"translated","value":"OMSI 2 asal tidak ditemui."}},"nl":{"stringUnit":{"state":"translated","value":"De originele OMSI 2 is niet gevonden."}},"pl":{"stringUnit":{"state":"translated","value":"Nie znaleziono oryginalnego OMSI 2."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O OMSI 2 original não foi encontrado."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O OMSI 2 original não foi encontrado."}},"ru":{"stringUnit":{"state":"translated","value":"Оригинальная OMSI 2 не найдена."}},"sr":{"stringUnit":{"state":"translated","value":"Originalni OMSI 2 nije pronađen."}},"sv":{"stringUnit":{"state":"translated","value":"Originalet OMSI 2 hittades inte."}},"th":{"stringUnit":{"state":"translated","value":"ไม่พบ OMSI 2 ต้นฉบับ"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi nakita ang orihinal na OMSI 2."}},"tr":{"stringUnit":{"state":"translated","value":"Orijinal OMSI 2 bulunamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Оригінальну OMSI 2 не знайдено."}},"vi":{"stringUnit":{"state":"translated","value":"Không tìm thấy OMSI 2 gốc."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到原版 OMSI 2。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"找不到原版 OMSI 2。"}}}},
    "The personnel file of {name} is deleted with all its figures.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Se suprimeix l'expedient de {name} amb totes les seves dades."}},"de":{"stringUnit":{"state":"translated","value":"Die Personalakte von {name} wird mit allen Zahlen gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Se eliminará el expediente de {name} con todas sus estadísticas."}},"fr":{"stringUnit":{"state":"translated","value":"Le dossier du personnel de {name} est supprimé avec tous ses chiffres."}},"ka":{"stringUnit":{"state":"translated","value":"{name}-ის პირადი საქმე წაიშლება ყველა მონაცემთან ერთად."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O registro de {name} é excluído com todos os seus números."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A ficha de {name} é eliminada com todos os seus números."}},"ru":{"stringUnit":{"state":"translated","value":"Личное дело {name} будет удалено со всей статистикой."}},"sr":{"stringUnit":{"state":"translated","value":"Briše se personalni dosije {name} sa svim brojevima."}},"sv":{"stringUnit":{"state":"translated","value":"Personalakten för {name} tas bort tillsammans med all statistik."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將刪除 {name} 的個人檔案與所有統計資料。"}}}},
    "The report is copied: paste it into a GitHub issue or a message.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Informe copiat: enganxa'l en una incidència de GitHub o en un missatge."}},"de":{"stringUnit":{"state":"translated","value":"Der Bericht ist kopiert: füge ihn in ein GitHub-Issue oder eine Nachricht ein."}},"es":{"stringUnit":{"state":"translated","value":"Informe copiado: pégalo en una incidencia de GitHub o en un mensaje."}},"fr":{"stringUnit":{"state":"translated","value":"Le rapport est copié : collez-le dans un ticket GitHub ou un message."}},"ka":{"stringUnit":{"state":"translated","value":"ანგარიში დაკოპირდა: ჩასვით GitHub issue-ში ან შეტყობინებაში."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O relatório foi copiado: cole em uma issue do GitHub ou em uma mensagem."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O relatório foi copiado: cole-o numa issue do GitHub ou numa mensagem."}},"ru":{"stringUnit":{"state":"translated","value":"Отчёт скопирован: вставьте его в issue на GitHub или в сообщение."}},"sr":{"stringUnit":{"state":"translated","value":"Izveštaj se kopira: nalepite ga u GitHub problem ili poruku."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"報告已複製：可貼到 GitHub 問題回報或訊息中。"}}}},
    "The server does not offer {name}": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Server bietet {name} nicht an"}},"es":{"stringUnit":{"state":"translated","value":"El servidor no ofrece {name}"}},"fr":{"stringUnit":{"state":"translated","value":"Le serveur ne propose pas {name}"}},"ka":{"stringUnit":{"state":"translated","value":"სერვერი არ გთავაზობთ {name}-ს"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O servidor não oferece {name}"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O servidor não oferece {name}"}},"ru":{"stringUnit":{"state":"translated","value":"Сервер не предлагает {name}"}},"sr":{"stringUnit":{"state":"translated","value":"Server ne nudi {name}"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"伺服器未提供 {name}"}}}},
    "The server offers none of the vehicles installed here": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Сервер не прапануе ніводнага з усталяваных тут транспартных сродкаў"}},"ca":{"stringUnit":{"state":"translated","value":"El servidor no ofereix cap dels vehicles instal·lats aquí"}},"cs":{"stringUnit":{"state":"translated","value":"Server nenabízí žádné z vozidel nainstalovaných zde"}},"de":{"stringUnit":{"state":"translated","value":"Der Server bietet keines der hier installierten Fahrzeuge an"}},"es":{"stringUnit":{"state":"translated","value":"El servidor no ofrece ninguno de los vehículos instalados aquí"}},"fr":{"stringUnit":{"state":"translated","value":"Le serveur ne propose aucun des véhicules installés ici"}},"hi":{"stringUnit":{"state":"translated","value":"सर्वर यहाँ इंस्टॉल किए गए वाहनों में से कोई भी नहीं देता"}},"hu":{"stringUnit":{"state":"translated","value":"A szerver egyik itt telepített járművet sem kínálja"}},"id":{"stringUnit":{"state":"translated","value":"Server tidak menawarkan satu pun kendaraan yang terpasang di sini"}},"it":{"stringUnit":{"state":"translated","value":"Il server non offre nessuno dei veicoli installati qui"}},"ja":{"stringUnit":{"state":"translated","value":"サーバーには、ここにインストールされている車両がひとつもありません"}},"ka":{"stringUnit":{"state":"translated","value":"სერვერი არ გთავაზობთ აქ დაყენებული მანქანებიდან არცერთს"}},"kk":{"stringUnit":{"state":"translated","value":"Сервер мұнда орнатылған көліктердің ешқайсысын ұсынбайды"}},"ko":{"stringUnit":{"state":"translated","value":"서버가 여기에 설치된 차량을 하나도 제공하지 않습니다"}},"ms":{"stringUnit":{"state":"translated","value":"Pelayan tidak menawarkan sebarang kenderaan yang dipasang di sini"}},"nl":{"stringUnit":{"state":"translated","value":"De server biedt geen van de hier geïnstalleerde voertuigen aan"}},"pl":{"stringUnit":{"state":"translated","value":"Serwer nie oferuje żadnego z pojazdów zainstalowanych tutaj"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O servidor não oferece nenhum dos veículos instalados aqui"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O servidor não oferece nenhum dos veículos instalados aqui"}},"ru":{"stringUnit":{"state":"translated","value":"Сервер не предлагает ни одного из установленных здесь транспортных средств"}},"sr":{"stringUnit":{"state":"translated","value":"Server ne nudi nijedno od vozila instaliranih ovde"}},"sv":{"stringUnit":{"state":"translated","value":"Servern erbjuder inget av de fordon som är installerade här"}},"th":{"stringUnit":{"state":"translated","value":"เซิร์ฟเวอร์ไม่มียานพาหนะที่ติดตั้งไว้ที่นี่เลย"}},"fil":{"stringUnit":{"state":"translated","value":"Wala sa mga sasakyang naka-install dito ang inaalok ng server"}},"tr":{"stringUnit":{"state":"translated","value":"Sunucu burada yüklü araçların hiçbirini sunmuyor"}},"uk":{"stringUnit":{"state":"translated","value":"Сервер не пропонує жодного з установлених тут транспортних засобів"}},"vi":{"stringUnit":{"state":"translated","value":"Máy chủ không có phương tiện nào trong số đã cài ở đây"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务器不提供此处已安装的任何车辆"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"伺服器不提供這裡已安裝的任何車輛"}}}},
    "The server plays {}, which is not installed here: it is fetched from the server on joining.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"El servidor juga a {}, que no està instal·lat aquí: es baixarà del servidor en connectar-t'hi."}},"de":{"stringUnit":{"state":"translated","value":"Der Server spielt {}, welche hier nicht installiert ist: Sie wird beim Verbinden zum Server heruntergeladen."}},"es":{"stringUnit":{"state":"translated","value":"El servidor utiliza {}, que no está instalado aquí: se descargará del servidor al conectarte."}},"fr":{"stringUnit":{"state":"translated","value":"Le serveur utilise la carte {}, qui n'est pas installée ici : elle sera téléchargée depuis le serveur à la connexion."}},"ka":{"stringUnit":{"state":"translated","value":"სერვერის რუკა {} აქ დაყენებული არ არის: ის შეერთებისას სერვერიდან ჩამოიტვირთება."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O servidor usa {}, que não está instalado aqui: ele é baixado do servidor ao entrar."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O servidor usa {}, que não está instalado aqui: é transferido do servidor ao entrar."}},"ru":{"stringUnit":{"state":"translated","value":"На сервере используется {}, что не установлено здесь: это будет получено с сервера при подключении."}},"sr":{"stringUnit":{"state":"translated","value":"Server koristi mapu {}; ako je nemate instaliranu, preuzeće se sa servera kada se pridružite."}},"sv":{"stringUnit":{"state":"translated","value":"Servern använder {}, som inte är installerat här: det hämtas från servern vid anslutning."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"伺服器使用尚未在此安裝的 {}：加入時會從伺服器下載。"}}}},
    "The session is full. Ask your friend to make room, then confirm again.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Сесія запоўнена. Папрасіце сябра вызваліць месца і пацвердзіце зноў."}},"ca":{"stringUnit":{"state":"translated","value":"La sessió és plena. Demana al teu amic que alliberi una plaça i torna a confirmar."}},"cs":{"stringUnit":{"state":"translated","value":"Relace je plná. Požádejte kamaráda, ať uvolní místo, a potvrďte znovu."}},"de":{"stringUnit":{"state":"translated","value":"Die Sitzung ist voll. Bitte deinen Freund, Platz zu schaffen, und bestätige dann erneut."}},"es":{"stringUnit":{"state":"translated","value":"La sesión está llena. Pide a tu amigo que libere una plaza y vuelve a confirmar."}},"fr":{"stringUnit":{"state":"translated","value":"La session est pleine. Demandez à votre ami de libérer une place, puis confirmez à nouveau."}},"hi":{"stringUnit":{"state":"translated","value":"सेशन भरा हुआ है। दोस्त से जगह खाली करने को कहें, फिर दोबारा पुष्टि करें।"}},"hu":{"stringUnit":{"state":"translated","value":"A munkamenet megtelt. Kérd meg a barátodat, hogy szabadítson fel helyet, majd erősítsd meg újra."}},"id":{"stringUnit":{"state":"translated","value":"Sesi sudah penuh. Minta teman Anda menyediakan tempat, lalu konfirmasi lagi."}},"it":{"stringUnit":{"state":"translated","value":"La sessione è piena. Chiedi al tuo amico di liberare un posto, poi conferma di nuovo."}},"ja":{"stringUnit":{"state":"translated","value":"セッションが満員です。友達に空きを作ってもらってから、もう一度確認してください。"}},"ka":{"stringUnit":{"state":"translated","value":"სესია სავსეა. სთხოვეთ მეგობარს ადგილის გათავისუფლება, შემდეგ ხელახლა დაადასტურეთ."}},"kk":{"stringUnit":{"state":"translated","value":"Сессия толы. Досыңыздан орын босатуды сұрап, қайта растаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"세션이 가득 찼습니다. 친구에게 자리를 비워 달라고 한 뒤 다시 확인하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Sesi sudah penuh. Minta rakan anda mengosongkan tempat, kemudian sahkan semula."}},"nl":{"stringUnit":{"state":"translated","value":"De sessie is vol. Vraag je vriend ruimte te maken en bevestig daarna opnieuw."}},"pl":{"stringUnit":{"state":"translated","value":"Sesja jest pełna. Poproś znajomego o zwolnienie miejsca i potwierdź ponownie."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sessão está cheia. Peça ao seu amigo para liberar uma vaga e confirme novamente."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A sessão está cheia. Peça ao seu amigo que liberte um lugar e confirme novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Сессия заполнена. Попросите друга освободить место и подтвердите снова."}},"sr":{"stringUnit":{"state":"translated","value":"Sesija je puna. Zamolite prijatelja da oslobodi mesto, pa ponovo potvrdite."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionen är full. Be din vän att göra plats och bekräfta sedan igen."}},"th":{"stringUnit":{"state":"translated","value":"เซสชันเต็มแล้ว ขอให้เพื่อนเว้นที่ว่าง แล้วยืนยันอีกครั้ง"}},"fil":{"stringUnit":{"state":"translated","value":"Puno na ang session. Hilingin sa kaibigan mo na magbakante ng puwesto, saka kumpirmahin ulit."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum dolu. Arkadaşınızdan yer açmasını isteyin, sonra yeniden onaylayın."}},"uk":{"stringUnit":{"state":"translated","value":"Сесія заповнена. Попросіть друга звільнити місце й підтвердьте знову."}},"vi":{"stringUnit":{"state":"translated","value":"Phiên đã đầy. Nhờ bạn của bạn dành chỗ trống, rồi xác nhận lại."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"会话已满。请朋友空出位置后，再次确认会话。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"房間已滿。請朋友空出位置後，再次確認房間。"}}}},
    "The session is selected, not connected yet. Choose your bus and press Join and drive.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Сесія выбрана, але яшчэ не падключана. Выберыце аўтобус і націсніце «Далучыцца і ехаць»."}},"ca":{"stringUnit":{"state":"translated","value":"La sessió està seleccionada, però encara no connectada. Tria l'autobús i prem Uneix-t'hi i condueix."}},"cs":{"stringUnit":{"state":"translated","value":"Relace je vybraná, ale zatím nepřipojená. Vyberte autobus a stiskněte Připojit se a jet."}},"de":{"stringUnit":{"state":"translated","value":"Die Sitzung ist ausgewählt, aber noch nicht verbunden. Wähle deinen Bus und drücke „Beitreten und fahren“."}},"es":{"stringUnit":{"state":"translated","value":"La sesión está seleccionada, pero aún no conectada. Elige tu autobús y pulsa Unirse y conducir."}},"fr":{"stringUnit":{"state":"translated","value":"La session est sélectionnée, mais pas encore connectée. Choisissez votre bus et appuyez sur Rejoindre et conduire."}},"hi":{"stringUnit":{"state":"translated","value":"सेशन चुना गया है, पर अभी जुड़ा नहीं है। अपनी बस चुनें और \"जुड़ें और चलाएँ\" दबाएँ।"}},"hu":{"stringUnit":{"state":"translated","value":"A munkamenet ki van választva, de még nincs kapcsolat. Válassz buszt, és nyomd meg a Csatlakozás és vezetés gombot."}},"id":{"stringUnit":{"state":"translated","value":"Sesi sudah dipilih, tetapi belum terhubung. Pilih bus Anda lalu tekan Gabung dan mengemudi."}},"it":{"stringUnit":{"state":"translated","value":"La sessione è selezionata, ma non ancora connessa. Scegli il tuo autobus e premi Unisciti e guida."}},"ja":{"stringUnit":{"state":"translated","value":"セッションは選択済みですが、まだ接続していません。バスを選んで「参加して運転」を押してください。"}},"ka":{"stringUnit":{"state":"translated","value":"სესია არჩეულია, მაგრამ ჯერ არ არის დაკავშირებული. აირჩიეთ ავტობუსი და დააჭირეთ „შეერთება და მართვა“-ს."}},"kk":{"stringUnit":{"state":"translated","value":"Сессия таңдалды, бірақ әлі қосылған жоқ. Автобусты таңдап, «Қосылып жүру» түймесін басыңыз."}},"ko":{"stringUnit":{"state":"translated","value":"세션을 선택했지만 아직 연결되지 않았습니다. 버스를 선택하고 '참가 후 운전'을 누르세요."}},"ms":{"stringUnit":{"state":"translated","value":"Sesi telah dipilih, tetapi belum bersambung. Pilih bas anda dan tekan Sertai dan pandu."}},"nl":{"stringUnit":{"state":"translated","value":"De sessie is gekozen, maar nog niet verbonden. Kies je bus en druk op Deelnemen en rijden."}},"pl":{"stringUnit":{"state":"translated","value":"Sesja jest wybrana, ale jeszcze niepołączona. Wybierz autobus i naciśnij Dołącz i jedź."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A sessão foi selecionada, mas ainda não está conectada. Escolha seu ônibus e pressione Entrar e dirigir."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A sessão está selecionada, mas ainda não está ligada. Escolha o seu autocarro e prima Entrar e conduzir."}},"ru":{"stringUnit":{"state":"translated","value":"Сессия выбрана, но ещё не подключена. Выберите автобус и нажмите «Присоединиться и ехать»."}},"sr":{"stringUnit":{"state":"translated","value":"Sesija je izabrana, ali veza još nije uspostavljena. Izaberite autobus i pritisnite „Pridruži se i vozi“."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionen är vald men inte ansluten än. Välj din buss och tryck på Anslut och kör."}},"th":{"stringUnit":{"state":"translated","value":"เลือกเซสชันแล้ว แต่ยังไม่ได้เชื่อมต่อ เลือกรถบัสแล้วกด “เข้าร่วมและขับรถ”"}},"fil":{"stringUnit":{"state":"translated","value":"Napili na ang session pero hindi pa nakakonekta. Pumili ng bus at pindutin ang Sumali at magmaneho."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum seçildi, henüz bağlanmadı. Otobüsünüzü seçin ve Katıl ve sür'e basın."}},"uk":{"stringUnit":{"state":"translated","value":"Сесію вибрано, але ще не підключено. Виберіть автобус і натисніть «Приєднатися і їхати»."}},"vi":{"stringUnit":{"state":"translated","value":"Đã chọn phiên nhưng chưa kết nối. Chọn xe buýt rồi nhấn Tham gia và lái xe."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已选择会话，但尚未连接。请选择巴士，再按“加入并驾驶”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已選擇房間，目前尚未連線。請選擇巴士，再按「加入並駕駛」。"}}}},
    "The system closed the game while it was running, typically because the device ran out of memory (RAM). Lowering texture resolution or reducing AI traffic in Settings helps prevent memory exhaustion.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"El sistema ha tancat el joc mentre funcionava, habitualment perquè el dispositiu s'ha quedat sense memòria RAM. Reduir la resolució de les textures o el trànsit d'IA a Configuració ajuda a evitar-ho."}},"de":{"stringUnit":{"state":"translated","value":"Das System hat das Spiel während des Laufens beendet, meist weil dem Gerät der Arbeitsspeicher (RAM) ausging. Eine niedrigere Texturauflösung oder weniger KI-Verkehr in den Einstellungen hilft, das zu vermeiden."}},"es":{"stringUnit":{"state":"translated","value":"El sistema ha cerrado el juego mientras se ejecutaba, normalmente por falta de memoria RAM. Reducir la resolución de las texturas o el tráfico de IA en Ajustes ayuda a evitarlo."}},"fr":{"stringUnit":{"state":"translated","value":"Le système a fermé le jeu pendant qu'il tournait, généralement parce que l'appareil a manqué de mémoire (RAM). Baisser la résolution des textures ou réduire la circulation IA dans les Réglages aide à l'éviter."}},"ka":{"stringUnit":{"state":"translated","value":"სისტემამ თამაში მუშაობისას დახურა, როგორც წესი, იმიტომ, რომ მოწყობილობას მეხსიერება (RAM) ამოეწურა. ტექსტურების გარჩევადობის შემცირება ან AI მოძრაობის შემცირება პარამეტრებში ამის თავიდან აცილებას უწყობს ხელს."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O sistema fechou o jogo enquanto ele estava em execução, normalmente porque o dispositivo ficou sem memória (RAM). Reduzir a resolução das texturas ou o tráfego de IA em Configurações ajuda a evitar falta de memória."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O sistema fechou o jogo enquanto estava em execução, normalmente porque o dispositivo ficou sem memória (RAM). Baixar a resolução das texturas ou reduzir o tráfego de IA nas Definições ajuda a evitar o esgotamento da memória."}},"ru":{"stringUnit":{"state":"translated","value":"Система закрыла игру во время работы, обычно из-за нехватки оперативной памяти (RAM). Снижение разрешения текстур или уменьшение ИИ-трафика в Настройках помогает избежать нехватки памяти."}},"sr":{"stringUnit":{"state":"translated","value":"Sistem je zatvorio igru dok je bila pokrenuta, obično zato što je uređaju ponestalo memorije (RAM). Smanjenje rezolucije teksture ili smanjenje AI saobraćaja u podešavanjima pomaže u sprečavanju iscrpljivanja memorije."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統在遊戲執行期間將它關閉，通常是因為記憶體（RAM）不足。在設定中降低材質解析度或減少 AI 交通，有助於避免記憶體耗盡。"}}}},
    "The timetable of {map_folder} has not been changed here": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Расклад {map_folder} тут не змяняўся"}},"ca":{"stringUnit":{"state":"translated","value":"L'horari de {map_folder} no s'ha canviat aquí"}},"cs":{"stringUnit":{"state":"translated","value":"Jízdní řád {map_folder} zde nebyl změněn"}},"de":{"stringUnit":{"state":"translated","value":"Der Fahrplan von {map_folder} wurde hier nicht geändert"}},"es":{"stringUnit":{"state":"translated","value":"El horario de {map_folder} no se ha cambiado aquí"}},"fr":{"stringUnit":{"state":"translated","value":"L'horaire de {map_folder} n'a pas été modifié ici"}},"hi":{"stringUnit":{"state":"translated","value":"{map_folder} का टाइमटेबल यहाँ नहीं बदला गया है"}},"hu":{"stringUnit":{"state":"translated","value":"{map_folder} menetrendje itt nem módosult"}},"id":{"stringUnit":{"state":"translated","value":"Jadwal {map_folder} belum diubah di sini"}},"it":{"stringUnit":{"state":"translated","value":"L'orario di {map_folder} non è stato modificato qui"}},"ja":{"stringUnit":{"state":"translated","value":"{map_folder} の時刻表はここでは変更されていません"}},"ka":{"stringUnit":{"state":"translated","value":"{map_folder}-ის განრიგი აქ არ შეცვლილა"}},"kk":{"stringUnit":{"state":"translated","value":"{map_folder} кестесі мұнда өзгертілмеген"}},"ko":{"stringUnit":{"state":"translated","value":"{map_folder}의 시간표는 여기서 변경되지 않았습니다"}},"ms":{"stringUnit":{"state":"translated","value":"Jadual {map_folder} belum diubah di sini"}},"nl":{"stringUnit":{"state":"translated","value":"De dienstregeling van {map_folder} is hier niet gewijzigd"}},"pl":{"stringUnit":{"state":"translated","value":"Rozkład {map_folder} nie był tu zmieniany"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A tabela horária de {map_folder} não foi alterada aqui"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O horário de {map_folder} não foi alterado aqui"}},"ru":{"stringUnit":{"state":"translated","value":"Расписание {map_folder} здесь не изменялось"}},"sr":{"stringUnit":{"state":"translated","value":"Red vožnje {map_folder} ovde nije promenjen"}},"sv":{"stringUnit":{"state":"translated","value":"Tidtabellen för {map_folder} har inte ändrats här"}},"th":{"stringUnit":{"state":"translated","value":"ตารางเวลาของ {map_folder} ไม่ได้ถูกเปลี่ยนที่นี่"}},"fil":{"stringUnit":{"state":"translated","value":"Hindi binago rito ang iskedyul ng {map_folder}"}},"tr":{"stringUnit":{"state":"translated","value":"{map_folder} tarifesi burada değiştirilmedi"}},"uk":{"stringUnit":{"state":"translated","value":"Розклад {map_folder} тут не змінювався"}},"vi":{"stringUnit":{"state":"translated","value":"Thời gian biểu của {map_folder} chưa được thay đổi ở đây"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"{map_folder} 的时刻表未在此处更改"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"{map_folder} 的時刻表未在此處變更"}}}},
    "The timetable of {map_folder} is the map's own again (the edited copy was removed)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Расклад {map_folder} зноў уласны расклад мапы (змененую копію выдалена)"}},"ca":{"stringUnit":{"state":"translated","value":"L'horari de {map_folder} torna a ser el del mapa (s'ha eliminat la còpia editada)"}},"cs":{"stringUnit":{"state":"translated","value":"Jízdní řád {map_folder} je opět vlastní jízdní řád mapy (upravená kopie byla odstraněna)"}},"de":{"stringUnit":{"state":"translated","value":"Der Fahrplan von {map_folder} ist wieder der eigene der Karte (die bearbeitete Kopie wurde entfernt)"}},"es":{"stringUnit":{"state":"translated","value":"El horario de {map_folder} vuelve a ser el propio del mapa (se eliminó la copia editada)"}},"fr":{"stringUnit":{"state":"translated","value":"L'horaire de {map_folder} est de nouveau celui de la carte (la copie modifiée a été supprimée)"}},"hi":{"stringUnit":{"state":"translated","value":"{map_folder} का टाइमटेबल फिर से मैप का अपना है (बदली गई कॉपी हटा दी गई)"}},"hu":{"stringUnit":{"state":"translated","value":"{map_folder} menetrendje ismét a térkép saját menetrendje (a szerkesztett másolat törölve)"}},"id":{"stringUnit":{"state":"translated","value":"Jadwal {map_folder} kembali menjadi milik peta itu sendiri (salinan yang diedit dihapus)"}},"it":{"stringUnit":{"state":"translated","value":"L'orario di {map_folder} è di nuovo quello della mappa (la copia modificata è stata rimossa)"}},"ja":{"stringUnit":{"state":"translated","value":"{map_folder} の時刻表はマップ本来のものに戻りました(編集したコピーは削除されました)"}},"ka":{"stringUnit":{"state":"translated","value":"{map_folder}-ის განრიგი კვლავ რუკისეულია (რედაქტირებული ასლი წაიშალა)"}},"kk":{"stringUnit":{"state":"translated","value":"{map_folder} кестесі қайтадан картаның өз кестесі (өзгертілген көшірме жойылды)"}},"ko":{"stringUnit":{"state":"translated","value":"{map_folder}의 시간표가 지도 원래의 시간표로 돌아왔습니다(편집한 사본은 삭제됨)"}},"ms":{"stringUnit":{"state":"translated","value":"Jadual {map_folder} kembali menjadi jadual asal peta (salinan yang disunting telah dibuang)"}},"nl":{"stringUnit":{"state":"translated","value":"De dienstregeling van {map_folder} is weer die van de kaart zelf (de bewerkte kopie is verwijderd)"}},"pl":{"stringUnit":{"state":"translated","value":"Rozkład {map_folder} jest znowu własnym rozkładem mapy (zmieniona kopia została usunięta)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A tabela horária de {map_folder} voltou a ser a original do mapa (a cópia editada foi removida)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"O horário de {map_folder} voltou a ser o original do mapa (a cópia editada foi removida)"}},"ru":{"stringUnit":{"state":"translated","value":"Расписание {map_folder} снова собственное расписание карты (изменённая копия удалена)"}},"sr":{"stringUnit":{"state":"translated","value":"Raspored {map_folder} je ponovo sopstveni mape (uređena kopija je uklonjena)"}},"sv":{"stringUnit":{"state":"translated","value":"Tidtabellen för {map_folder} är kartans egen igen (den redigerade kopian togs bort)"}},"th":{"stringUnit":{"state":"translated","value":"ตารางเวลาของ {map_folder} กลับเป็นของแผนที่เองแล้ว (ลบสำเนาที่แก้ไขแล้ว)"}},"fil":{"stringUnit":{"state":"translated","value":"Ang iskedyul ng {map_folder} ay muling sa mapa mismo (inalis ang na-edit na kopya)"}},"tr":{"stringUnit":{"state":"translated","value":"{map_folder} tarifesi yeniden haritanın kendi tarifesi (düzenlenen kopya kaldırıldı)"}},"uk":{"stringUnit":{"state":"translated","value":"Розклад {map_folder} знову власний розклад мапи (змінену копію видалено)"}},"vi":{"stringUnit":{"state":"translated","value":"Thời gian biểu của {map_folder} đã trở lại bản gốc của bản đồ (bản sao đã sửa đã bị xóa)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"{map_folder} 的时刻表已恢复为地图自己的时刻表（已删除编辑过的副本）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"{map_folder} 的時刻表已恢復為地圖自己的時刻表（編輯過的副本已移除）"}}}},
    "The tutorials come with OMSI 2 (its Tutorials folder).": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Els tutorials venen amb OMSI 2 (a la carpeta Tutorials)."}},"de":{"stringUnit":{"state":"translated","value":"Die Tutorials gehören zu OMSI 2 (sein Ordner Tutorials)."}},"es":{"stringUnit":{"state":"translated","value":"Los tutoriales se incluyen con OMSI 2 (carpeta Tutorials)."}},"fr":{"stringUnit":{"state":"translated","value":"Les tutoriels sont fournis avec OMSI 2 (son dossier Tutorials)."}},"ka":{"stringUnit":{"state":"translated","value":"გაკვეთილები OMSI 2-თან ერთად მოდის (მისი Tutorials საქაღალდე)."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os tutoriais vêm com o OMSI 2 (a pasta Tutorials dele)."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Os tutoriais vêm com o OMSI 2 (a sua pasta Tutorials)."}},"ru":{"stringUnit":{"state":"translated","value":"Обучение идёт вместе с OMSI 2 (её папка Tutorials)."}},"sr":{"stringUnit":{"state":"translated","value":"Uputstva dolaze sa OMSI 2 (njegova fascikla Tutorials)."}},"sv":{"stringUnit":{"state":"translated","value":"Handledningar följer med OMSI 2 (dess Tutorials-mapp)."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"教學隨 OMSI 2 提供（位於 Tutorials 資料夾）。"}}}},
    "These HOF files were already there.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гэтыя файлы HOF ужо былі дададзены."}},"ca":{"stringUnit":{"state":"translated","value":"Aquests fitxers HOF ja hi eren."}},"cs":{"stringUnit":{"state":"translated","value":"Tyto soubory HOF už tam byly."}},"de":{"stringUnit":{"state":"translated","value":"Diese HOF-Dateien waren bereits vorhanden."}},"es":{"stringUnit":{"state":"translated","value":"Estos archivos HOF ya estaban."}},"fr":{"stringUnit":{"state":"translated","value":"Ces fichiers HOF étaient déjà là."}},"hi":{"stringUnit":{"state":"translated","value":"ये HOF फ़ाइलें पहले से मौजूद थीं।"}},"hu":{"stringUnit":{"state":"translated","value":"Ezek a HOF-fájlok már megvoltak."}},"id":{"stringUnit":{"state":"translated","value":"File HOF ini sudah ada."}},"it":{"stringUnit":{"state":"translated","value":"Questi file HOF c'erano già."}},"ja":{"stringUnit":{"state":"translated","value":"これらのHOFファイルは既にあります。"}},"ka":{"stringUnit":{"state":"translated","value":"ეს HOF ფაილები უკვე არსებობდა."}},"kk":{"stringUnit":{"state":"translated","value":"Бұл HOF файлдары бұрыннан бар."}},"ko":{"stringUnit":{"state":"translated","value":"이 HOF 파일은 이미 있습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Fail HOF ini sudah ada."}},"nl":{"stringUnit":{"state":"translated","value":"Deze HOF-bestanden waren er al."}},"pl":{"stringUnit":{"state":"translated","value":"Te pliki HOF już były dodane."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esses arquivos HOF já estavam lá."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Estes ficheiros HOF já lá estavam."}},"ru":{"stringUnit":{"state":"translated","value":"Эти файлы HOF уже были добавлены."}},"sr":{"stringUnit":{"state":"translated","value":"Ove HOF datoteke su već bile prisutne."}},"sv":{"stringUnit":{"state":"translated","value":"De här HOF-filerna fanns redan."}},"th":{"stringUnit":{"state":"translated","value":"มีไฟล์ HOF เหล่านี้อยู่แล้ว"}}