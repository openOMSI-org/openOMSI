    "The driver whose personnel file the game writes: hours, kilometres, punctuality, tickets.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вадзіцель, чыю асабістую справу вядзе гульня: гадзіны, кіламетры, пунктуальнасць, білеты."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El conductor del qual el joc desa l'expedient: hores, quilòmetres, puntualitat i bitllets."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řidič, jehož osobní spis hra vede: hodiny, kilometry, dochvilnost, jízdenky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fahrer, dessen Personalakte das Spiel führt: Stunden, Kilometer, Pünktlichkeit, Fahrscheine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El conductor cuyo expediente escribe el juego: horas, kilómetros, puntualidad, billetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le conducteur dont le jeu maintient le dossier : heures, kilomètres, ponctualité, billets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह ड्राइवर जिसकी पर्सनल फ़ाइल गेम लिखता है: घंटे, किलोमीटर, समय-पालन, टिकट।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sofőr, akinek a személyi lapját a játék vezeti: Órák, kilométerek, pontosság, jegyeladások és sok más."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Game mencatat jam, kilometer, ketepatan waktu, dan tiket pengemudi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conducente del cui fascicolo personale il gioco tiene traccia: ore, chilometri, puntualità, biglietti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームが人事ファイルに記録する運転手:時間、キロ数、定時性、乗車券。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ойын жеке іс парағын жазатын жүргізуші: сағаттар, километрлер, тұрақтылық, билеттер."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 이 운전자의 운전 시간, 거리, 정시성, 승차권 판매를 기록합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permainan merekod jam, kilometer, ketepatan masa dan tiket pemandu ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestuurder van wie het spel het personeelsdossier bijhoudt: uren, kilometers, punctualiteit, kaartjes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierowca, dla którego gra prowadzi akta osobowe: godziny, kilometry, punktualność, bilety."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motorista cujo registro o jogo mantém: horas, quilômetros, pontualidade e passagens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O condutor cujo registro o jogo mantém: horas, quilómetros, pontualidade e bilhetes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Водитель, в личное дело которого игра пишет: часы, километры, пунктуальность, билеты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกมจะบันทึกชั่วโมงขับรถ ระยะทาง ความตรงเวลา และการขายตั๋วของคนขับนี้"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinatala ng laro ang oras, kilometro, pagiging nasa oras at tickets ng driver na ito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun özlük dosyasını yazdığı sürücü: saat, kilometre, dakiklik, biletler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Водій, чиє особове діло веде гра: години, кілометри, пунктуальність, квитки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chơi ghi lại số giờ lái, quãng đường, độ đúng giờ và vé đã bán của tài xế này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏为其写入人事档案的司机:工时、公里数、准点率、车票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲會為這名司機記錄駕駛時數、里程、準時率及售票數據。"
          }
        }
      }
    },
