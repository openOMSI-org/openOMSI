    "None (frozen picture)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Няма (нерухомая карцінка)"}},"ca":{"stringUnit":{"state":"translated","value":"Cap (imatge congelada)"}},"cs":{"stringUnit":{"state":"translated","value":"Žádné (statický obraz)"}},"de":{"stringUnit":{"state":"translated","value":"Keine (eingefrorenes Bild)"}},"es":{"stringUnit":{"state":"translated","value":"Ninguno (imagen fija)"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune (image fixe)"}},"hi":{"stringUnit":{"state":"translated","value":"कोई नहीं (स्थिर चित्र)"}},"hu":{"stringUnit":{"state":"translated","value":"Nincs (állókép)"}},"id":{"stringUnit":{"state":"translated","value":"Tidak ada (gambar diam)"}},"it":{"stringUnit":{"state":"translated","value":"Nessuno (immagine fissa)"}},"ja":{"stringUnit":{"state":"translated","value":"なし（静止画）"}},"ka":{"stringUnit":{"state":"translated","value":"არცერთი (გაყინული სურათი)"}},"kk":{"stringUnit":{"state":"translated","value":"Жоқ (қозғалмайтын сурет)"}},"ko":{"stringUnit":{"state":"translated","value":"없음 (정지 화면)"}},"ms":{"stringUnit":{"state":"translated","value":"Tiada (gambar pegun)"}},"nl":{"stringUnit":{"state":"translated","value":"Geen (stilstaand beeld)"}},"pl":{"stringUnit":{"state":"translated","value":"Brak (nieruchomy obraz)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhum (imagem parada)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nenhum (imagem fixa)"}},"ru":{"stringUnit":{"state":"translated","value":"Нет (неподвижная картинка)"}},"sr":{"stringUnit":{"state":"translated","value":"Nema (zamrznuta slika)"}},"sv":{"stringUnit":{"state":"translated","value":"Inga (fryst bild)"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มี (ภาพนิ่ง)"}},"fil":{"stringUnit":{"state":"translated","value":"Wala (hindi gumagalaw na larawan)"}},"tr":{"stringUnit":{"state":"translated","value":"Yok (sabit görüntü)"}},"uk":{"stringUnit":{"state":"translated","value":"Немає (нерухоме зобра