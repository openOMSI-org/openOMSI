    "Showing the first {shown} of {n}: search to narrow the list.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Паказаны першыя {shown} з {n}: скарыстайцеся пошукам, каб звузіць спіс."}},"ca":{"stringUnit":{"state":"translated","value":"Es mostren els primers {shown} de {n}: cerca per reduir la llista."}},"cs":{"stringUnit":{"state":"translated","value":"Zobrazeno prvních {shown} z {n}: vyhledáváním seznam zúžíte."}},"de":{"stringUnit":{"state":"translated","value":"Die ersten {shown} von {n} werden gezeigt: Suche, um die Liste einzugrenzen."}},"es":{"stringUnit":{"state":"translated","value":"Se muestran los primeros {shown} de {n}: busca para acotar la lista."}},"fr":{"stringUnit":{"state":"translated","value":"Affichage des {shown} premiers sur {n} : cherchez pour réduire la liste."}},"hi":{"stringUnit":{"state":"translated","value":"{n} में से पहले {shown} दिखाए जा रहे हैं: सूची छोटी करने के लिए खोजें।"}},"hu":{"stringUnit":{"state":"translated","value":"Az első {shown} látható a(z) {n} közül: keress a lista szűkítéséhez."}},"id":{"stringUnit":{"state":"translated","value":"Menampilkan {shown} pertama dari {n}: cari untuk mempersempit daftar."}},"it":{"stringUnit":{"state":"translated","value":"Mostrati i primi {shown} su {n}: cerca per restringere l'elenco."}},"ja":{"stringUnit":{"state":"translated","value":"{n} 件中、最初の {shown} 件を表示中: 検索して絞り込んでください。"}},"ka":{"stringUnit":{"state":"translated","value":"ნაჩვენებია პირველი {shown}, სულ {n}: სიის შესავიწროებლად გამოიყენეთ ძებნა."}},"kk":{"stringUnit":{"state":"translated","value":"{n} ішінен алғашқы {shown} көрсетілген: тізімді тарылту үшін іздеңіз."}},"ko":{"stringUnit":{"state":"translated","value":"{n}개 중 처음 {shown}개 표시: 검색해서 목록을 좁히세요."}},"ms":{"stringUnit":{"state":"translated","value":"Menunjukkan {shown} yang pertama daripada {n}: cari untuk mengecilkan senarai."}},"nl":{"stringUnit":{"state":"translated","value":"De eerste {shown} van {n} worden getoond: zoek om de lijst te verkleinen."}},"pl":{"stringUnit":{"state":"translated","value":"Pokazano pierwsze {shown} z {n}: wyszukaj, aby zawęzić listę."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mostrando os primeiros {shown} de {n}: pesquise para reduzir a lista."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A mostrar os primeiros {shown} de {n}: pesquise para reduzir a lista."}},"ru":{"stringUnit":{"state":"translated","value":"Показаны первые {shown} из {n}: воспользуйтесь поиском, чтобы сузить список."}},"sr":{"stringUnit":{"state":"translated","value":"Prikaz prvih {shown} od {n}: pretražite da biste suzili listu."}},"th":{"stringUnit":{"state":"translated","value":"แสดง {shown} รายการแรกจาก {n}: ค้นหาเพื่อให้รายการแคบลง"}},"fil":{"stringUnit":{"state":"translated","value":"Ipinapakita ang unang {shown} sa {n}: maghanap para paliitin ang listahan."}},"tr":{"stringUnit":{"state":"translated","value":"{n} sonucun ilk {shown} tanesi gösteriliyor: listeyi daraltmak için arayın."}},"uk":{"stringUnit":{"state":"translated","value":"Показано перші {shown} з {n}: скористайтеся пошуком, щоб звузити список."}},"vi":{"stringUnit":{"state":"translated","value":"Đang hiện {shown} mục đầu trong {n}: hãy tìm kiếm để thu hẹp danh sách."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示 {n} 项中的前 {shown} 项：请搜索以缩小列表。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示 {n} 項中的前 {shown} 項：請搜尋以縮小清單。"}}}},
    "Shows the launcher or your map, bus, line and multiplayer status in Discord.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Mostra el launcher o el mapa, l'autobús, la línia i l'estat multijugador a Discord."}},"de":{"stringUnit":{"state":"translated","value":"Zeigt den Launcher oder Karten-, Bus-, Linien- und Mehrspieler-Status auf Discord."}},"es":{"stringUnit":{"state":"translated","value":"Muestra el lanzador o el mapa, el autobús, la línea y el estado multijugador en Discord."}},"fr":{"stringUnit":{"state":"translated","value":"Affiche dans Discord le lanceur ou votre carte, votre bus, votre ligne et votre statut multijoueur."}},"ka":{"stringUnit":{"state":"translated","value":"Discord-ში აჩვენებს გამშვებს ან თქვენს რუკას, ავტობუსს, ხაზს და მრავალმოთამაშიან სტატუსს."}},"nl":{"stringUnit":{"state":"translated","value":"Toont de launcher of je kaart, bus, lijn en multiplayerstatus op Discord."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mostra no Discord o launcher ou o status do seu mapa, ônibus, linha e multijogador."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Mostra no Discord o launcher ou o estado do seu mapa, autocarro, linha e multijogador."}},"ru":{"stringUnit":{"state":"translated","value":"Показывает лаунчер или вашу карту, автобус, маршрут и статус мультиплеера в Discord."}},"sr":{"stringUnit":{"state":"translated","value":"Prikazuje pokretač ili status vaše mape, autobusa, linije i više igrača u Discord-u."}},"sv":{"stringUnit":{"state":"translated","value":"Visar startprogrammet eller din karta, buss, linje och flerspelarstatus i Discord."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Discord 中显示启动器或你的地图、巴士、线路和多人游戏状态。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在 Discord 中顯示啟動器或您的地圖、巴士、線路和多人遊戲狀態。"}}}},
