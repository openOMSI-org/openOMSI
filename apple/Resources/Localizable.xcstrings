    "Start one on the Drive page.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Inicia'n una a la pàgina Condueix."}},"de":{"stringUnit":{"state":"translated","value":"Starte eines auf der Seite „Fahren“."}},"es":{"stringUnit":{"state":"translated","value":"Inicia una en la página Conducir."}},"fr":{"stringUnit":{"state":"translated","value":"Lancez-en une depuis la page Conduire."}},"ka":{"stringUnit":{"state":"translated","value":"დაიწყეთ „მართვის“ გვერდიდან."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicie um na página Dirigir."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Inicie um na página Conduzir."}},"ru":{"stringUnit":{"state":"translated","value":"Запустите её на странице «Поездка»."}},"sr":{"stringUnit":{"state":"translated","value":"Pokrenite jedan na stranici Drive."}},"sv":{"stringUnit":{"state":"translated","value":"Starta ett på sidan Kör."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請在「駕駛」頁面開始遊戲。"}}}},
    "Start the duty": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Пачаць наряд"}},"ca":{"stringUnit":{"state":"translated","value":"Inicia el servei"}},"cs":{"stringUnit":{"state":"translated","value":"Zahájit službu"}},"de":{"stringUnit":{"state":"translated","value":"Dienst beginnen"}},"es":{"stringUnit":{"state":"translated","value":"Iniciar el servicio"}},"fr":{"stringUnit":{"state":"translated","value":"Commencer le service"}},"hi":{"stringUnit":{"state":"translated","value":"ड्यूटी शुरू करें"}},"hu":{"stringUnit":{"state":"translated","value":"Szolgálat indítása"}},"id":{"stringUnit":{"state":"translated","value":"Mulai tugas"}},"it":{"stringUnit":{"state":"translated","value":"Avvia il turno"}},"ja":{"stringUnit":{"state":"translated","value":"乗務を開始"}},"ka":{"stringUnit":{"state":"translated","value":"რეისის დაწყება"}},"kk":{"stringUnit":{"state":"translated","value":"Нарядты бастау"}},"ko":{"stringUnit":{"state":"translated","value":"근무 시작"}},"ms":{"stringUnit":{"state":"translated","value":"Mulakan tugas"}},"nl":{"stringUnit":{"state":"translated","value":"Dienst starten"}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij służbę"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar a escala"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Iniciar a escala"}},"ru":{"stringUnit":{"state":"translated","value":"Начать смену"}},"sr":{"stringUnit":{"state":"translated","value":"Započnite dužnost"}},"sv":{"stringUnit":{"state":"translated","value":"Starta tjänsten"}},"th":{"stringUnit":{"state":"translated","value":"เริ่มหน้าที่"}},"fil":{"stringUnit":{"state":"translated","value":"Simulan ang duty"}},"tr":{"stringUnit":{"state":"translated","value":"Görevi başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Почати наряд"}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu ca"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始运营任务"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開始更次"}}}},
    "Start the duty to create your session, then return to Multiplayer to copy the code.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Пачніце наряд, каб стварыць сесію, потым вярніцеся ў «Мультыплеер», каб скапіяваць код."}},"ca":{"stringUnit":{"state":"translated","value":"Inicia el servei per crear la teva sessió i després torna a Multijugador per copiar el codi."}},"cs":{"stringUnit":{"state":"translated","value":"Spuštěním služby vytvoříte relaci; pak se vraťte do sekce Multiplayer a zkopírujte kód."}},"de":{"stringUnit":{"state":"translated","value":"Starte den Dienst, um deine Sitzung zu erstellen, und kehre dann zu „Mehrspieler“ zurück, um den Code zu kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Inicia el servicio para crear tu sesión y luego vuelve a Multijugador para copiar el código."}},"fr":{"stringUnit":{"state":"translated","value":"Lancez le service pour créer votre session, puis revenez dans Multijoueur pour copier le code."}},"hi":{"stringUnit":{"state":"translated","value":"सेशन बनाने के लिए ड्यूटी शुरू करें, फिर कोड कॉपी करने के लिए मल्टीप्लेयर पर लौटें।"}},"hu":{"stringUnit":{"state":"translated","value":"Indítsd el a szolgálatot a munkamenet létrehozásához, majd térj vissza a Többjátékos mód oldalra a kód másolásához."}},"id":{"stringUnit":{"state":"translated","value":"Mulai tugas untuk membuat sesi, lalu kembali ke Multipemain untuk menyalin kode."}},"it":{"stringUnit":{"state":"translated","value":"Avvia il turno per creare la sessione, poi torna a Multigiocatore per copiare il codice."}},"ja":{"stringUnit":{"state":"translated","value":"乗務を開始するとセッションが作成されます。その後「マルチプレイ」に戻ってコードをコピーします。"}},"ka":{"stringUnit":{"state":"translated","value":"დაიწყეთ რეისი სესიის შესაქმნელად, შემდეგ დაბრუნდით „მრავალმოთამაშიანში“ კოდის დასაკოპირებლად."}},"kk":{"stringUnit":{"state":"translated","value":"Сессия жасау үшін нарядты бастаңыз, сосын кодты көшіру үшін «Мультиплеер» бөліміне оралыңыз."}},"ko":{"stringUnit":{"state":"translated","value":"근무를 시작하면 세션이 만들어집니다. 그런 다음 '멀티플레이'로 돌아가 코드를 복사하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Mulakan tugas untuk mencipta sesi, kemudian kembali ke Berbilang pemain untuk menyalin kod."}},"nl":{"stringUnit":{"state":"translated","value":"Start de dienst om je sessie te maken en ga dan terug naar Multiplayer om de code te kopiëren."}},"pl":{"stringUnit":{"state":"translated","value":"Rozpocznij służbę, aby utworzyć sesję, a potem wróć do sekcji Multiplayer, aby skopiować kod."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Inicie a escala para criar sua sessão e depois volte para Multijogador para copiar o código."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Inicie a escala para criar a sua sessão e depois volte a Multijogador para copiar o código."}},"ru":{"stringUnit":{"state":"translated","value":"Начните смену, чтобы создать сессию, затем вернитесь в «Мультиплеер», чтобы скопировать код."}},"sr":{"stringUnit":{"state":"translated","value":"Pokrenite smenu da biste kreirali sesiju, pa se vratite na stranicu „Više igrača“ da kopirate kod."}},"sv":{"stringUnit":{"state":"translated","value":"Starta tjänsten för att skapa din session och gå sedan tillbaka till Flerspelarläge för att kopiera koden."}},"th":{"stringUnit":{"state":"translated","value":"เริ่มหน้าที่เพื่อสร้างเซสชัน แล้วกลับไปที่ “ผู้เล่นหลายคน” เพื่อคัดลอกรหัส"}},"fil":{"stringUnit":{"state":"translated","value":"Simulan ang duty para malikha ang session mo, saka bumalik sa Multiplayer para kopyahin ang code."}},"tr":{"stringUnit":{"state":"translated","value":"Oturumunuzu oluşturmak için görevi başlatın, sonra kodu kopyalamak için Çok oyunculu bölümüne dönün."}},"uk":{"stringUnit":{"state":"translated","value":"Почніть наряд, щоб створити сесію, потім поверніться в «Мультиплеєр», щоб скопіювати код."}},"vi":{"stringUnit":{"state":"translated","value":"Bắt đầu ca để tạo phiên, rồi quay lại Chơi nhiều người để sao chép mã."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始任务后才会创建会话，再回到“多人游戏”复制会话码。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開始班次後才會建立房間，再回到「多人遊戲」複製連線碼。"}}}},
