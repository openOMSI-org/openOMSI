    "Start with a comfortable cabin temperature": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Пачынаць з камфортнай тэмпературай у салоне"}},"ca":{"stringUnit":{"state":"translated","value":"Comença amb una temperatura interior agradable"}},"cs":{"stringUnit":{"state":"translated","value":"Začít s příjemnou teplotou v interiéru"}},"de":{"stringUnit":{"state":"translated","value":"Mit angenehmer Innenraumtemperatur starten"}},"es":{"stringUnit":{"state":"translated","value":"Empezar con una temperatura interior agradable"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrer avec une température intérieure confortable"}},"hi":{"stringUnit":{"state":"translated","value":"आरामदायक आंतरिक तापमान के साथ शुरू करें"}},"hu":{"stringUnit":{"state":"translated","value":"Kellemes utastéri hőmérséklettel kezdés"}},"id":{"stringUnit":{"state":"translated","value":"Mulai dengan suhu kabin yang nyaman"}},"it":{"stringUnit":{"state":"translated","value":"Inizia con una temperatura interna confortevole"}},"ja":{"stringUnit":{"state":"translated","value":"快適な車内温度で開始する"}},"ka":{"stringUnit":{"state":"translated","value":"დაწყება სალონის კომფორტული ტემპერატურით"}},"kk":{"stringUnit":{"state":"translated","value":"Салондағы жайлы температурамен бастау"}},"ko":{"stringUnit":{"state":"translated","value":"쾌적한 실내 온도로 시작"}},"ms":{"stringUnit":{"state":"translated","value":"Mulakan dengan suhu kabin yang selesa"}},"nl":{"stringUnit":{"state":"translated","value":"Start met een aangename binnentemperatuur"}},"pl":{"stringUnit":{"state":"translated","value":"Zacznij z komfortową temperaturą wewnątrz"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Iniciar com uma temperatura interna confortável"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Começar com uma temperatura interior confortável"}},"ru":{"stringUnit":{"state":"translated","value":"Начинать с комфортной температурой в салоне"}},"sr":{"stringUnit":{"state":"translated","value":"Počni sa pr