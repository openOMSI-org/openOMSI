    "This is not a complete OMSI 2 installation.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Гэта не поўная ўсталёўка OMSI 2."}},"ca":{"stringUnit":{"state":"translated","value":"Això no és una còpia completa d'OMSI 2."}},"cs":{"stringUnit":{"state":"translated","value":"Toto není úplná instalace OMSI 2."}},"de":{"stringUnit":{"state":"translated","value":"Das ist keine vollständige OMSI-2-Installation."}},"es":{"stringUnit":{"state":"translated","value":"Esta no es una instalación completa de OMSI 2."}},"fr":{"stringUnit":{"state":"translated","value":"Ce n'est pas une installation complète d'OMSI 2."}},"hi":{"stringUnit":{"state":"translated","value":"यह OMSI 2 का पूरा इंस्टॉलेशन नहीं है।"}},"hu":{"stringUnit":{"state":"translated","value":"Ez nem teljes OMSI 2-telepítés."}},"id":{"stringUnit":{"state":"translated","value":"Ini bukan instalasi OMSI 2 yang lengkap."}},"it":{"stringUnit":{"state":"translated","value":"Questa non è un'installazione completa di OMSI 2."}},"ja":{"stringUnit":{"state":"translated","value":"これは完全なOMSI 2のインストールではありません。"}},"ka":{"stringUnit":{"state":"translated","value":"ეს არ არის OMSI 2-ის სრული ინსტალაცია."}},"kk":{"stringUnit":{"state":"translated","value":"Бұл OMSI 2-нің толық орнатылымы емес."}},"ko":{"stringUnit":{"state":"translated","value":"완전한 OMSI 2 설치가 아닙니다."}},"ms":{"stringUnit":{"state":"translated","value":"Ini bukan pemasangan OMSI 2 yang lengkap."}},"nl":{"stringUnit":{"state":"translated","value":"Dit is geen volledige installatie van OMSI 2."}},"pl":{"stringUnit":{"state":"translated","value":"To nie jest pełna instalacja OMSI 2."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta não é uma instalação completa do OMSI 2."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Esta não é uma instalação completa do OMSI 2."}},"ru":{"stringUnit":{"state":"translated","value":"Это не полная установка OMSI 2."}},"sr":{"stringUnit":{"state":"translated","value":"Ovo nije kompletna OMSI 2 in