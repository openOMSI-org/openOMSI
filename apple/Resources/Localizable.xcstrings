    "Choose a line": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Выберыце лінію"}},"ca":{"stringUnit":{"state":"translated","value":"Tria una línia"}},"cs":{"stringUnit":{"state":"translated","value":"Vyberte linku"}},"de":{"stringUnit":{"state":"translated","value":"Linie wählen"}},"es":{"stringUnit":{"state":"translated","value":"Elige una línea"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir une ligne"}},"hi":{"stringUnit":{"state":"translated","value":"लाइन चुनें"}},"hu":{"stringUnit":{"state":"translated","value":"Válassz járatot"}},"id":{"stringUnit":{"state":"translated","value":"Pilih jalur"}},"it":{"stringUnit":{"state":"translated","value":"Scegli una linea"}},"ja":{"stringUnit":{"state":"translated","value":"系統を選択"}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ ხაზი"}},"kk":{"stringUnit":{"state":"translated","value":"Желіні таңдаңыз"}},"ko":{"stringUnit":{"state":"translated","value":"노선 선택"}},"ms":{"stringUnit":{"state":"translated","value":"Pilih laluan"}},"nl":{"stringUnit":{"state":"translated","value":"Kies een lijn"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz linię"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha uma linha"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha uma linha"}},"ru":{"stringUnit":{"state":"translated","value":"Выберите маршрут"}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite liniju"}},"sv":{"stringUnit":{"state":"translated","value":"Välj en linje"}},"th":{"stringUnit":{"state":"translated","value":"เลือกสายรถ"}},"fil":{"stringUnit":{"state":"translated","value":"Pumili ng linya"}},"tr":{"stringUnit":{"state":"translated","value":"Bir hat seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Оберіть лінію"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn tuyến"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择线路"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇路線"}}}},
    "Choose a map": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Абярыце мапу"}},"ca":{"stringUnit":{"state":"translated","value":"Tria un mapa"}},"cs":{"stringUnit":{"state":"translated","value":"Vyberte mapu"}},"de":{"stringUnit":{"state":"translated","value":"Karte wählen"}},"es":{"stringUnit":{"state":"translated","value":"Elige un mapa"}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez une carte"}},"hi":{"stringUnit":{"state":"translated","value":"मैप चुनें"}},"hu":{"stringUnit":{"state":"translated","value":"Válassz térképet"}},"id":{"stringUnit":{"state":"translated","value":"Pilih peta"}},"it":{"stringUnit":{"state":"translated","value":"Scegli una mappa"}},"ja":{"stringUnit":{"state":"translated","value":"マップを選択"}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ რუკა"}},"kk":{"stringUnit":{"state":"translated","value":"Картаны таңдаңыз"}},"ko":{"stringUnit":{"state":"translated","value":"지도 선택"}},"ms":{"stringUnit":{"state":"translated","value":"Pilih peta"}},"nl":{"stringUnit":{"state":"translated","value":"Kies een kaart"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz mapę"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha um mapa"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha um mapa"}},"ru":{"stringUnit":{"state":"translated","value":"Выбор карты"}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite mapu"}},"sv":{"stringUnit":{"state":"translated","value":"Välj en karta"}},"th":{"stringUnit":{"state":"translated","value":"เลือกแผนที่"}},"fil":{"stringUnit":{"state":"translated","value":"Pumili ng mapa"}},"tr":{"stringUnit":{"state":"translated","value":"Bir harita seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Оберіть мапу"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn bản đồ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择地图"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇地圖"}}}},
    "Choose the folder": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Абраць тэчку"}},"ca":{"stringUnit":{"state":"translated","value":"Tria la carpeta"}},"cs":{"stringUnit":{"state":"translated","value":"Vybrat složku"}},"de":{"stringUnit":{"state":"translated","value":"Ordner wählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir la carpeta"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir le dossier"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोल्डर चुनें"}},"hu":{"stringUnit":{"state":"translated","value":"Mappa kiválasztása"}},"id":{"stringUnit":{"state":"translated","value":"Pilih folder"}},"it":{"stringUnit":{"state":"translated","value":"Scegli la cartella"}},"ja":{"stringUnit":{"state":"translated","value":"フォルダを選択"}},"ka":{"stringUnit":{"state":"translated","value":"საქაღალდის არჩევა"}},"kk":{"stringUnit":{"state":"translated","value":"Қалтаны таңдау"}},"ko":{"stringUnit":{"state":"translated","value":"폴더 선택"}},"ms":{"stringUnit":{"state":"translated","value":"Pilih folder"}},"nl":{"stringUnit":{"state":"translated","value":"Kies de map"}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz folder"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher a pasta"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolher a pasta"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать папку"}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite fasciklu"}},"sv":{"stringUnit":{"state":"translated","value":"Välj mappen"}},"th":{"stringUnit":{"state":"translated","value":"เลือกโฟลเดอร์"}},"fil":{"stringUnit":{"state":"translated","value":"Piliin ang folder"}},"tr":{"stringUnit":{"state":"translated","value":"Klasörü seçin"}},"uk":{"stringUnit":{"state":"translated","value":"Обрати теку"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn thư mục"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择文件夹"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇資料夾"}}}},
    "Choose the folder on the drive.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Абярыце тэчку на назапашвальніку."}},"ca":{"stringUnit":{"state":"translated","value":"Tria la carpeta de la memòria."}},"cs":{"stringUnit":{"state":"translated","value":"Vyberte složku na disku."}},"de":{"stringUnit":{"state":"translated","value":"Wähle den Ordner auf dem Stick."}},"es":{"stringUnit":{"state":"translated","value":"Elige la carpeta de la memoria."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez le dossier sur la clé."}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइव पर फ़ोल्डर चुनें।"}},"hu":{"stringUnit":{"state":"translated","value":"Válaszd ki a mappát a meghajtón."}},"id":{"stringUnit":{"state":"translated","value":"Pilih folder di drive."}},"it":{"stringUnit":{"state":"translated","value":"Scegli la cartella sulla chiavetta."}},"ja":{"stringUnit":{"state":"translated","value":"ドライブ内のフォルダを選択します。"}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ საქაღალდე დისკზე."}},"kk":{"stringUnit":{"state":"translated","value":"Жинақтағыштағы қалтаны таңдаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"드라이브에서 폴더를 선택하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pilih folder dalam pemacu."}},"nl":{"stringUnit":{"state":"translated","value":"Kies de map op de stick."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz folder na dysku."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha a pasta no pendrive."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha a pasta na pen."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите папку на накопителе."}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite fasciklu na disku."}},"sv":{"stringUnit":{"state":"translated","value":"Välj mappen på USB-minnet."}},"th":{"stringUnit":{"state":"translated","value":"เลือกโฟลเดอร์ในไดรฟ์"}},"fil":{"stringUnit":{"state":"translated","value":"Piliin ang folder sa drive."}},"tr":{"stringUnit":{"state":"translated","value":"Bellekteki klasörü seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Оберіть теку на накопичувачі."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn thư mục trên ổ."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择U盘上的文件夹。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇隨身碟上的資料夾。"}}}},
    "Choose where and what you drive, then start.": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Tria on i què vols conduir i, després, inicia la partida."}},"de":{"stringUnit":{"state":"translated","value":"Wähle, wo und womit du fährst, dann los."}},"es":{"stringUnit":{"state":"translated","value":"Elige dónde y qué vas a conducir, y empieza."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez où et quoi conduire, puis lancez."}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ, სად და რას მართავთ, შემდეგ დაიწყეთ."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha onde e o que você vai dirigir e comece."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha onde e o que conduz e depois comece."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите, где и на чём поедете, и стартуйте."}},"sr":{"stringUnit":{"state":"translated","value":"Odaberite gde i šta vozite, a zatim počnite."}},"sv":{"stringUnit":{"state":"translated","value":"Välj var och vad du kör och starta sedan."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇駕駛地點與車輛，然後開始。"}}}},
    "Choose your bus next. The game connects only when you start driving.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Цяпер выберыце аўтобус. Гульня падключыцца, толькі калі вы пачняце ехаць."}},"ca":{"stringUnit":{"state":"translated","value":"Ara tria l'autobús. El joc només es connecta quan comences a conduir."}},"cs":{"stringUnit":{"state":"translated","value":"Teď vyberte autobus. Hra se připojí, až když začnete jet."}},"de":{"stringUnit":{"state":"translated","value":"Wähle als Nächstes deinen Bus. Das Spiel verbindet sich erst, wenn du losfährst."}},"es":{"stringUnit":{"state":"translated","value":"Ahora elige tu autobús. El juego solo se conecta cuando empiezas a conducir."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez ensuite votre bus. Le jeu ne se connecte que lorsque vous commencez à conduire."}},"hi":{"stringUnit":{"state":"translated","value":"अब अपनी बस चुनें। गेम तभी जुड़ता है जब आप चलाना शुरू करते हैं।"}},"hu":{"stringUnit":{"state":"translated","value":"Most válassz buszt. A játék csak akkor csatlakozik, amikor elindulsz."}},"id":{"stringUnit":{"state":"translated","value":"Selanjutnya pilih bus Anda. Game baru terhubung saat Anda mulai mengemudi."}},"it":{"stringUnit":{"state":"translated","value":"Ora scegli il tuo autobus. Il gioco si connette solo quando inizi a guidare."}},"ja":{"stringUnit":{"state":"translated","value":"次にバスを選んでください。運転を始めたときに初めて接続します。"}},"ka":{"stringUnit":{"state":"translated","value":"შემდეგ აირჩიეთ ავტობუსი. თამაში მხოლოდ მართვის დაწყებისას დაუკავშირდება."}},"kk":{"stringUnit":{"state":"translated","value":"Енді автобусыңызды таңдаңыз. Ойын жүруді бастағанда ғана қосылады."}},"ko":{"stringUnit":{"state":"translated","value":"이제 버스를 선택하세요. 운전을 시작해야 실제로 연결됩니다."}},"ms":{"stringUnit":{"state":"translated","value":"Seterusnya pilih bas anda. Permainan hanya bersambung apabila anda mula memandu."}},"nl":{"stringUnit":{"state":"translated","value":"Kies nu je bus. Het spel maakt pas verbinding als je begint te rijden."}},"pl":{"stringUnit":{"state":"translated","value":"Teraz wybierz autobus. Gra połączy się dopiero, gdy zaczniesz jechać."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Agora escolha seu ônibus. O jogo só se conecta quando você começar a dirigir."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Agora escolha o seu autocarro. O jogo só se liga quando começar a conduzir."}},"ru":{"stringUnit":{"state":"translated","value":"Теперь выберите автобус. Игра подключится, только когда вы начнёте поездку."}},"sr":{"stringUnit":{"state":"translated","value":"Sada izaberite autobus. Igra će se povezati tek kada započnete vožnju."}},"sv":{"stringUnit":{"state":"translated","value":"Välj din buss härnäst. Spelet ansluter först när du börjar köra."}},"th":{"stringUnit":{"state":"translated","value":"ขั้นต่อไปให้เลือกรถบัส เกมจะเชื่อมต่อเมื่อคุณเริ่มขับเท่านั้น"}},"fil":{"stringUnit":{"state":"translated","value":"Susunod, pumili ng bus mo. Kumokonekta lang ang laro kapag nagsimula ka nang magmaneho."}},"tr":{"stringUnit":{"state":"translated","value":"Şimdi otobüsünüzü seçin. Oyun yalnızca sürmeye başladığınızda bağlanır."}},"uk":{"stringUnit":{"state":"translated","value":"Тепер виберіть автобус. Гра підключиться, лише коли ви почнете їхати."}},"vi":{"stringUnit":{"state":"translated","value":"Tiếp theo, hãy chọn xe buýt. Trò chơi chỉ kết nối khi bạn bắt đầu lái."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一步选择你的巴士，开始驾驶时才会真正连接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下一步選擇你的巴士，開始駕駛時才會真正連線。"}}}},
    "Choose your bus on the Drive page, then press Join and drive.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Выберыце аўтобус на старонцы «Ехаць» і націсніце «Далучыцца і ехаць»."}},"ca":{"stringUnit":{"state":"translated","value":"Tria l'autobús a Condueix i després prem Uneix-t'hi i condueix."}},"cs":{"stringUnit":{"state":"translated","value":"Vyberte autobus na stránce Jet a pak stiskněte Připojit se a jet."}},"de":{"stringUnit":{"state":"translated","value":"Wähle deinen Bus auf der Seite „Fahren“ und drücke dann „Beitreten und fahren“."}},"es":{"stringUnit":{"state":"translated","value":"Elige tu autobús en la página Conducir y pulsa Unirse y conducir."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez votre bus sur la page Conduire, puis appuyez sur Rejoindre et conduire."}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइव पेज पर अपनी बस चुनें, फिर \"जुड़ें और चलाएँ\" दबाएँ।"}},"hu":{"stringUnit":{"state":"translated","value":"Válassz buszt a Vezetés oldalon, majd nyomd meg a Csatlakozás és vezetés gombot."}},"id":{"stringUnit":{"state":"translated","value":"Pilih bus di halaman Mengemudi, lalu tekan Gabung dan mengemudi."}},"it":{"stringUnit":{"state":"translated","value":"Scegli il tuo autobus nella pagina Guida, poi premi Unisciti e guida."}},"ja":{"stringUnit":{"state":"translated","value":"「運転」ページでバスを選び、「参加して運転」を押します。"}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ ავტობუსი „მართვის“ გვერდზე, შემდეგ დააჭირეთ „შეერთება და მართვა“-ს."}},"kk":{"stringUnit":{"state":"translated","value":"Жүру бетінде автобусты таңдап, «Қосылып жүру» түймесін басыңыз."}},"ko":{"stringUnit":{"state":"translated","value":"'운전' 페이지에서 버스를 선택한 다음 '참가 후 운전'을 누르세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pilih bas di halaman Pandu, kemudian tekan Sertai dan pandu."}},"nl":{"stringUnit":{"state":"translated","value":"Kies je bus op de pagina Rijden en druk dan op Deelnemen en rijden."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz autobus na stronie Jedź, a potem naciśnij Dołącz i jedź."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha seu ônibus na página Dirigir e pressione Entrar e dirigir."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha o seu autocarro na página Conduzir e prima Entrar e conduzir."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите автобус на странице «Поездка» и нажмите «Присоединиться и ехать»."}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite autobus na stranici „Vožnja“, pa pritisnite „Pridruži se i vozi“."}},"sv":{"stringUnit":{"state":"translated","value":"Välj din buss på sidan Kör och tryck sedan på Anslut och kör."}},"th":{"stringUnit":{"state":"translated","value":"เลือกรถบัสที่หน้า “ขับรถ” แล้วกด “เข้าร่วมและขับรถ”"}},"fil":{"stringUnit":{"state":"translated","value":"Pumili ng bus sa page na Magmaneho, saka pindutin ang Sumali at magmaneho."}},"tr":{"stringUnit":{"state":"translated","value":"Sürüş sayfasında otobüsünüzü seçin, sonra Katıl ve sür'e basın."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть автобус на сторінці «Їхати» й натисніть «Приєднатися і їхати»."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn xe buýt ở trang Lái xe, rồi nhấn Tham gia và lái xe."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"到“驾驶”页面选择巴士，再按“加入并驾驶”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"到「駕駛」頁選擇巴士，再按「加入並駕駛」。"}}}},
    "Choose your map, bus and duty on the Drive page. No game starts until you press Start the duty.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Выберыце мапу, аўтобус і наряд на старонцы «Ехаць». Гульня не пачнецца, пакуль вы не націснеце «Пачаць наряд»."}},"ca":{"stringUnit":{"state":"translated","value":"Tria el mapa, l'autobús i el servei a Condueix. Cap partida no comença fins que prems Inicia el servei."}},"cs":{"stringUnit":{"state":"translated","value":"Vyberte mapu, autobus a službu na stránce Jet. Hra se nespustí, dokud nestisknete Zahájit službu."}},"de":{"stringUnit":{"state":"translated","value":"Wähle Karte, Bus und Dienst auf der Seite „Fahren“. Das Spiel startet erst, wenn du „Dienst beginnen“ drückst."}},"es":{"stringUnit":{"state":"translated","value":"Elige el mapa, el autobús y el servicio en la página Conducir. No empieza ninguna partida hasta que pulses Iniciar el servicio."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez la carte, le bus et le service sur la page Conduire. Le jeu ne démarre que lorsque vous appuyez sur Commencer le service."}},"hi":{"stringUnit":{"state":"translated","value":"ड्राइव पेज पर मैप, बस और ड्यूटी चुनें। \"ड्यूटी शुरू करें\" दबाने तक कोई गेम शुरू नहीं होता।"}},"hu":{"stringUnit":{"state":"translated","value":"Válassz térképet, buszt és szolgálatot a Vezetés oldalon. A játék csak akkor indul, ha megnyomod a Szolgálat indítása gombot."}},"id":{"stringUnit":{"state":"translated","value":"Pilih peta, bus, dan tugas di halaman Mengemudi. Game belum dimulai sampai Anda menekan Mulai tugas."}},"it":{"stringUnit":{"state":"translated","value":"Scegli mappa, autobus e turno nella pagina Guida. Il gioco non parte finché non premi Avvia il turno."}},"ja":{"stringUnit":{"state":"translated","value":"「運転」ページでマップ、バス、乗務を選びます。「乗務を開始」を押すまでゲームは始まりません。"}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ რუკა, ავტობუსი და რეისი „მართვის“ გვერდზე. თამაში არ დაიწყება, სანამ „რეისის დაწყებას“ არ დააჭერთ."}},"kk":{"stringUnit":{"state":"translated","value":"Жүру бетінде картаны, автобусты және нарядты таңдаңыз. «Нарядты бастау» түймесін баспайынша ойын басталмайды."}},"ko":{"stringUnit":{"state":"translated","value":"'운전' 페이지에서 지도, 버스, 근무를 선택하세요. '근무 시작'을 누르기 전에는 게임이 시작되지 않습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Pilih peta, bas dan tugas di halaman Pandu. Permainan tidak bermula sehingga anda menekan Mulakan tugas."}},"nl":{"stringUnit":{"state":"translated","value":"Kies je kaart, bus en dienst op de pagina Rijden. Er start geen spel totdat je op Dienst starten drukt."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz mapę, autobus i służbę na stronie Jedź. Gra nie wystartuje, dopóki nie naciśniesz Rozpocznij służbę."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o mapa, o ônibus e a escala na página Dirigir. Nenhum jogo começa até você pressionar Iniciar a escala."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha o mapa, o autocarro e a escala na página Conduzir. Nenhum jogo começa até premir Iniciar a escala."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите карту, автобус и смену на странице «Поездка». Игра не начнётся, пока вы не нажмёте «Начать смену»."}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite mapu, autobus i smenu na stranici „Vožnja“. Igra se neće pokrenuti dok ne pritisnete „Započni smenu“."}},"sv":{"stringUnit":{"state":"translated","value":"Välj karta, buss och tjänst på sidan Kör. Inget spel startar förrän du trycker på Starta tjänsten."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแผนที่ รถบัส และหน้าที่ที่หน้า “ขับรถ” เกมจะยังไม่เริ่มจนกว่าคุณจะกด “เริ่มหน้าที่”"}},"fil":{"stringUnit":{"state":"translated","value":"Piliin ang mapa, bus at duty sa page na Magmaneho. Walang larong magsisimula hangga't hindi mo pinipindot ang Simulan ang duty."}},"tr":{"stringUnit":{"state":"translated","value":"Sürüş sayfasında haritanızı, otobüsünüzü ve görevinizi seçin. Görevi başlat'a basana kadar oyun başlamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть мапу, автобус і наряд на сторінці «Їхати». Гра не почнеться, доки ви не натиснете «Почати наряд»."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn bản đồ, xe buýt và ca ở trang Lái xe. Trò chơi chỉ bắt đầu khi bạn nhấn Bắt đầu ca."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"到“驾驶”页面选择地图、巴士和任务，按下“开始运营任务”后才会启动游戏。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"到「駕駛」頁選擇地圖、巴士及班次，按下「開始班次」才會啟動遊戲。"}}}},
    "Choose your map, bus and duty, then start the game as host.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Выберыце мапу, аўтобус і наряд, потым запусціце гульню як хост."}},"ca":{"stringUnit":{"state":"translated","value":"Tria el mapa, l'autobús i el servei, i inicia la partida com a amfitrió."}},"cs":{"stringUnit":{"state":"translated","value":"Vyberte mapu, autobus a službu a pak spusťte hru jako hostitel."}},"de":{"stringUnit":{"state":"translated","value":"Wähle Karte, Bus und Dienst und starte dann das Spiel als Host."}},"es":{"stringUnit":{"state":"translated","value":"Elige el mapa, el autobús y el servicio, y empieza la partida como anfitrión."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez la carte, le bus et le service, puis lancez le jeu en tant qu'hôte."}},"hi":{"stringUnit":{"state":"translated","value":"मैप, बस और ड्यूटी चुनें, फिर होस्ट के रूप में गेम शुरू करें।"}},"hu":{"stringUnit":{"state":"translated","value":"Válassz térképet, buszt és szolgálatot, majd indítsd el a játékot házigazdaként."}},"id":{"stringUnit":{"state":"translated","value":"Pilih peta, bus, dan tugas, lalu mulai game sebagai host."}},"it":{"stringUnit":{"state":"translated","value":"Scegli mappa, autobus e turno, poi avvia il gioco come host."}},"ja":{"stringUnit":{"state":"translated","value":"マップ、バス、乗務を選び、ホストとしてゲームを開始します。"}},"ka":{"stringUnit":{"state":"translated","value":"აირჩიეთ რუკა, ავტობუსი და რეისი, შემდეგ დაიწყეთ თამაში ჰოსტის სახით."}},"kk":{"stringUnit":{"state":"translated","value":"Картаны, автобусты және нарядты таңдап, ойынды хост ретінде бастаңыз."}},"ko":{"stringUnit":{"state":"translated","value":"지도, 버스, 근무를 선택한 다음 호스트로 게임을 시작하세요."}},"ms":{"stringUnit":{"state":"translated","value":"Pilih peta, bas dan tugas, kemudian mulakan permainan sebagai hos."}},"nl":{"stringUnit":{"state":"translated","value":"Kies je kaart, bus en dienst en start dan het spel als host."}},"pl":{"stringUnit":{"state":"translated","value":"Wybierz mapę, autobus i służbę, a potem uruchom grę jako host."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha o mapa, o ônibus e a escala e inicie o jogo como anfitrião."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolha o mapa, o autocarro e a escala e inicie o jogo como anfitrião."}},"ru":{"stringUnit":{"state":"translated","value":"Выберите карту, автобус и смену, затем запустите игру как хост."}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite mapu, autobus i smenu, pa pokrenite igru kao domaćin."}},"sv":{"stringUnit":{"state":"translated","value":"Välj karta, buss och tjänst och starta sedan spelet som värd."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแผนที่ รถบัส และหน้าที่ แล้วเริ่มเกมในฐานะโฮสต์"}},"fil":{"stringUnit":{"state":"translated","value":"Piliin ang mapa, bus at duty, saka simulan ang laro bilang host."}},"tr":{"stringUnit":{"state":"translated","value":"Haritanızı, otobüsünüzü ve görevinizi seçin, sonra oyunu sunucu olarak başlatın."}},"uk":{"stringUnit":{"state":"translated","value":"Виберіть мапу, автобус і наряд, потім запустіть гру як хост."}},"vi":{"stringUnit":{"state":"translated","value":"Chọn bản đồ, xe buýt và ca, rồi bắt đầu trò chơi với tư cách chủ phòng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择地图、巴士和任务，然后以主机身份开始游戏。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇地圖、巴士及班次，然後以房主身分開始遊戲。"}}}},
    "Choose…": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Tria…"}},"de":{"stringUnit":{"state":"translated","value":"Wählen…"}},"es":{"stringUnit":{"state":"translated","value":"Elegir…"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir…"}},"ka":{"stringUnit":{"state":"translated","value":"არჩევა…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolher…"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolher…"}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать…"}},"sr":{"stringUnit":{"state":"translated","value":"Izaberite…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇……"}}}},
    "Clear finished": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Esborra les acabades"}},"de":{"stringUnit":{"state":"translated","value":"Fertige entfernen"}},"es":{"stringUnit":{"state":"translated","value":"Borrar los terminados"}},"fr":{"stringUnit":{"state":"translated","value":"Effacement terminé"}},"ka":{"stringUnit":{"state":"translated","value":"დასრულებულების გასუფთავება"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Limpar concluídas"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Limpar concluídas"}},"ru":{"stringUnit":{"state":"translated","value":"Очистить завершённые"}},"sr":{"stringUnit":{"state":"translated","value":"Očistiti završeno"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除已完成項目"}}}},
    "Clear sky": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Яснае неба"}},"ca":{"stringUnit":{"state":"translated","value":"Cel clar"}},"cs":{"stringUnit":{"state":"translated","value":"Jasná obloha"}},"de":{"stringUnit":{"state":"translated","value":"Klarer Himmel"}},"es":{"stringUnit":{"state":"translated","value":"Cielo despejado"}},"fr":{"stringUnit":{"state":"translated","value":"Ciel dégagé"}},"hi":{"stringUnit":{"state":"translated","value":"साफ़ आसमान"}},"hu":{"stringUnit":{"state":"translated","value":"Derült ég"}},"id":{"stringUnit":{"state":"translated","value":"Langit cerah"}},"it":{"stringUnit":{"state":"translated","value":"Cielo sereno"}},"ja":{"stringUnit":{"state":"translated","value":"快晴"}},"ka":{"stringUnit":{"state":"translated","value":"მოწმენდილი ცა"}},"kk":{"stringUnit":{"state":"translated","value":"Ашық аспан"}},"ko":{"stringUnit":{"state":"translated","value":"맑은 하늘"}},"ms":{"stringUnit":{"state":"translated","value":"Langit cerah"}},"nl":{"stringUnit":{"state":"translated","value":"Heldere lucht"}},"pl":{"stringUnit":{"state":"translated","value":"Bezchmurne niebo"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Céu limpo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Céu limpo"}},"ru":{"stringUnit":{"state":"translated","value":"Ясное небо"}},"sr":{"stringUnit":{"state":"translated","value":"Vedro nebo"}},"sv":{"stringUnit":{"state":"translated","value":"Klar himmel"}},"th":{"stringUnit":{"state":"translated","value":"ท้องฟ้าแจ่มใส"}},"fil":{"stringUnit":{"state":"translated","value":"Maaliwalas na langit"}},"tr":{"stringUnit":{"state":"translated","value":"Açık gökyüzü"}},"uk":{"stringUnit":{"state":"translated","value":"Ясне небо"}},"vi":{"stringUnit":{"state":"translated","value":"Trời quang"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"晴空"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"晴空"}}}},
    "Clear the key (the entry stays)": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Esborra la tecla (es conserva l'entrada)"}},"de":{"stringUnit":{"state":"translated","value":"Taste löschen (Eintrag bleibt)"}},"es":{"stringUnit":{"state":"translated","value":"Borrar la tecla (la entrada se conserva)"}},"fr":{"stringUnit":{"state":"translated","value":"Effacer la touche (l'entrée reste)"}},"ka":{"stringUnit":{"state":"translated","value":"კლავიშის გასუფთავება (ჩანაწერი რჩება)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Limpar a tecla (a entrada continua)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Limpar a tecla (a entrada mantém-se)"}},"ru":{"stringUnit":{"state":"translated","value":"Очистить клавишу (запись останется)"}},"sr":{"stringUnit":{"state":"translated","value":"Obrišite ključ (unos ostaje)"}},"sv":{"stringUnit":{"state":"translated","value":"Rensa tangenten (posten behålls)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"清除按鍵（保留項目）"}}}},
    "Click a trip to start with it": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Націсніце рэйс, каб пачаць з яго"}},"ca":{"stringUnit":{"state":"translated","value":"Fes clic en un trajecte per començar-hi"}},"cs":{"stringUnit":{"state":"translated","value":"Klepnutím na spoj začnete jím"}},"de":{"stringUnit":{"state":"translated","value":"Klicke eine Fahrt an, um mit ihr zu beginnen"}},"es":{"stringUnit":{"state":"translated","value":"Haz clic en un viaje para empezar con él"}},"fr":{"stringUnit":{"state":"translated","value":"Clique sur un trajet pour commencer par lui"}},"hi":{"stringUnit":{"state":"translated","value":"किसी यात्रा पर क्लिक करके उससे शुरू करें"}},"hu":{"stringUnit":{"state":"translated","value":"Kattints egy menetre, hogy azzal kezdj"}},"id":{"stringUnit":{"state":"translated","value":"Klik sebuah rit untuk mulai dari situ"}},"it":{"stringUnit":{"state":"translated","value":"Clicca una corsa per iniziare da quella"}},"ja":{"stringUnit":{"state":"translated","value":"便をクリックするとその便から始めます"}},"ka":{"stringUnit":{"state":"translated","value":"დააწკაპუნეთ მგზავრობაზე, რომ მისით დაიწყოთ"}},"kk":{"stringUnit":{"state":"translated","value":"Одан бастау үшін рейсті басыңыз"}},"ko":{"stringUnit":{"state":"translated","value":"운행을 클릭하면 그 운행부터 시작합니다"}},"ms":{"stringUnit":{"state":"translated","value":"Klik satu perjalanan untuk bermula dengannya"}},"nl":{"stringUnit":{"state":"translated","value":"Klik op een rit om ermee te beginnen"}},"pl":{"stringUnit":{"state":"translated","value":"Kliknij kurs, aby od niego zacząć"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Clique numa viagem para começar por ela"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Clique numa viagem para começar por ela"}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите на рейс, чтобы начать с него"}},"sr":{"stringUnit":{"state":"translated","value":"Kliknite na putovanje da biste započeli sa njim"}},"sv":{"stringUnit":{"state":"translated","value":"Klicka på en tur för att starta med den"}},"th":{"stringUnit":{"state":"translated","value":"คลิกเที่ยวเพื่อเริ่มจากเที่ยวนั้น"}},"fil":{"stringUnit":{"state":"translated","value":"I-click ang isang takbo para magsimula rito"}},"tr":{"stringUnit":{"state":"translated","value":"Onunla başlamak için bir sefere tıkla"}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть рейс, щоб почати з нього"}},"vi":{"stringUnit":{"state":"translated","value":"Bấm vào một chuyến để bắt đầu từ chuyến đó"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点击一个行程即从它开始"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"點一個班次即從它開始"}}}},
