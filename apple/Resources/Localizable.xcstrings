    "Every change is saved at once; the game reads them when it starts.": {
      "localizations": {
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожная змена захоўваецца адразу; гульня чытае іх пры запуску."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada canvi es desa immediatament; el joc els llegeix en iniciar-se."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá změna se uloží hned; hra je načte při spuštění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung wird sofort gespeichert; das Spiel liest sie beim Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cambio se guarda al instante; el juego los lee al iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modification est enregistrée de manière rétrospective, le jeu les lit au démarrage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बदलाव तुरंत सेव होता है; गेम शुरू होते समय उन्हें पढ़ता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden módosítás azonnal mentésre kerül; a játék induláskor olvassa be őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap perubahan langsung disimpan dan dibaca saat game dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modifica viene salvata subito; il gioco le legge all'avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はすぐに保存されます。ゲームは起動時にそれらを読み込みます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әрбір өзгеріс бірден сақталады; ойын оларды іске қосылғанда оқиды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 변경 사항은 즉시 저장되며 게임 시작 시 불러옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap perubahan disimpan serta-merta dan dibaca apabila permainan bermula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke wijziging wordt direct opgeslagen; het spel leest ze bij het starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda zmiana jest zapisywana od razu; gra wczytuje je przy starcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada alteração é salva imediatamente; o jogo a lê na próxima inicialização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada alteração é guardada imediatamente; o jogo a lê na próxima inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое изменение сохраняется сразу; игра читает их при запуске."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการเปลี่ยนแปลงจะถูกบันทึกทันทีและเกมจะอ่านเมื่อเริ่ม"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Agad na sine-save ang bawat pagbabago at binabasa ng laro sa pagsisimula."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her değişiklik anında kaydedilir; oyun bunları başlarken okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна зміна зберігається одразу; гра читає їх під час запуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thay đổi được lưu ngay và trò chơi sẽ đọc khi bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有更改会立即保存;游戏在启动时读取它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有更改會即時儲存，遊戲啟動時會自動讀取。"
          }
        }
      }
    },
