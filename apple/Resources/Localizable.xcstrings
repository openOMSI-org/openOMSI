    "Frame rate in the corner": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Частата кадраў у куце"}},"ca":{"stringUnit":{"state":"translated","value":"Fotogrames per segon a la cantonada"}},"cs":{"stringUnit":{"state":"translated","value":"Snímková frekvence v rohu"}},"de":{"stringUnit":{"state":"translated","value":"Bildrate in der Ecke"}},"es":{"stringUnit":{"state":"translated","value":"Tasa de fotogramas en la esquina"}},"fr":{"stringUnit":{"state":"translated","value":"IPS dans le coin"}},"hi":{"stringUnit":{"state":"translated","value":"कोने में फ़्रेम रेट"}},"hu":{"stringUnit":{"state":"translated","value":"FPS-szám a sarokban"}},"id":{"stringUnit":{"state":"translated","value":"Tampilkan FPS di sudut"}},"it":{"stringUnit":{"state":"translated","value":"Frame rate nell'angolo"}},"ja":{"stringUnit":{"state":"translated","value":"フレームレートを隅に表示"}},"ka":{"stringUnit":{"state":"translated","value":"კადრების სიხშირე კუთხეში"}},"kk":{"stringUnit":{"state":"translated","value":"Бұрыштағы кадр жиілігі"}},"ko":{"stringUnit":{"state":"translated","value":"화면 모서리에 FPS 표시"}},"ms":{"stringUnit":{"state":"translated","value":"Papar FPS di penjuru"}},"nl":{"stringUnit":{"state":"translated","value":"Framerate in de hoek"}},"pl":{"stringUnit":{"state":"translated","value":"Liczba klatek w rogu"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Taxa de quadros no canto"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Taxa de quadros no canto"}},"ru":{"stringUnit":{"state":"translated","value":"Частота кадров в углу"}},"sr":{"stringUnit":{"state":"translated","value":"Brzina kadrova u uglu"}},"sv":{"stringUnit":{"state":"translated","value":"Bildfrekvens (FPS) i hörnet"}},"th":{"stringUnit":{"state":"translated","value":"แสดง FPS ที่มุมจอ"}},"fil":{"stringUnit":{"state":"translated","value":"Ipakita ang FPS sa sulok"}},"tr":{"stringUnit":{"state":"translated","value":"Köşede kare hızı"}},"uk":{"stringUnit":{"state":"translated","value":"Частота кадрів у кутку"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện FPS ở góc màn hình"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"角落显示帧率"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在角落顯示幀率"}}}},
    "Free camera keys on/off (off: they work the bus)": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Клавішы свабоднай камеры укл/выкл (выкл: яны кіруюць аўтобусам)"}},"ca":{"stringUnit":{"state":"translated","value":"Tecles de la càmera lliure sí/no (no: fan anar l'autobús)"}},"cs":{"stringUnit":{"state":"translated","value":"Klávesy volné kamery zap/vyp (vyp: ovládají autobus)"}},"de":{"stringUnit":{"state":"translated","value":"Tasten der freien Kamera ein/aus (aus: sie bedienen den Bus)"}},"es":{"stringUnit":{"state":"translated","value":"Teclas de la cámara libre sí/no (no: manejan el autobús)"}},"fr":{"stringUnit":{"state":"translated","value":"Touches de la caméra libre oui/non (non : elles commandent le bus)"}},"hi":{"stringUnit":{"state":"translated","value":"फ्री कैमरा कुंजियाँ चालू/बंद (बंद: वे बस चलाती हैं)"}},"hu":{"stringUnit":{"state":"translated","value":"Szabad kamera billentyűi be/ki (ki: a buszt kezelik)"}},"id":{"stringUnit":{"state":"translated","value":"Tombol kamera bebas nyala/mati (mati: untuk bus)"}},"it":{"stringUnit":{"state":"translated","value":"Tasti della telecamera libera on/off (off: comandano l'autobus)"}},"ja":{"stringUnit":{"state":"translated","value":"フリーカメラのキー オン/オフ（オフ: バスを操作）"}},"ka":{"stringUnit":{"state":"translated","value":"თავისუფალი კამერის კლავიშები ჩართ./გამორთ. (გამორთ.: ისინი ავტობუსს მართავენ)"}},"kk":{"stringUnit":{"state":"translated","value":"Еркін камера пернелері қосу/өшіру (өшірулі: олар автобусты басқарады)"}},"ko":{"stringUnit":{"state":"translated","value":"자유 카메라 키 켜기/끄기 (끄기: 버스를 조작)"}},"ms":{"stringUnit":{"state":"translated","value":"Kekunci kamera bebas hidup/mati (mati: untuk bas)"}},"nl":{"stringUnit":{"state":"translated","value":"Toetsen van de vrije camera aan/uit (uit: ze bedienen de bus)"}},"pl":{"stringUnit":{"state":"translated","value":"Klawisze wolnej kamery wł./wył. (wył.: sterują autobusem)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Teclas da câmera livre lig/desl (desl: operam o ônibus)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Teclas da câmara livre lig/desl (desl: operam o autocarro)"}},"ru":{"stringUnit":{"state":"translated","value":"Клавиши свободной камеры вкл/выкл (выкл: они управляют автобусом)"}},"sr":{"stringUnit":{"state":"translated","value":"Besplatni tasteri za uključivanje/isključivanje kamere (isključeni: rade na autobusu)"}},"sv":{"stringUnit":{"state":"translated","value":"Fri kamera-tangenter på/av (av: de styr bussen)"}},"th":{"stringUnit":{"state":"translated","value":"ปุ่มกล้องอิสระ เปิด/ปิด (ปิด: ใช้ควบคุมรถบัส)"}},"fil":{"stringUnit":{"state":"translated","value":"Mga key ng malayang camera on/off (off: para sa bus)"}},"tr":{"stringUnit":{"state":"translated","value":"Serbest kamera tuşları açık/kapalı (kapalı: otobüsü kullanırlar)"}},"uk":{"stringUnit":{"state":"translated","value":"Клавіші вільної камери увімк/вимк (вимк: вони керують автобусом)"}},"vi":{"stringUnit":{"state":"translated","value":"Phím camera tự do bật/tắt (tắt: dùng để điều khiển xe buýt)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自由视角按键开/关（关：用来操作公交车）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自由視角按鍵開/關（關：用來操作公車）"}}}},
    "Free drive": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Свабодная язда"}},"ca":{"stringUnit":{"state":"translated","value":"Conducció lliure"}},"cs":{"stringUnit":{"state":"translated","value":"Volná jízda"}},"de":{"stringUnit":{"state":"translated","value":"Freie Fahrt"}},"es":{"stringUnit":{"state":"translated","value":"Conducción libre"}},"fr":{"stringUnit":{"state":"translated","value":"Conduite freeroam"}},"hi":{"stringUnit":{"state":"translated","value":"फ़्री ड्राइव"}},"hu":{"stringUnit":{"state":"translated","value":"Szabad vezetés"}},"id":{"stringUnit":{"state":"translated","value":"Mengemudi bebas"}},"it":{"stringUnit":{"state":"translated","value":"Guida libera"}},"ja":{"stringUnit":{"state":"translated","value":"フリードライブ"}},"ka":{"stringUnit":{"state":"translated","value":"თავისუფალი მართვა"}},"kk":{"stringUnit":{"state":"translated","value":"Еркін жүру"}},"ko":{"stringUnit":{"state":"translated","value":"자유 운전"}},"ms":{"stringUnit":{"state":"translated","value":"Pemanduan bebas"}},"nl":{"stringUnit":{"state":"translated","value":"Vrij rijden"}},"pl":{"stringUnit":{"state":"translated","value":"Jazda swobodna"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Direção livre"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Condução livre"}},"ru":{"stringUnit":{"state":"translated","value":"Свободная езда"}},"sr":{"stringUnit":{"state":"translated","value":"Slobodna vožnja"}},"sv":{"stringUnit":{"state":"translated","value":"Fri körning"}},"th":{"stringUnit":{"state":"translated","value":"ขับอิสระ"}},"fil":{"stringUnit":{"state":"translated","value":"Malayang pagmamaneho"}},"tr":{"stringUnit":{"state":"translated","value":"Serbest sürüş"}},"uk":{"stringUnit":{"state":"translated","value":"Вільна поїздка"}},"vi":{"stringUnit":{"state":"translated","value":"Lái tự do"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自由驾驶"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自由駕駛"}}}},
    "Free driving: the bus starts where you chose, with the traffic and the timetable's buses around it, but no line of your own.": {"localizations":{"be":{"stringUnit":{"state":"translated","value":"Свабодная язда: аўтобус стартуе там, дзе вы абралі, з рухам і аўтобусамі па раскладзе вакол, але без уласнай лініі."}},"ca":{"stringUnit":{"state":"translated","value":"Conducció lliure: l'autobús comença on has triat, amb el trànsit i els autobusos programats al voltant, però sense línia pròpia."}},"cs":{"stringUnit":{"state":"translated","value":"Volná jízda: autobus začne na vybraném místě, kolem něj je provoz a autobusy podle jízdního řádu, ale žádná vlastní linka."}},"de":{"stringUnit":{"state":"translated","value":"Freie Fahrt: der Bus startet am gewählten Ort, mit Verkehr und Fahrplanbussen, aber ohne eigene Linie."}},"es":{"stringUnit":{"state":"translated","value":"Conducción libre: el autobús empieza donde elijas, con el tráfico y los autobuses del horario a su alrededor, pero sin línea propia."}},"fr":{"stringUnit":{"state":"translated","value":"Conduite libre : le bus part où vous l'avez choisi, avec la circulation et les bus du réseau, mais sans ligne attitrée."}},"hi":{"stringUnit":{"state":"translated","value":"फ़्री ड्राइविंग: बस आपकी चुनी जगह से शुरू होती है, आसपास ट्रैफ़िक और टाइमटेबल की बसें होती हैं, लेकिन आपकी अपनी कोई लाइन नहीं होती।"}},"hu":{"stringUnit":{"state":"translated","value":"Szabad vezetés: a busz a választott helyen indul, körülötte forgalommal és menetrend szerinti buszokkal, de aktív menetrend nélkül."}},"id":{"stringUnit":{"state":"translated","value":"Mengemudi bebas: bus mulai dari lokasi pilihan Anda dengan lalu lintas dan bus terjadwal, tetapi tanpa rute Anda sendiri."}},"it":{"stringUnit":{"state":"translated","value":"Guida libera: il bus parte dove hai scelto, con il traffico e i bus di linea intorno, ma senza una linea tua."}},"ja":{"stringUnit":{"state":"translated","value":"フリードライブ:選んだ場所からバスが出発します。周囲には一般車両と時刻表のバスが走りますが、専用の系統はありません。"}},"ka":{"stringUnit":{"state":"translated","value":"თავისუფალი მართვა: ავტობუსი იწყებს თქვენ მიერ არჩეული ადგილიდან, გარშემო მოძრაობითა და განრიგის ავტობუსებით, მაგრამ საკუთარი ხაზის გარეშე."}},"kk":{"stringUnit":{"state":"translated","value":"Еркін жүру: автобус сіз таңдаған жерден бастайды, айналада қозғалыс пен кестелік автобустар жүреді, бірақ өз желіңіз болмайды."}},"ko":{"stringUnit":{"state":"translated","value":"자유 운전: 선택한 위치에서 출발하며 주변에 교통과 시간표 버스가 있지만 본인 노선은 없습니다."}},"ms":{"stringUnit":{"state":"translated","value":"Pemanduan bebas: bas bermula di lokasi pilihan, dengan trafik dan bas berjadual di sekeliling, tetapi tanpa laluan sendiri."}},"nl":{"stringUnit":{"state":"translated","value":"Vrij rijden: de bus start waar je kiest, met verkeer en dienstbussen eromheen, maar zonder eigen lijn."}},"pl":{"stringUnit":{"state":"translated","value":"Jazda swobodna: autobus startuje tam, gdzie wybierzesz, wśród ruchu i autobusów rozkładowych, ale bez własnej linii."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Direção livre: o ônibus começa no local escolhido, com o trânsito e os ônibus do horário ao redor, mas sem uma linha própria."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Condução livre: o autocarro começa no local escolhido, com o trânsito e os autocarros do horário à volta, mas sem uma linha própria."}},"ru":{"stringUnit":{"state":"translated","value":"Свободная езда: автобус начинает там, где вы выбрали, вокруг движение и автобусы по расписанию, но без своего маршрута."}},"sr":{"stringUnit":{"state":"translated","value":"U slobodnoj vožnji autobus kreće sa izabranog mesta, okružen saobraćajem i autobusima iz reda vožnje, ali bez vaše linije."}},"sv":{"stringUnit":{"state":"translated","value":"Fri körning: bussen startar där du valt, med trafik och tidtabellsbussar runt omkring, men utan en egen linje."}},"th":{"stringUnit":{"state":"translated","value":"ขับอิสระ: รถเริ่มจากจุดที่เลือก มีรถอื่นและรถตามตารางเวลาอยู่รอบ ๆ แต่ไม่มีสายรถของคุณเอง"}},"fil":{"stringUnit":{"state":"translated","value":"Malayang pagmamaneho: magsisimula ang bus sa napili mong lugar, may trapiko at mga naka-iskedyul na bus, pero wala kang sariling ruta."}},"tr":{"stringUnit":{"state":"translated","value":"Serbest sürüş: otobüs seçtiğiniz yerden başlar, çevresinde trafik ve tarifedeki otobüsler bulunur, ancak kendinize ait bir hat yoktur."}},"uk":{"stringUnit":{"state":"translated","value":"Вільна поїздка: автобус стартує там, де ви вибрали, з рухом і автобусами за розкладом навколо, але без власної лінії."}},"vi":{"stringUnit":{"state":"translated","value":"Lái tự do: xe bắt đầu tại vị trí đã chọn, xung quanh vẫn có xe cộ và xe theo lịch trình, nhưng bạn không có tuyến riêng."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自由驾驶:巴士从你选择的位置出发,周围有交通车辆和时刻表巴士,但没有属于自己的线路。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自由駕駛：巴士會在你選定的位置出發，周圍仍有交通及按時間表運行的巴士，但你不會獲編配路線。"}}}},
