    "Time speed (not in multiplayer or with the real-time sync)": {"localizations":{"ca":{"stringUnit":{"state":"translated","value":"Velocitat del temps (no disponible en multijugador ni amb la sincronització horària)"}},"de":{"stringUnit":{"state":"translated","value":"Zeitmultiplikator (nicht im Mehrspieler oder mit Echzeit-Synchronisation)"}},"es":{"stringUnit":{"state":"translated","value":"Velocidad del tiempo (no disponible en multijugador ni con sincronización en tiempo real)"}},"fr":{"stringUnit":{"state":"translated","value":"Vitesse du temps (sauf en multijoueur ou avec la synchro en temps réel)"}},"ka":{"stringUnit":{"state":"translated","value":"დროის სიჩქარე (არა მრავალმოთამაშიანში ან რეალური დროის სინქრონიზაციისას)"}},"nl":{"stringUnit":{"state":"translated","value":"Tijdsnelheid (niet in multiplayer of bij realtime synchronisatie)"}},"pl":{"stringUnit":{"state":"translated","value":"Prędkość czasu (niedostępna w multiplayer ani przy synchronizacji z czasem rzeczywistym)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Velocidade do tempo (indisponível no multiplayer ou com sincronização em tempo real)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Velocidade do tempo (indisponível no multijogador ou com sincronização em tempo real)"}},"ru":{"stringUnit":{"state":"translated","value":"Скорость времени (недоступно в мультиплеере и при синхронизации с реальным временем)"}},"sr":{"stringUnit":{"state":"translated","value":"Brzina vremena (ne u igri za više igrača ili sa sinhronizacijom u realnom vremenu)"}},"sv":{"stringUnit":{"state":"translated","value":"Tidshastighet (inte i flerspelarläge eller med tidssynkronisering)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时间流速(多人游戏中或实时同步时不可用)"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"時間速度（不在多人遊戲或即時同步中可用）"}}}},
